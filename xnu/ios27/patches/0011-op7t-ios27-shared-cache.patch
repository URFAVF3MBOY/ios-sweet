0011: map and slide iOS 27.2's dyld shared cache.

Boot 27g: "initproc failed to start -- exit reason namespace 6 subcode 0x1 Library not loaded:
/usr/lib/libSystem.B.dylib Referenced from /sbin/launchd (no such file, no dyld cache)".
- shared_region.h: the 27.2 cache needs 0x190254000 bytes from 0x180000000; SWEET's region is 8 GiB (ios-guacamole
  found the same).
- vm_shared_region.c: slide info v3/v5 rebase authenticated slots but store them only under ptrauth_calls; on this
  kernel every auth pointer kept its raw chain word. Store them unsigned.
- vm_dyld_pager.c: page-in linking handles the arm64e chained formats without PAC (unsigned targets).

--- a/osfmk/mach/shared_region.h
+++ b/osfmk/mach/shared_region.h
@@ -88,7 +88,15 @@
 /* ARM64_TODO: move to higher memory */
 #endif
 #define SHARED_REGION_BASE_ARM64                0x180000000ULL
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: iOS 27.2's iPhone15,2 cache spans 0x190254000 bytes from 0x180000000, more than 6 GiB: the map failed and
+ * dyld had "no dyld cache" (boot 27g: launchd, libSystem.B.dylib not loaded). 8 GiB; the commpage stays far above.
+ */
+#define SHARED_REGION_SIZE_ARM64                0x200000000ULL
+#else
 #define SHARED_REGION_SIZE_ARM64                0x180000000ULL
+#endif
 #define SHARED_REGION_NESTING_BASE_ARM64        SHARED_REGION_BASE_ARM64
 #define SHARED_REGION_NESTING_SIZE_ARM64        SHARED_REGION_SIZE_ARM64
 #define SHARED_REGION_NESTING_MIN_ARM64         ?
