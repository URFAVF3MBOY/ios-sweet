+			printf("SIGKILL by %s[%d] to %s[%d] flavor %d reason %p ra0 0x%lx ra1 0x%lx ref 0x%lx\n",
+			    sp ? sp->p_comm : "?", sp ? proc_getpid(sp) : -1,
+			    p ? p->p_comm : "?", p ? proc_getpid(p) : -1, flavor, signal_reason,
+			    (unsigned long)__builtin_return_address(0),
+			    (unsigned long)__builtin_return_address(1), (unsigned long)(uintptr_t)&psignal_internal);
+		}
+	}
+#endif
