0014: replay the boot console to the UDP log during the initproc hold.

Boot 27j: the live log (sweet_usb.c) began ~18 s into the boot; launchd's lines were sent before Windows had
configured the RNDIS adapter and were lost. The hold now asks the log thread, 30 s in, to re-send the last 256 KiB
of the console ring.

--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1308,6 +1308,22 @@
 extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
 extern uint64_t sweet_log_position(void);
 
+/*
+ * Rewind request (position + 1, 0 = none): re-send the console from there. The first datagrams of a boot go out
+ * before Windows has configured its RNDIS adapter and are lost, so lines from the first ~20 s (launchd's start)
+ * never arrived; the initproc hold in kern_exit.c asks for a replay once the link is up.
+ */
+static uint64_t sweet_usblog_rewind;
+
+void sweet_usblog_replay(uint64_t back);
+
+void
+sweet_usblog_replay(uint64_t back)
+{
+	uint64_t at = sweet_log_position();
+	__atomic_store_n(&sweet_usblog_rewind, (at > back ? at - back : 0) + 1, __ATOMIC_RELAXED);
+}
+
 static void
 ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 {
@@ -1330,6 +1346,10 @@
 		if (so == NULL && sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
 			so = NULL;
 			continue;
+		}
+		uint64_t rewind = __atomic_exchange_n(&sweet_usblog_rewind, 0, __ATOMIC_RELAXED);
+		if (rewind != 0) {
+			pos = rewind - 1;
 		}
 		uint32_t n;
 		while ((n = sweet_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -2019,7 +2019,14 @@
 		}
 		if (secs != 0) {
 			printf("HOTDOGB: launchd is dying (lines above say why); panic in %u s\n", secs);
-			delay((int)(secs * 1000000));
+			/* after 30 s (USB network up) replay the last 256 KiB of the console to the UDP log */
+			extern void sweet_usblog_replay(uint64_t back);  /* bsd/dev/sweet_usb.c */
+			uint32_t first = secs < 30 ? secs : 30;
+			delay((int)(first * 1000000));
+			sweet_usblog_replay(256u << 10);
+			if (secs > first) {
+				delay((int)((secs - first) * 1000000));
+			}
 		}
 	}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
