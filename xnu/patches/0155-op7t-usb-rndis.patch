 static const uint8_t ud_phone_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x02 };
 
+/*
+ * 0155: sweetusb=3 -- the same data path as the CDC ECM function, but spoken as RNDIS, which
+ * Windows has in the box ("Remote NDIS Compatible Device", usbrndis6, matched by the interface
+ * class 0xe0/0x01/0x03 inside an IAD). Same endpoints (bulk 0x01/0x81, interrupt 0x82), same ue0
+ * and 192.168.7.2/24; the host side is a static 192.168.7.1/24 on the new Windows adapter.
+ *   - control: SEND_ENCAPSULATED_COMMAND (0x21/0x00, OUT data) takes an RNDIS message, the answer
+ *     waits in rn_resp until GET_ENCAPSULATED_RESPONSE (0xa1/0x01); the interrupt endpoint gets an
+ *     8-byte RESPONSE_AVAILABLE notification for it.
+ *   - messages: INITIALIZE, QUERY, SET, RESET, KEEPALIVE, HALT (RNDIS 1.0 as in Linux rndis.c).
+ *   - data: every bulk transfer carries one RNDIS_PACKET_MSG: a 44-byte header, then the frame.
+ *   - the link is "up" (frames are sent) once the host has set a non-zero packet filter.
+ * PID 0x0002 (ECM keeps 0x0001) so a Windows that cached a failed 1209:0001 install starts clean.
+ */
+static const uint8_t ud_dev_desc_rndis[18] = {
+	18, 1, 0x00, 0x02, 0xef, 0x02, 0x01, 64,        /* class: miscellaneous, IAD */
+	0x09, 0x12, 0x02, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+static const uint8_t ud_cfg_desc_rndis[75] = {
+	9, 2, 75, 0, 2, 1, 0, 0x80, 250,                /* config: 2 interfaces, 500 mA */
+	8, 0x0b, 0, 2, 0xe0, 0x01, 0x03, 0,             /* IAD: interfaces 0-1, wireless controller / RNDIS */
+	9, 4, 0, 0, 1, 0xe0, 0x01, 0x03, 0,             /* comm interface 0: RNDIS, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
+	5, 0x24, 0x01, 0x00, 1,                         /* call management, data on interface 1 */
+	4, 0x24, 0x02, 0x00,                            /* ACM */
+	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
+	7, 5, 0x82, 0x03, 8, 0, 5,                      /* ep 0x82 interrupt IN, 8 bytes, 2^(5-1) uframes */
+	9, 4, 1, 0, 2, 0x0a, 0x00, 0x00, 0,             /* data interface 1: two bulk endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
+};
+/* RNDIS reports the HOST adapter's address: the same one the ECM descriptor gives (phone is ..:02). */
+static const uint8_t ud_host_mac[6] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x01 };
+
+/* RNDIS-PURE-BEGIN */
+#define UD_RN_CMD_MAX           448
+#define RN_PKT_HDR              44
+#define RN_PACKET_MSG           0x00000001u
+#define RN_INITIALIZE           0x00000002u
+#define RN_HALT                 0x00000003u
+#define RN_QUERY                0x00000004u
+#define RN_SET                  0x00000005u
+#define RN_RESET                0x00000006u
+#define RN_KEEPALIVE            0x00000008u
+#define RN_CMPLT                0x80000000u
+#define RN_ST_OK                0x00000000u
+#define RN_ST_NOT_SUPPORTED     0xc00000bbu
+#define RN_ST_INVALID_DATA      0xc0010015u
+
+static uint8_t rn_resp[512];
+static uint32_t rn_resp_len;
+static bool rn_notify_more;
+static uint32_t rn_filter;
+
+static uint32_t
+rn_get(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static void
+rn_put(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+}
+
+/* OID_* query: the value into d (at most max bytes); its length, or -1 = not supported. */
+static int
+rn_query(uint32_t oid, uint8_t *d, uint32_t max)
+{
+	static const uint32_t supported[] = {
+		0x00010101, 0x00010102, 0x00010103, 0x00010104, 0x00010105, 0x00010106, 0x00010107,
+		0x00010108, 0x00010109, 0x0001010a, 0x0001010b, 0x0001010c, 0x0001010d, 0x0001010e,
+		0x0001010f, 0x00010110, 0x00010111, 0x00010112, 0x00010113, 0x00010114, 0x00010115,
+		0x00010116, 0x00020101, 0x00020102, 0x00020103, 0x00020104, 0x00020105,
+		0x01010101, 0x01010102, 0x01010103, 0x01010104, 0x01010105,
+		0x01020101, 0x01020102, 0x01020103,
+	};
+	uint32_t v = 0;
+
+	if (max < 16) {
+		return -1;
+	}
+	switch (oid) {
+	case 0x00010101:                                /* GEN_SUPPORTED_LIST */
+		if (sizeof(supported) > max) {
+			return -1;
+		}
+		for (unsigned i = 0; i < sizeof(supported) / sizeof(supported[0]); i++) {
+			rn_put(d + 4 * i, supported[i]);
+		}
+		return (int)sizeof(supported);
+	case 0x00010102: v = 0; break;                  /* HARDWARE_STATUS: ready */
+	case 0x00010103: v = 0; break;                  /* MEDIA_SUPPORTED: 802.3 */
+	case 0x00010104: v = 0; break;                  /* MEDIA_IN_USE: 802.3 */
+	case 0x00010105: v = 1500; break;               /* MAXIMUM_LOOKAHEAD */
+	case 0x00010106: v = 1500; break;               /* MAXIMUM_FRAME_SIZE */
+	case 0x00010107: v = 4800000; break;            /* LINK_SPEED, 100 bit/s units = 480 Mbit/s */
+	case 0x00010108: v = 0x10000; break;            /* TRANSMIT_BUFFER_SPACE */
+	case 0x00010109: v = 0x10000; break;            /* RECEIVE_BUFFER_SPACE */
+	case 0x0001010a: v = 1514; break;               /* TRANSMIT_BLOCK_SIZE */
+	case 0x0001010b: v = 1514; break;               /* RECEIVE_BLOCK_SIZE */
+	case 0x0001010c: v = 0x1209; break;             /* VENDOR_ID */
+	case 0x0001010d:                                /* VENDOR_DESCRIPTION (ASCII, NUL-terminated) */
+		memcpy(d, "ios-sweet", 10);
+		return 10;
+	case 0x0001010e: v = rn_filter; break;          /* CURRENT_PACKET_FILTER */
+	case 0x0001010f: v = 1500; break;               /* CURRENT_LOOKAHEAD */
+	case 0x00010110: v = 1; break;                  /* DRIVER_VERSION */
+	case 0x00010111: v = RN_PKT_HDR + 1514; break;  /* MAXIMUM_TOTAL_SIZE */
+	case 0x00010112: v = 0; break;                  /* PROTOCOL_OPTIONS */
+	case 0x00010113: v = 0x804; break;              /* MAC_OPTIONS: receive serialized, full duplex */
+	case 0x00010114: v = 0; break;                  /* MEDIA_CONNECT_STATUS: connected */
+	case 0x00010115: v = 1; break;                  /* MAXIMUM_SEND_PACKETS */
+	case 0x00010116: v = 0; break;                  /* VENDOR_DRIVER_VERSION */
+	case 0x00010202: v = 0; break;                  /* PHYSICAL_MEDIUM: unspecified */
+	case 0x00020101: v = (uint32_t)ud.tx_frames; break;     /* XMIT_OK */
+	case 0x00020102: v = (uint32_t)ud.rx_frames; break;     /* RCV_OK */
+	case 0x00020103: case 0x00020104: case 0x00020105:      /* XMIT_ERROR, RCV_ERROR, RCV_NO_BUFFER */
+		v = 0;
+		break;
+	case 0x01010101:                                /* 802_3_PERMANENT_ADDRESS */
+	case 0x01010102:                                /* 802_3_CURRENT_ADDRESS */
+		memcpy(d, ud_host_mac, 6);
+		return 6;
+	case 0x01010103:                                /* 802_3_MULTICAST_LIST: none */
+		return 0;
+	case 0x01010104: v = 32; break;                 /* 802_3_MAXIMUM_LIST_SIZE */
+	case 0x01010105: v = 0; break;                  /* 802_3_MAC_OPTIONS */
+	case 0x01020101: case 0x01020102: case 0x01020103:
+		v = 0;
+		break;
+	default:
+		return -1;
+	}
+	rn_put(d, v);
+	return 4;
+}
+
+/* One RNDIS control message in (len bytes); the answer into out (max bytes); its length, 0 = none. */
+static uint32_t
+rn_handle(const uint8_t *in, uint32_t len, uint8_t *out, uint32_t max)
+{
+	uint32_t type, mlen, reqid, status, total;
+
+	if (len < 12 || max < 52) {
+		return 0;
+	}
+	type = rn_get(in);
+	mlen = rn_get(in + 4);
+	if (mlen < 12 || mlen > len) {
+		return 0;
+	}
+	reqid = rn_get(in + 8);
+	bzero(out, 52);
+	switch (type) {
+	case RN_INITIALIZE:
+		if (mlen < 24) {
+			return 0;
+		}
+		rn_filter = 0;
+		rn_put(out, RN_INITIALIZE | RN_CMPLT);
+		rn_put(out + 4, 52);
+		rn_put(out + 8, reqid);
+		rn_put(out + 12, RN_ST_OK);
+		rn_put(out + 16, 1);                    /* major */
+		rn_put(out + 20, 0);                    /* minor */
+		rn_put(out + 24, 1);                    /* DeviceFlags: connectionless */
+		rn_put(out + 28, 0);                    /* Medium: 802.3 */
+		rn_put(out + 32, 1);                    /* MaxPacketsPerMessage */
+		rn_put(out + 36, UD_FRAME_MAX);         /* MaxTransferSize = the receive buffer */
+		rn_put(out + 40, 2);                    /* PacketAlignmentFactor: 4 bytes */
+		return 52;
+	case RN_QUERY: {
+		int n;
+		if (mlen < 28) {
+			return 0;
+		}
+		n = rn_query(rn_get(in + 12), out + 24, max - 24);
+		total = n < 0 ? 24 : 24 + (uint32_t)n;
+		rn_put(out, RN_QUERY | RN_CMPLT);
+		rn_put(out + 4, total);
+		rn_put(out + 8, reqid);
+		rn_put(out + 12, n < 0 ? RN_ST_NOT_SUPPORTED : RN_ST_OK);
+		rn_put(out + 16, n < 0 ? 0 : (uint32_t)n);
+		rn_put(out + 20, n <= 0 ? 0 : 16);      /* offset from byte 8 */
+		return total;
+	}
+	case RN_SET: {
+		uint32_t oid, ilen, ioff;
+		status = RN_ST_OK;
+		if (mlen < 28) {
+			status = RN_ST_INVALID_DATA;
+		} else {
+			oid = rn_get(in + 12);
+			ilen = rn_get(in + 16);
+			ioff = rn_get(in + 20) + 8;
+			if (ioff > mlen || ilen > mlen - ioff) {
+				status = RN_ST_INVALID_DATA;
+			} else if (oid == 0x0001010e) {         /* CURRENT_PACKET_FILTER */
+				if (ilen >= 4) {
+					rn_filter = rn_get(in + ioff);
+				} else {
+					status = RN_ST_INVALID_DATA;
+				}
+			} else if (oid == 0x0001010f || oid == 0x01010103 || oid == 0xfd010101) {
+				/* CURRENT_LOOKAHEAD, 802_3_MULTICAST_LIST, PNP_SET_POWER: accepted */
+			} else {
+				status = RN_ST_NOT_SUPPORTED;
+			}
+		}
+		rn_put(out, RN_SET | RN_CMPLT);
+		rn_put(out + 4, 16);
+		rn_put(out + 8, reqid);
+		rn_put(out + 12, status);
+		return 16;
+	}
+	case RN_RESET:
+		rn_filter = 0;
+		rn_put(out, RN_RESET | RN_CMPLT);
+		rn_put(out + 4, 16);
+		rn_put(out + 8, RN_ST_OK);
+		rn_put(out + 12, 1);                    /* AddressingReset */
+		return 16;
+	case RN_KEEPALIVE:
+		rn_put(out, RN_KEEPALIVE | RN_CMPLT);
+		rn_put(out + 4, 16);
+		rn_put(out + 8, reqid);
+		rn_put(out + 12, RN_ST_OK);
+		return 16;
+	case RN_HALT:
+		rn_filter = 0;
+		return 0;
+	default:
+		return 0;
+	}
+}
+/* RNDIS-PURE-END */
+
+static void ud_tx_kick_locked(void);
+static void ud_link_event(bool up);
+
+/* Frames may flow: ECM after SET_INTERFACE/SET_CONFIGURATION, RNDIS once the host set a packet filter. */
+static inline bool
+ud_tx_ready(void)
+{
+	return ud.configured && (!ud_rndis || ud.rndis_up);
+}
+
+/* RESPONSE_AVAILABLE on the interrupt endpoint (one at a time; a second one waits for the first). */
+static void
+ud_rn_notify(void)
+{
+	if (ud_active[EP_INT]) {
+		rn_notify_more = true;
+		return;
+	}
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	bzero(n, 8);
+	n[0] = 1;
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
+}
+
+static void
+ud_rndis_command(const uint8_t *cmd, uint32_t len)
+{
+	static uint8_t local[UD_RN_CMD_MAX];
+	static unsigned logged;
+	uint32_t type, n;
+	bool up, changed;
+
+	if (len < 12) {
+		return;
+	}
+	memcpy(local, cmd, len);
+	type = rn_get(local);
+	n = rn_handle(local, len, rn_resp, sizeof(rn_resp));
+	if (logged++ < 60) {
+		printf("HOTDOGB USB: rndis msg 0x%x (%u bytes) oid 0x%x -> %u bytes\n", type, len,
+		    len >= 16 ? rn_get(local + 12) : 0, n);
+	}
+	up = rn_filter != 0;
+	lck_mtx_lock(ud.lock);
+	changed = ud.rndis_up != up;
+	ud.rndis_up = up;
+	if (up) {
+		ud_tx_kick_locked();
+	}
+	lck_mtx_unlock(ud.lock);
+	if (changed) {
+		printf("HOTDOGB USB: rndis link %s (packet filter 0x%x)\n", up ? "up" : "down", rn_filter);
+		ud_link_event(up);
+	}
+	if (n != 0) {
+		rn_resp_len = n;
+		ud_rn_notify();
+	}
+}
+
 static uint32_t
 ud_string(unsigned idx, uint8_t *out)
 {
@@ -403,7 +706,7 @@
 	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0])) {
 		return 0;
 	}
-	const char *str = ud_strings[idx];
+	const char *str = (ud_rndis && idx == 2) ? "Sweet iOS (USB RNDIS)" : ud_strings[idx];
 	uint32_t n = 2;
 	for (; *str && n < 126; str++) {
 		out[n++] = (uint8_t)*str;
@@ -442,8 +745,8 @@
 	    ud_epcmd(EP_RX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
 	    ud_epcmd(EP_TX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3) | (1u << 17), (1u << 8) | ((uint32_t)EP_TX << 25), 0) ||
 	    ud_epcmd(EP_TX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
-	    ud_epcmd(EP_INT, DEPCMD_SETEPCONFIG, (3u << 1) | (16u << 3) | (2u << 17),
-	    (1u << 8) | (8u << 16) | ((uint32_t)EP_INT << 25), 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETEPCONFIG, (3u << 1) | ((ud_rndis ? 8u : 16u) << 3) | (2u << 17),
+	    (1u << 8) | ((ud_rndis ? 4u : 8u) << 16) | ((uint32_t)EP_INT << 25), 0) ||
 	    ud_epcmd(EP_INT, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
 		printf("HOTDOGB USB: data endpoints setup failed\n");
 		return;
@@ -454,7 +757,7 @@
 	ud_tx_kick_locked();                    /* 0151: whatever was queued meanwhile goes now */
 	lck_mtx_unlock(ud.lock);
 	ud_rx_arm();
-	printf("HOTDOGB USB: ECM endpoints configured\n");
+	printf("HOTDOGB USB: %s endpoints configured\n", ud_rndis ? "RNDIS" : "ECM");
 }
 
