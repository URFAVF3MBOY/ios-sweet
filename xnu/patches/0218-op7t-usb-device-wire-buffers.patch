+{
+	flush_dcache64((addr64_t)(u.dma + off), len ? len : 1, FALSE);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+template <typename T> static inline T
+rget(void *req, size_t off)
+{
+	return *(T *)((uint8_t *)req + off);
+}
+
+template <typename T> static inline void
+rput(void *req, size_t off, T v)
+{
+	*(T *)((uint8_t *)req + off) = v;
+}
+
+static void *
