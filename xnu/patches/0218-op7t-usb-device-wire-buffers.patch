+		uint64_t len = rget<uint64_t>(req, REQ_LENGTH);
+		IOMemoryDescriptor *md = rget<IOMemoryDescriptor *>(req, REQ_BUFFER);
+		uint64_t left = len - p->offset;
+		uint32_t chunk = (uint32_t)(left > D_BOUNCE_SIZE ? D_BOUNCE_SIZE : left);
+		if (!p->prepared) {
+			if (!buf_prepare(req)) {
+				p->head = (p->head + 1) % QDEPTH;
+				p->count--;
+				p->offset = 0;
+				finish(req, kIOReturnNoMemory, 0);
+				continue;
+			}
+			p->prepared = true;
+		}
+		if (p->in) {
+			if (chunk && (!md || md->readBytes(p->offset, (void *)(u.dma + D_BOUNCE(ep)), chunk) != chunk)) {
+				p->head = (p->head + 1) % QDEPTH;
+				p->count--;
+				p->offset = 0;
+				buf_complete(req);
+				p->prepared = false;
+				finish(req, kIOReturnDMAError, 0);
+				continue;
+			}
+			dsync(D_BOUNCE(ep), chunk);
+			p->trb_len = chunk;
+		} else {
+			uint32_t mps = (uint32_t)(p->mps > 0 ? p->mps : 512);
+			uint32_t n = ((chunk ? chunk : 1) + mps - 1) / mps * mps;       /* OUT TRBs: whole packets */
+			if (n > D_BOUNCE_SIZE) {
+				n = D_BOUNCE_SIZE;
+			}
+			dsync(D_BOUNCE(ep), n);
+			p->trb_len = n;
+		}
+		start_trb(ep, D_BOUNCE(ep), p->trb_len, TRBCTL_NORMAL);
+		if (!p->busy) {                 /* the controller refused it */
+			p->head = (p->head + 1) % QDEPTH;
+			p->count--;
+			p->offset = 0;
+			buf_complete(req);
+			p->prepared = false;
+			finish(req, kIOReturnNotResponding, 0);
+		}
+		return;
+	}
+}
+
+static void
+data_complete(unsigned ep)
+{
+	struct Pep *p = &u.pep[ep];
+	p->busy = false;
+	if (!p->count) {
+		return;
+	}
+	void *req = p->q[p->head];
+	uint64_t len = rget<uint64_t>(req, REQ_LENGTH);
+	uint32_t res = trb_residue(ep);
+	uint32_t got = p->trb_len - (res <= p->trb_len ? res : p->trb_len);
+	bool done;
+	if (p->in) {
+		p->offset += got;
+		done = p->offset >= len || got < p->trb_len;
+	} else {
+		uint64_t room = len - p->offset;
+		uint32_t take = (uint32_t)(got > room ? room : got);
+		dsync(D_BOUNCE(ep), got);
+		IOMemoryDescriptor *md = rget<IOMemoryDescriptor *>(req, REQ_BUFFER);
+		if (take && md) {
+			md->writeBytes(p->offset, (void *)(u.dma + D_BOUNCE(ep)), take);
+		}
+		p->offset += take;
+		done = p->offset >= len || got < p->trb_len;    /* short packet ends the transfer */
+	}
+	if (done) {
+		p->head = (p->head + 1) % QDEPTH;
+		p->count--;
+		uint64_t actual = p->offset;
+		p->offset = 0;
+		buf_complete(req);
+		p->prepared = false;
+		finish(req, kIOReturnSuccess, actual);
+	}
+	data_kick(ep);
+}
+
+static void
+data_cancel(unsigned ep, IOReturn status)
+{
+	struct Pep *p = &u.pep[ep];
+	end_transfer(ep);
+	p->offset = 0;
+	if (p->prepared && p->count) {
+		buf_complete(p->q[p->head]);
+	}
+	p->prepared = false;
+	while (p->count) {
+		void *req = p->q[p->head];
+		p->head = (p->head + 1) % QDEPTH;
+		p->count--;
+		finish(req, status, 0);
+	}
+}
+
+/* ---- port events ---- */
+static void
+port_reset(const char *why)
+{
+	ep0_cancel(kIOReturnAborted);
+	for (unsigned ep = 2; ep < NPEP; ep++) {
+		data_cancel(ep, kIOReturnAborted);
+	}
+	wr(DCFG, rd(DCFG) & ~(0x7fu << 3));
+	u.need_startcfg = true;
+	LOG("%s", why);
+	call_base(kSlotUSBReset);       /* the family drops the configuration (deactivateEndpoint for every pipe) */
+	ep0_arm_setup();
+}
+
+static void
+handle_event(uint32_t ev)
+{
+	if (ev & 1) {                   /* device event */
+		uint32_t type = (ev >> 8) & 0xf;
+		if (type == 1) {
+			port_reset("bus reset");
+		} else if (type == 2) {
+			uint32_t sp = rd(DSTS) & 7;
+			u.speed = sp == 0 ? kSpeedHigh : kSpeedFull;     /* DSTS.CONNECTSPD: 0 high, 1/3 full */
+			epcmd(0, DEPCMD_SETEPCONFIG, (64u << 3) | (2u << 30), (1u << 8) | (1u << 10) | (0u << 25), 0);
+			epcmd(1, DEPCMD_SETEPCONFIG, (64u << 3) | (2u << 30), (1u << 8) | (1u << 10) | (1u << 25), 0);
+			LOG("connected, speed field %u", sp);
+		} else if (type == 0) {
+			ep0_cancel(kIOReturnAborted);
+			LOG("disconnect");
+			call_base(kSlotUSBReset);
+		}
+		return;
+	}
+	unsigned ep = (ev >> 1) & 0x1f;
+	unsigned type = (ev >> 6) & 0xf;
+	unsigned status = (ev >> 12) & 0xf;
+	if (ep >= NPEP) {
+		return;
+	}
+	if (ep <= 1) {
+		if (type == 1) {                /* XferComplete */
+			u.pep[ep].busy = false;
+			ep0_complete(ep);
+		} else if (type == 3 && status == 2) {  /* XferNotReady, control status phase */
+			u.status_ready[ep] = true;
+			if (ep == 1) {
+				ep0_kick();
+			} else {
+				ep0_try_status_out();
+			}
+		}
+		return;
+	}
+	if (type == 1) {
+		data_complete(ep);
+	}
+}
+
+static IOReturn
+process_events(OSObject *, void *, void *, void *, void *)
+{
+	uint32_t count = rd(GEVNTCOUNT) & 0xffff;
+	if (!count) {
+		return kIOReturnSuccess;
+	}
+	dsync(D_EVT, D_EVT_SIZE);
+	for (uint32_t done = 0; done < count; done += 4) {
+		uint32_t ev = *(volatile uint32_t *)(u.dma + D_EVT + u.evt_pos);
+		u.evt_pos = (u.evt_pos + 4) % D_EVT_SIZE;
+		if (u.events++ < 300) {
+			LOG("event 0x%08x", ev);
+		}
+		handle_event(ev);
+	}
+	wr(GEVNTCOUNT, count);
+	return kIOReturnSuccess;
+}
+
+static void
+poll_thread(void *, wait_result_t)
+{
+	for (;;) {
+		if (rd(GEVNTCOUNT) & 0xffff) {
+			u.loop->runAction(process_events, (OSObject *)u.obj);
+		}
+		IOSleep(1);
+	}
+}
+
+/* ---- the controller's methods (C++ member calling convention: this first) ---- */
+static bool
+m_start(void *self, IOService *provider)
+{
+	if (!((fn_start)u.base[kSlotStart])(self, provider)) {
+		LOG("IOUSBDeviceController::start failed");
+		return false;
+	}
+	LOG("IOUSBDeviceController::start ok; readyForHost");
+	((fn_v)sweet_usbdev_abi.ready_for_host)(self);
+	LOG("readyForHost done (control request %p)", control_request());
+	return true;
+}
+
+static IOWorkLoop *
+m_get_work_loop(const void *)
+{
+	return u.loop;
+}
+
+static void
+set_bus(bool on)
+{
+	if (on) {
+		if (u.qs) {
+			*(volatile uint32_t *)(u.qs + QS_HS_PHY_CTRL) |= (1u << 20) | (1u << 28);    /* VBUS valid, session */
+			*(volatile uint32_t *)(u.qs + QS_SS_PHY_CTRL) |= (1u << 24);
+			__asm__ volatile ("dsb sy" ::: "memory");
+		}
+		wr(DCTL, rd(DCTL) | DCTL_RUN_STOP);
+	} else {
+		wr(DCTL, rd(DCTL) & ~DCTL_RUN_STOP);
+	}
+	for (int i = 0; i < 500 && ((rd(DSTS) & DSTS_DEVCTRLHLT) != 0) == on; i++) {
+		IODelay(1000);
+	}
+	u.on_bus = on;
+	LOG("bus %s (DSTS 0x%08x)", on ? "on" : "off", rd(DSTS));
+}
+
+static void m_soft_disconnect(void *, uint32_t) { set_bus(false); }
+static void m_go_on_bus(void *, bool on) { LOG("goOnBus(%d)", on); set_bus(on); }
+static bool m_accessory_cable(void *) { return false; }
+
+static IOReturn
+m_stall(void *, int address, bool stall)
+{
+	unsigned ep = pep_of(address);
+	if (ep >= NPEP) {
+		return kIOReturnBadArgument;
+	}
+	if (ep <= 1) {
+		if (stall) {
+			ep0_cancel(kIOReturnAborted);
+			epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
+			ep0_arm_setup();
+		}
+		return kIOReturnSuccess;
+	}
+	if (stall) {
+		end_transfer(ep);
+		epcmd(ep, DEPCMD_SETSTALL, 0, 0, 0);
+		u.pep[ep].stalled = true;
+	} else {
+		epcmd(ep, DEPCMD_CLEARSTALL, 0, 0, 0);
+		u.pep[ep].stalled = false;
+		data_kick(ep);
+	}
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+m_abort(void *, int address)
+{
+	unsigned ep = pep_of(address);
+	if (ep >= NPEP) {
+		return kIOReturnBadArgument;
+	}
+	if (ep <= 1) {
+		ep0_cancel(kIOReturnAborted);
+		if (u.stage == E_IDLE && !u.pep[0].busy) {
+			ep0_arm_setup();
+		}
+	} else {
+		data_cancel(ep, kIOReturnAborted);
+	}
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+m_set_address_pre(void *, int address)
+{
+	wr(DCFG, (rd(DCFG) & ~(0x7fu << 3)) | (((uint32_t)address & 0x7fu) << 3));
+	LOG("address %d", address & 0x7f);
+	return kIOReturnSuccess;
+}
+
+static IOReturn m_set_address_post(void *, int) { return kIOReturnSuccess; }
+static int m_speed(void *) { return u.speed ? u.speed : kSpeedHigh; }      /* no cable detector: always a cable */
+
+static IOReturn
+m_endpoint_ids(void *, OSArray *interfaces, uint8_t *ids)
+{
+	if (!interfaces || !ids) {
+		return kIOReturnBadArgument;
+	}
+	unsigned next_in = 1, next_out = 1, written = 0;
+	for (unsigned i = 0; i < interfaces->getCount(); i++) {
+		void *intf = interfaces->getObject(i);
+		if (!intf) {
+			continue;
+		}
+		unsigned widest_in = 0, widest_out = 0;
+		int alts = ((fn_i)sweet_usbdev_abi.if_alt_count)(intf);
+		for (int alt = 0; alt < alts; alt++) {
+			unsigned in = 0, out = 0;
+			int pipes = ((fn_iu8)sweet_usbdev_abi.if_pipe_count)(intf, (uint8_t)alt);
+			for (int p = 0; p < pipes; p++) {
+				void *pipe = ((fn_pipe)sweet_usbdev_abi.if_pipe)(intf, p, (uint8_t)alt);
+				int dir = pipe ? ((fn_i)sweet_usbdev_abi.pipe_dir)(pipe) : -1;
+				if (dir == 1) {
+					if (next_in + in > NPEP / 2 - 1) {
+						return kIOReturnNoResources;
+					}
+					ids[written++] = (uint8_t)(0x80 | (next_in + in++));
+				} else if (dir == 0) {
+					if (next_out + out > NPEP / 2 - 1) {
+						return kIOReturnNoResources;
+					}
+					ids[written++] = (uint8_t)(next_out + out++);
+				}
+			}
+			widest_in = in > widest_in ? in : widest_in;
+			widest_out = out > widest_out ? out : widest_out;
+		}
+		next_in += widest_in;
+		next_out += widest_out;
+	}
+	LOG("endpoint ids for %u interfaces: %u numbers", interfaces->getCount(), written);
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+m_prepare(void *, OSArray *)
+{
+	u.need_startcfg = true;
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+m_activate(void *, int address, int type, int mps, int interval, int)
+{
+	unsigned ep = pep_of(address);
+	if (ep <= 1) {
+		return kIOReturnSuccess;
+	}
+	if (ep >= NPEP || mps <= 0) {
+		return kIOReturnBadArgument;
+	}
+	if (type == kTypeIsoc) {
+		LOG("isochronous endpoint 0x%x refused", address);
+		return kIOReturnUnsupported;
+	}
+	if (u.need_startcfg) {          /* new configuration: transfer resources handed out again (Linux, sweet_usb.c) */
+		epcmd(0, DEPCMD_DEPSTARTCFG | (2u << 16), 0, 0, 0);
+		u.need_startcfg = false;
+	}
+	struct Pep *p = &u.pep[ep];
+	bool in = (address & 0x80) != 0;
+	uint32_t p0 = ((uint32_t)type << 1) | ((uint32_t)mps << 3);
+	if (in) {
+		p0 |= ((uint32_t)address & 0xfu) << 17;         /* TX FIFO = endpoint number */
+	}
+	uint32_t p1 = (1u << 8) | ((uint32_t)ep << 25);    /* XferComplete event */
+	if (type == kTypeInterrupt) {
+		uint32_t iv = interval < 1 ? 1 : (uint32_t)interval;
+		uint32_t m1 = u.speed == kSpeedFull ? 3 : (iv > 16 ? 15 : iv - 1);
+		p1 |= m1 << 16;
+	}
+	if (epcmd(ep, DEPCMD_SETEPCONFIG, p0, p1, 0) || epcmd(ep, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		return kIOReturnError;
+	}
+	wr(DALEPENA, rd(DALEPENA) | (1u << ep));
+	p->active = true;
+	p->in = in;
+	p->type = type;
+	p->mps = mps;
+	p->stalled = false;
+	LOG("endpoint 0x%x on (type %d, %d bytes)", address, type, mps);
+	data_kick(ep);
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+m_deactivate(void *, int address)
+{
+	unsigned ep = pep_of(address);
+	if (ep <= 1 || ep >= NPEP) {
+		return kIOReturnSuccess;
+	}
+	data_cancel(ep, kIOReturnAborted);
+	u.pep[ep].active = false;
+	wr(DALEPENA, rd(DALEPENA) & ~(1u << ep));
+	return kIOReturnSuccess;
+}
+
+static IOBufferMemoryDescriptor *
+m_create_buffer(void *, IOOptionBits options, uint64_t capacity)
+{
+	return IOBufferMemoryDescriptor::withOptions(options & ~(IOOptionBits)kIOMemoryPageable, (vm_size_t)capacity, 64);
+}
+
+static bool
+m_is_stalled(void *, int address)
+{
+	unsigned ep = pep_of(address);
+	return ep < NPEP && u.pep[ep].stalled;
+}
+
+static IOReturn
+m_reset_toggle(void *, int address)
+{
+	unsigned ep = pep_of(address);
+	if (ep > 1 && ep < NPEP && u.pep[ep].active) {
+		epcmd(ep, DEPCMD_CLEARSTALL, 0, 0, 0);          /* clears the data sequence too */
+	}
+	return kIOReturnSuccess;
+}
+
+static void
+m_reenumerate(void *)
+{
+	set_bus(false);
+	IOSleep(100);
+	set_bus(true);
+}
+
+static IOReturn m_remote_wake(void *) { return kIOReturnUnsupported; }
+
+static void
+m_cr_state_change(void *, int old_state, int new_state)
+{
+	LOGN("control request state %d -> %d", old_state, new_state);
+	if (new_state == kStateOutData || new_state == kStateOutDataLong) {
+		void *cr = control_request();
+		uint16_t wlength = 0;
+		if (cr) {
+			const uint8_t *setup = (const uint8_t *)cr + 16;
+			wlength = (uint16_t)(setup[6] | setup[7] << 8);
+		}
+		uint32_t n = wlength > D_EP0_SIZE ? D_EP0_SIZE : wlength;
+		u.ep0_len = (n + 63u) & ~63u;
+		dsync(D_EP0, u.ep0_len);
+		u.stage = E_DATA_OUT;
+		start_trb(0, D_EP0, u.ep0_len, TRBCTL_DATA);
+	} else if (new_state == kStateOutStatus) {
+		u.status_out_wanted = true;
+		ep0_try_status_out();
+	}
+}
+
+static IOReturn
+m_io_gated(void *, void *req)
+{
+	int address = rget<int32_t>(req, REQ_ENDPOINT);
+	if (!((unsigned)address & 0x7fu)) {
+		if (!((unsigned)address & 0x80u)) {
+			return kIOReturnUnsupported;    /* OUT data arrives through inputDataPacket */
+		}
+		if (u.ep0_count == 8) {
+			return kIOReturnNoResources;
+		}
+		u.ep0_q[(u.ep0_head + u.ep0_count++) % 8] = req;
+		ep0_kick();
+		return kIOReturnSuccess;
+	}
+	unsigned ep = pep_of(address);
+	if (ep >= NPEP || !u.pep[ep].active) {
+		return kIOReturnNotReady;
+	}
+	if (rget<uint8_t>(req, REQ_ISOC)) {
+		return kIOReturnUnsupported;
+	}
+	struct Pep *p = &u.pep[ep];
+	if (p->count == QDEPTH) {
+		return kIOReturnNoResources;
+	}
+	p->q[(p->head + p->count++) % QDEPTH] = req;
+	data_kick(ep);
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+m_buffer_options(void *, uint32_t *options)
+{
+	*options = 0;
+	return kIOReturnSuccess;
+}
+
+/* ---- start-up ---- */
+bool
+sweet_usbdev_available(void)
+{
+	return sweet_usbdev_abi.magic == SWEET_USBDEV_ABI_FILLED && sweet_usbdev_abi.vtable && sweet_usbdev_abi.ctor &&
+	       sweet_usbdev_abi.ready_for_host && sweet_usbdev_abi.complete_io && sweet_usbdev_abi.cr_input_setup;
+}
+
+static bool
+hw_init(void)
+{
+	wr(DCTL, DCTL_CSFTRST);
+	int i;
+	for (i = 0; i < 500 && (rd(DCTL) & DCTL_CSFTRST); i++) {
+		IODelay(1000);
+	}
+	if (rd(DCTL) & DCTL_CSFTRST) {
+		LOG("soft reset stuck");
+		return false;
+	}
+	wr(GEVNTADRLO, (uint32_t)(u.dma_pa + D_EVT));
+	wr(GEVNTADRHI, (uint32_t)((u.dma_pa + D_EVT) >> 32));
+	wr(GEVNTSIZ, (1u << 31) | D_EVT_SIZE);           /* interrupt masked: polled */
+	wr(GEVNTCOUNT, rd(GEVNTCOUNT) & 0xffff);
+	u.evt_pos = 0;
+	wr(DCFG, rd(DCFG) & ~(7u | (0x7fu << 3)));      /* high speed, address 0 */
+	wr(DEVTEN, 0x7);                                /* disconnect, reset, connect done */
+	if (epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
+	    epcmd(0, DEPCMD_SETEPCONFIG, (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    epcmd(1, DEPCMD_SETEPCONFIG, (512u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		LOG("endpoint 0 setup failed");
+		return false;
+	}
+	wr(DALEPENA, 0x3);
+	ep0_arm_setup();
+	return true;
+}
+
+bool
+sweet_usbdev_start(vm_offset_t dwc, vm_offset_t qscratch)
+{
+	const char *why = NULL;
+	if (!sweet_usbdev_available()) {
+		LOG("no IOUSBDeviceFamily address table (image without the prelinked kexts)");
+		return false;
+	}
+	u.dwc = dwc;
+	u.qs = qscratch;
+	if (OSKext::loadKextWithIdentifier("com.apple.iokit.IOUSBDeviceFamily", false) != kOSReturnSuccess) {
+		LOG("IOUSBDeviceFamily did not load");
+		return false;
+	}
+	OSKext::loadKextWithIdentifier("com.apple.driver.AppleUSBDeviceMux", false);
+	const OSMetaClass *meta = (const OSMetaClass *)sweet_usbdev_abi.meta;
+	LOG("IOUSBDeviceFamily loaded; IOUSBDeviceController metaclass size %u", meta ? meta->getClassSize() : 0);
+	if (!meta || meta->getClassSize() != CTRL_SIZE) {
+		LOG("IOUSBDeviceController is not the iOS 16.5 one: not starting");
+		return false;
+	}
+	if (sweet_usb_dma_alloc(D_SIZE, &u.dma, &u.dma_pa) != 0) {
+		LOG("no DMA memory below 4 GiB");
+		return false;
+	}
+	LOG("DMA area 0x%llx (%u KiB)", u.dma_pa, D_SIZE / 1024);
+
+	/* the subclass: Apple's vtable with our methods */
+	memcpy(sw_vt, (const void *)sweet_usbdev_abi.vtable, sizeof(sw_vt));
+	u.base = (void **)(sweet_usbdev_abi.vtable + 16);
+	void **vt = &sw_vt[2];
+	vt[kSlotStart] = (void *)&m_start;
+	vt[kSlotGetWorkLoop] = (void *)&m_get_work_loop;
+	vt[kSlotSoftDisconnect] = (void *)&m_soft_disconnect;
+	vt[kSlotGoOnBus] = (void *)&m_go_on_bus;
+	vt[kSlotAccessoryCable] = (void *)&m_accessory_cable;
+	vt[kSlotStall] = (void *)&m_stall;
+	vt[kSlotAbort] = (void *)&m_abort;
+	vt[kSlotSetAddressPre] = (void *)&m_set_address_pre;
+	vt[kSlotSetAddressPost] = (void *)&m_set_address_post;
+	vt[kSlotSpeed] = (void *)&m_speed;
+	vt[kSlotEndpointIDs] = (void *)&m_endpoint_ids;
+	vt[kSlotPrepareConfig] = (void *)&m_prepare;
+	vt[kSlotActivate] = (void *)&m_activate;
+	vt[kSlotDeactivate] = (void *)&m_deactivate;
+	vt[kSlotCreateBuffer] = (void *)&m_create_buffer;
+	vt[kSlotIsStalled] = (void *)&m_is_stalled;
+	vt[kSlotResetToggle] = (void *)&m_reset_toggle;
+	vt[kSlotReEnumerate] = (void *)&m_reenumerate;
+	vt[kSlotRemoteWake] = (void *)&m_remote_wake;
+	vt[kSlotCRStateChange] = (void *)&m_cr_state_change;
+	vt[kSlotIOGated] = (void *)&m_io_gated;
+	vt[kSlotBufferOptions] = (void *)&m_buffer_options;
+
+	u.obj = IOMallocZero(1024);
+	u.loop = IOWorkLoop::workLoop();
+	if (!u.obj || !u.loop) {
+		LOG("out of memory");
+		return false;
+	}
+	((fn_vp)sweet_usbdev_abi.ctor)(u.obj, (void *)meta);
+	*(void ***)u.obj = vt;
+	IOService *svc = (IOService *)u.obj;
+
+	/* provider: a nub with the configuration the family's start looks up ("configuration-string", parents too) */
+	char config[64] = "standardBringup";
+	PE_parse_boot_argn("sweetusbconfig", config, sizeof(config));
+	IOService *nub = new IOService;
+	if (!nub || !nub->init()) {
+		LOG("no provider nub");
+		return false;
+	}
+	nub->setName("usb-device");
+	nub->setProperty("configuration-string", config);
+	if (!nub->attach(IOService::getPlatform() ? (IOService *)IOService::getPlatform() : IOService::getServiceRoot())) {
+		LOG("nub attach failed");
+		return false;
+	}
+	if (!svc->init()) {
+		why = "init";
+	} else if (!hw_init()) {
+		why = "DWC3 set-up";
+	} else if (!svc->attach(nub)) {
+		why = "attach";
+	} else if (!svc->start(nub)) {
+		why = "start";
+	}
+	if (why) {
+		LOG("controller %s failed", why);
+		return false;
+	}
+	thread_t th;
+	if (kernel_thread_start(poll_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+	LOG("controller up (configuration %s): waiting for the family's goOnBus", config);
+	return true;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
