-static void
-m_cr_state_change(void *, int old_state, int new_state)
-{
-	LOGN("control request state %d -> %d", old_state, new_state);
-	if (new_state == kStateOutData || new_state == kStateOutDataLong) {
-		void *cr = control_request();
-		uint16_t wlength = 0;
-		if (cr) {
-			const uint8_t *setup = (const uint8_t *)cr + 16;
-			wlength = (uint16_t)(setup[6] | setup[7] << 8);
-		}
-		uint32_t n = wlength > D_EP0_SIZE ? D_EP0_SIZE : wlength;
-		u.ep0_len = (n + 63u) & ~63u;
-		dsync(D_EP0, u.ep0_len);
-		u.stage = E_DATA_OUT;
-		start_trb(0, D_EP0, u.ep0_len, TRBCTL_DATA);
-	} else if (new_state == kStateOutStatus) {
-		u.status_out_wanted = true;
-		ep0_try_status_out();
-	}
