+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = len;
+	t[3] = ctl | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	dsync(D_TRB(ep), 16);
+	uint64_t tpa = u.dma_pa + D_TRB(ep);
