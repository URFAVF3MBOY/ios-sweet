-static IOReturn
-m_io_gated(void *, void *req)
-{
-	int address = rget<int32_t>(req, REQ_ENDPOINT);
-	if (!((unsigned)address & 0x7fu)) {
-		if (!((unsigned)address & 0x80u)) {
-			return kIOReturnUnsupported;    /* OUT data arrives through inputDataPacket */
-		}
-		if (u.ep0_count == 8) {
-			return kIOReturnNoResources;
-		}
-		u.ep0_q[(u.ep0_head + u.ep0_count++) % 8] = req;
-		ep0_kick();
-		return kIOReturnSuccess;
-	}
-	unsigned ep = pep_of(address);
-	if (ep >= NPEP || !u.pep[ep].active) {
-		return kIOReturnNotReady;
-	}
-	if (rget<uint8_t>(req, REQ_ISOC)) {
-		return kIOReturnUnsupported;
-	}
-	struct Pep *p = &u.pep[ep];
-	if (p->count == QDEPTH) {
-		return kIOReturnNoResources;
-	}
-	p->q[(p->head + p->count++) % QDEPTH] = req;
-	data_kick(ep);
-	return kIOReturnSuccess;
-}
