+		ep0_kick();
+		break;
+	}
+	case E_DATA_OUT: {
+		uint32_t res = trb_residue(0);
+		uint32_t got = u.ep0_len - (res <= u.ep0_len ? res : u.ep0_len);
+		dsync(D_EP0, got);
+		if (cr) {
+			((fn_data)sweet_usbdev_abi.cr_input_data)(cr, (uint8_t *)(u.dma + D_EP0), got);    /* -> state 7 */
+		}
+		ep0_kick();
+		break;
+	}
+	case E_STATUS_IN: {
+		void *req = u.ep0_req;
+		u.ep0_req = NULL;
+		if (req) {
