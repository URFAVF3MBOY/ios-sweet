-static IOReturn
-m_abort(void *, int address)
-{
-	unsigned ep = pep_of(address);
-	if (ep >= NPEP) {
-		return kIOReturnBadArgument;
-	}
-	if (ep <= 1) {
-		ep0_cancel(kIOReturnAborted);
-		if (u.stage == E_IDLE && !u.pep[0].busy) {
-			ep0_arm_setup();
-		}
-	} else {
-		data_cancel(ep, kIOReturnAborted);
-	}
-	return kIOReturnSuccess;
-}
