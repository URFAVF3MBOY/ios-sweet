-
-static IOReturn
-m_endpoint_ids(void *, OSArray *interfaces, uint8_t *ids)
-{
-	if (!interfaces || !ids) {
-		return kIOReturnBadArgument;
-	}
-	unsigned next_in = 1, next_out = 1, written = 0;
-	for (unsigned i = 0; i < interfaces->getCount(); i++) {
-		void *intf = interfaces->getObject(i);
-		if (!intf) {
-			continue;
-		}
-		unsigned widest_in = 0, widest_out = 0;
-		int alts = ((fn_i)sweet_usbdev_abi.if_alt_count)(intf);
-		for (int alt = 0; alt < alts; alt++) {
-			unsigned in = 0, out = 0;
-			int pipes = ((fn_iu8)sweet_usbdev_abi.if_pipe_count)(intf, (uint8_t)alt);
-			for (int p = 0; p < pipes; p++) {
-				void *pipe = ((fn_pipe)sweet_usbdev_abi.if_pipe)(intf, p, (uint8_t)alt);
-				int dir = pipe ? ((fn_i)sweet_usbdev_abi.pipe_dir)(pipe) : -1;
-				if (dir == 1) {
-					if (next_in + in > NPEP / 2 - 1) {
-						return kIOReturnNoResources;
-					}
-					ids[written++] = (uint8_t)(0x80 | (next_in + in++));
-				} else if (dir == 0) {
-					if (next_out + out > NPEP / 2 - 1) {
-						return kIOReturnNoResources;
-					}
-					ids[written++] = (uint8_t)(next_out + out++);
-				}
-			}
-			widest_in = in > widest_in ? in : widest_in;
-			widest_out = out > widest_out ? out : widest_out;
-		}
-		next_in += widest_in;
-		next_out += widest_out;
-	}
-	LOG("endpoint ids for %u interfaces: %u numbers", interfaces->getCount(), written);
-	return kIOReturnSuccess;
-}
-
-static IOReturn
-m_prepare(void *, OSArray *)
-{
-	u.need_startcfg = true;
-	return kIOReturnSuccess;
-}
-
-static IOReturn
-m_activate(void *, int address, int type, int mps, int interval, int)
-{
-	unsigned ep = pep_of(address);
-	if (ep <= 1) {
-		return kIOReturnSuccess;
-	}
-	if (ep >= NPEP || mps <= 0) {
-		return kIOReturnBadArgument;
-	}
-	if (type == kTypeIsoc) {
-		LOG("isochronous endpoint 0x%x refused", address);
-		return kIOReturnUnsupported;
-	}
-	if (u.need_startcfg) {          /* new configuration: transfer resources handed out again (Linux, sweet_usb.c) */
-		epcmd(0, DEPCMD_DEPSTARTCFG | (2u << 16), 0, 0, 0);
-		u.need_startcfg = false;
-	}
-	struct Pep *p = &u.pep[ep];
-	bool in = (address & 0x80) != 0;
-	uint32_t p0 = ((uint32_t)type << 1) | ((uint32_t)mps << 3);
-	if (in) {
-		p0 |= ((uint32_t)address & 0xfu) << 17;         /* TX FIFO = endpoint number */
-	}
-	uint32_t p1 = (1u << 8) | ((uint32_t)ep << 25);    /* XferComplete event */
-	if (type == kTypeInterrupt) {
-		uint32_t iv = interval < 1 ? 1 : (uint32_t)interval;
-		uint32_t m1 = u.speed == kSpeedFull ? 3 : (iv > 16 ? 15 : iv - 1);
-		p1 |= m1 << 16;
-	}
-	if (epcmd(ep, DEPCMD_SETEPCONFIG, p0, p1, 0) || epcmd(ep, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
-		return kIOReturnError;
-	}
-	wr(DALEPENA, rd(DALEPENA) | (1u << ep));
-	p->active = true;
-	p->in = in;
-	p->type = type;
-	p->mps = mps;
-	p->stalled = false;
-	LOG("endpoint 0x%x on (type %d, %d bytes)", address, type, mps);
-	data_kick(ep);
-	return kIOReturnSuccess;
-}
-
-static IOReturn
-m_deactivate(void *, int address)
-{
-	unsigned ep = pep_of(address);
-	if (ep <= 1 || ep >= NPEP) {
-		return kIOReturnSuccess;
-	}
-	data_cancel(ep, kIOReturnAborted);
-	u.pep[ep].active = false;
-	wr(DALEPENA, rd(DALEPENA) & ~(1u << ep));
-	return kIOReturnSuccess;
-}
