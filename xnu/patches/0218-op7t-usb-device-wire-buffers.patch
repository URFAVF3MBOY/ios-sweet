-static void
-set_bus(bool on)
-{
-	if (on) {
-		if (u.qs) {
-			*(volatile uint32_t *)(u.qs + QS_HS_PHY_CTRL) |= (1u << 20) | (1u << 28);    /* VBUS valid, session */
-			*(volatile uint32_t *)(u.qs + QS_SS_PHY_CTRL) |= (1u << 24);
-			__asm__ volatile ("dsb sy" ::: "memory");
-		}
-		wr(DCTL, rd(DCTL) | DCTL_RUN_STOP);
-	} else {
-		wr(DCTL, rd(DCTL) & ~DCTL_RUN_STOP);
-	}
-	for (int i = 0; i < 500 && ((rd(DSTS) & DSTS_DEVCTRLHLT) != 0) == on; i++) {
-		IODelay(1000);
-	}
-	u.on_bus = on;
