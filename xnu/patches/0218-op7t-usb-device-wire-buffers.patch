+/* ---- small helpers ---- */
+static inline void
+wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(u.dwc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(u.dwc + off);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return v;
+}
+
+static void
