+		break;
+	}
+	case E_STATUS_OUT:
+		if (cr) {
+			((fn_data)sweet_usbdev_abi.cr_input_data)(cr, (uint8_t *)(u.dma + D_EP0), 0);
+		}
+		ep0_arm_setup();
