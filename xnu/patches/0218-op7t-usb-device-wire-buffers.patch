+static int
+epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	wr(DEPCMDPAR0(ep), p0);
+	wr(DEPCMDPAR1(ep), p1);
+	wr(DEPCMDPAR2(ep), p2);
+	wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t v = rd(DEPCMD(ep));
+		if (!(v & DEPCMD_CMDACT)) {
+			uint32_t status = (v >> 12) & 0xf;
+			if (status) {
+				LOGN("ep%u cmd 0x%x status %u", ep, cmd & 0xf, status);
+				return -1;
+			}
+			return 0;
+		}
+		IODelay(1);
+	}
+	LOGN("ep%u cmd 0x%x timeout", ep, cmd & 0xf);
+	return -1;
