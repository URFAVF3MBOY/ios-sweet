+	LOGN("setup %02x %02x %02x%02x %02x%02x len %u", pkt[0], pkt[1], pkt[3], pkt[2], pkt[5], pkt[4], wlength);
+	u.data_stage = wlength != 0;
+	u.stage = E_IDLE;
+	void *cr = control_request();
+	if (!cr) {
+		epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
+		ep0_arm_setup();
+		return;
+	}
+	((fn_vp)sweet_usbdev_abi.cr_input_setup)(cr, pkt);
