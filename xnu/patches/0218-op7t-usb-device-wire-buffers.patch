-static IOReturn
-m_stall(void *, int address, bool stall)
-{
-	unsigned ep = pep_of(address);
-	if (ep >= NPEP) {
-		return kIOReturnBadArgument;
-	}
-	if (ep <= 1) {
-		if (stall) {
-			ep0_cancel(kIOReturnAborted);
-			epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
-			ep0_arm_setup();
-		}
-		return kIOReturnSuccess;
-	}
-	if (stall) {
-		end_transfer(ep);
-		epcmd(ep, DEPCMD_SETSTALL, 0, 0, 0);
-		u.pep[ep].stalled = true;
-	} else {
-		epcmd(ep, DEPCMD_CLEARSTALL, 0, 0, 0);
-		u.pep[ep].stalled = false;
-		data_kick(ep);
-	}
-	return kIOReturnSuccess;
-}
