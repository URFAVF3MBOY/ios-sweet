+/*
+ * OnePlus 7T (0092): the start-up in numbered steps. Each says what it is about to do and, with
+ * sweetusbslow=1 (default), waits 1.5 s so the persistent log (saved about once a second) has the
+ * line before the step runs: if a step sends the phone to crashdump, the last saved line names it.
+ * sweetusbstep=N stops after step N (default: all).
+ *   1  DMA area      2  network interface    3  controller soft reset    4  event buffer
+ *   5  device config + endpoint 0             6  VBUS override            7  run
+ * 7T facts (boot logs): DWC_usb31 1.10a (GSNPSID 0x33313130; the Redmi's was DWC_usb3 3.20a),
+ * ABL leaves it SuperSpeed-capable with its event buffer at 0xffaf9000, below 4 GiB. The 7T's
+ * kernel RAM is all above 4 GiB (0x1_0000_0000); every Android DMA pool here is below 4 GiB, and
+ * USB (unlike UFS) sits behind the apps SMMU (DT iommus 0x140).
+ */
+#define UD_LOW_PA       0xb0800000ULL   /* scratch RAM below 4 GiB, outside the kernel's (0089 GPU uses +0..+0x530000) */
+static int ud_max_step = 99, ud_slow = 1;
+
+static bool
+ud_step(int n, const char *what)
+{
+	if (n > ud_max_step) {
+		printf("HOTDOGB USB: stopping before step %d (sweetusbstep=%d)\n", n, ud_max_step);
+		return false;
+	}
+	printf("HOTDOGB USB: step %d: %s\n", n, what);
+	if (ud_slow) {
+		delay(1500 * 1000);
+	}
+	return true;
+}
+
+static void
+ud_start_thread(void *arg, wait_result_t wr)
+{
+	int wait_s = 10;
+	(void)arg; (void)wr;
+	PE_parse_boot_argn("sweetusbdelay", &wait_s, sizeof(wait_s));
+	PE_parse_boot_argn("sweetusbstep", &ud_max_step, sizeof(ud_max_step));
+	PE_parse_boot_argn("sweetusbslow", &ud_slow, sizeof(ud_slow));
+	printf("HOTDOGB USB: start-up in %d s\n", wait_s);
+	for (int s = 0; s < wait_s; s++) {
+		delay(1000 * 1000);
+	}
+	sweet_usb_gadget_start(ud_start_dwc);
+	thread_terminate(current_thread());
+}
