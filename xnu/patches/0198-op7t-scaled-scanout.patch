+/* 0198: the splash buffer's pipe values back (ABL's), scaler off; the caller flushes */
+void
+AppleCLCD::scanUnscale(void)
+{
+	for (uint32_t i = 0; i < SCAN_SAVED; i++) {
+		fVig0[kScanSaved[i] / 4] = fAbl[0][i];
+		fVig1[kScanSaved[i] / 4] = fAbl[1][i];
+	}
+	fScaledNow = false;
+	sweet_fb_scaled = 0;
+}
