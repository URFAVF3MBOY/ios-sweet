+/* 0198: show a 1125x2436 surface at pa shrunk to 1080x2339 (see fScale) */
+void
+AppleCLCD::scanScaled(uint32_t pa, uint32_t stride)
+{
+	const uint32_t step_x = (uint32_t)(((uint64_t)1125 << 21) / 1080);
+	const uint32_t step_y = (uint32_t)(((uint64_t)2436 << 21) / SCALE_DST_H);
+	/* initial phase: where the first output pixel's centre falls in the pipe's first source column, minus 0.5 */
+	const uint32_t init_y = (uint32_t)((((uint64_t)2436 << 21) / (2 * SCALE_DST_H)) - (1u << 20));
+	const uint32_t init_x0 = (uint32_t)((((uint64_t)1125 << 21) / (2 * 1080)) - (1u << 20));
+	const uint32_t init_x1 = (uint32_t)(((((uint64_t)(2 * SCALE_DST_W + 1) * 1125) << 21) / (2 * 1080)) -
+	    (1u << 20) - ((uint64_t)SCALE_SRC_X1 << 21));
+	const uint32_t src = (2436u << 16) | SCALE_SRC_W, dst = (SCALE_DST_H << 16) | SCALE_DST_W;
+	volatile uint32_t *pipe[2] = { fVig0, fVig1 };
+
+	__asm__ volatile ("dsb sy" ::: "memory");       /* the pixels before the switch */
+	for (int i = 0; i < 2; i++) {
+		volatile uint32_t *p = pipe[i];
+		uint32_t op = 1u | (3u << 16) | (1u << 14) | (1u << 31);   /* on, bilinear, 8-bit, blend */
+		uint32_t ix = i == 0 ? init_x0 : init_x1;
+
+		if (p[SSPP_SRC_FORMAT / 4] & (1u << 8)) {
+			op |= (1u << 10) | (1u << 29);          /* alpha: bilinear too */
+		}
+		p[SSPP_SRC0_ADDR / 4] = pa;
+		p[SSPP_YSTRIDE0 / 4] = stride;
+		p[SSPP_SRC_XY / 4] = i == 0 ? 0 : SCALE_SRC_X1;
+		p[SSPP_SRC_SIZE / 4] = src;
+		p[SSPP_SRC_IMG_SIZE / 4] = (2436u << 16) | 1125u;
+		p[SSPP_OUT_SIZE / 4] = dst;
+		p[SSPP_OUT_XY / 4] = (SCALE_TOP << 16) | (fAbl[i][3] & 0xffffu);   /* x as ABL put it in the mixer */
+		p[SSPP_PE_C0_LR / 4] = 0;
+		p[SSPP_PE_C0_TB / 4] = 0;
+		p[SSPP_PE_C0_REQ / 4] = src;
+		p[SSPP_PE_C1C2_LR / 4] = 0;
+		p[SSPP_PE_C1C2_TB / 4] = 0;
+		p[SSPP_PE_C1C2_REQ / 4] = src;
+		p[SSPP_PE_C3_LR / 4] = 0;
+		p[SSPP_PE_C3_TB / 4] = 0;
+		p[SSPP_PE_C3_REQ / 4] = src;
+		p[QS_PHASE_INIT_Y_H / 4] = ix & 0x1fffffu;
+		p[QS_PHASE_INIT_Y_V / 4] = init_y & 0x1fffffu;
+		p[QS_PHASE_INIT_UV_H / 4] = ix & 0x1fffffu;
+		p[QS_PHASE_INIT_UV_V / 4] = init_y & 0x1fffffu;
+		p[QS_PHASE_STEP_Y_H / 4] = step_x & 0xffffffu;
+		p[QS_PHASE_STEP_Y_V / 4] = step_y & 0xffffffu;
+		p[QS_PHASE_STEP_UV_H / 4] = step_x & 0xffffffu;
+		p[QS_PHASE_STEP_UV_V / 4] = step_y & 0xffffffu;
+		p[QS_PRELOAD / 4] = 0x03040304u;                /* sde defaults: h 4, v 3, both planes */
+		p[QS_SRC_SIZE_Y_RGB_A / 4] = src;
+		p[QS_SRC_SIZE_UV / 4] = src;
+		p[QS_DST_SIZE / 4] = dst;
+		p[QS_OP_MODE / 4] = op;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fCtl0[CTL_FLUSH / 4] = CTL_FLUSH_VIGS;          /* taken at the next refresh; never CTL_START */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (!fScaledNow) {
+		IOLog("HOTDOGB SCAN: scaled: step 0x%x/0x%x, init x 0x%x/0x%x y 0x%x\n", step_x, step_y, init_x0, init_x1,
+		    init_y);
+	}
+	fScaledNow = true;
+	sweet_fb_scaled = 1;
 }
 
