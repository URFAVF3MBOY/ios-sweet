+/*
+ * 0198: SSPP and QSEED3 registers (Linux sde_hw_sspp.c / sde_hw_util.c offsets; live DT: qcom,sde-qseed-type
+ * "qseedv3", qcom,sde-vig-qseed-off 0xa00, size 0xa0). Filter 3 = bilinear, alpha filter 1 = bilinear
+ * (uapi sde_drm.h FILTER_BILINEAR / FILTER_ALPHA_BILINEAR): no coefficient tables needed. Phase steps and
+ * initial phases in 21-bit fixed point (PHASE_STEP_SHIFT 21).
+ */
+#define SSPP_SRC_SIZE           0x00
+#define SSPP_SRC_IMG_SIZE       0x04
+#define SSPP_OUT_SIZE           0x0c
+#define SSPP_OUT_XY             0x10
+#define SSPP_SRC_FORMAT         0x30            /* bit 8: the format has alpha */
+#define SSPP_PE_C0_LR           0x100
+#define SSPP_PE_C0_TB           0x104
+#define SSPP_PE_C0_REQ          0x108
+#define SSPP_PE_C1C2_LR         0x110
+#define SSPP_PE_C1C2_TB         0x114
+#define SSPP_PE_C1C2_REQ        0x118
+#define SSPP_PE_C3_LR           0x120
+#define SSPP_PE_C3_TB           0x124
+#define SSPP_PE_C3_REQ          0x128
+#define QS                      0xa00
+#define QS_HW_VERSION           (QS + 0x00)
+#define QS_OP_MODE              (QS + 0x04)
+#define QS_PHASE_STEP_Y_H       (QS + 0x10)
+#define QS_PHASE_STEP_Y_V       (QS + 0x14)
+#define QS_PHASE_STEP_UV_H      (QS + 0x18)
+#define QS_PHASE_STEP_UV_V      (QS + 0x1c)
+#define QS_PRELOAD              (QS + 0x20)
+#define QS_SRC_SIZE_Y_RGB_A     (QS + 0x40)
+#define QS_SRC_SIZE_UV          (QS + 0x44)
+#define QS_DST_SIZE             (QS + 0x48)
+#define QS_PHASE_INIT_Y_H       (QS + 0x90)
+#define QS_PHASE_INIT_Y_V       (QS + 0x94)
+#define QS_PHASE_INIT_UV_H      (QS + 0x98)
+#define QS_PHASE_INIT_UV_V      (QS + 0x9c)
+
+/* what scanUnscale puts back for the splash buffer (ABL's values, read in scanSetup) */
+static const uint32_t kScanSaved[] = {
+	SSPP_SRC_SIZE, SSPP_SRC_IMG_SIZE, SSPP_OUT_SIZE, SSPP_OUT_XY,
+	SSPP_PE_C0_LR, SSPP_PE_C0_TB, SSPP_PE_C0_REQ, SSPP_PE_C1C2_LR, SSPP_PE_C1C2_TB, SSPP_PE_C1C2_REQ,
+	SSPP_PE_C3_LR, SSPP_PE_C3_TB, SSPP_PE_C3_REQ, QS_OP_MODE,
+};
+#define SCAN_SAVED      (sizeof(kScanSaved) / sizeof(kScanSaved[0]))
+
+#define SCALE_SRC_W     563u            /* columns each pipe reads: 0..562 and 562..1124 */
+#define SCALE_SRC_X1    562u
+#define SCALE_DST_W     540u            /* each pipe's half of the panel */
+#define SCALE_DST_H     2339u           /* 2436 * 1080 / 1125 = 2338.6 */
+#define SCALE_TOP       30u             /* (2400 - 2339) / 2 */
+
+/* read by SweetHID.cpp (touch): 1 while the panel shows a scaled surface (0198) */
+extern "C" { volatile int sweet_fb_scaled; }
