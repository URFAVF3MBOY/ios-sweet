+	}
+	fQseedVer = fVig0[QS_HW_VERSION / 4];
+	IOLog("HOTDOGB SCAN: ABL VIG0 src 0x%x img 0x%x out 0x%x at 0x%x req 0x%x fmt 0x%x qseed op 0x%x; "
+	    "VIG1 src 0x%x out 0x%x at 0x%x; qseed version 0x%x\n",
+	    fAbl[0][0], fAbl[0][1], fAbl[0][2], fAbl[0][3], fAbl[0][6], fVig0[SSPP_SRC_FORMAT / 4], fAbl[0][13],
+	    fAbl[1][0], fAbl[1][2], fAbl[1][3], fQseedVer);
