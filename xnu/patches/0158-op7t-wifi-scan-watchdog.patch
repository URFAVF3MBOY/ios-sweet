+/*
+ * 0158: a scan the radio never reports the end of must not block a join forever. The scan asks for
+ * events 0x001|0x002|0x004|0x008|0x100|0x010 only: a scan that ends as preempted (0x020) or failed
+ * (0x040) was never heard, `scanning` stayed true, and w_join_poll (join only when !scanning) never
+ * started the join: ASSOCIATE_RESULT 0 for ever / timeout after 30 s, no join log (2026-11-08).
+ * A join request wins over a scan after 3 s; any scan is dropped after 25 s (max scan time is 20 s).
+ */
+static void
+w_scan_watchdog(bool join_waits)
+{
+	static bool seen;
+	static unsigned began;
+
+	if (!scanning) {
+		seen = false;
+		return;
+	}
+	if (!seen) {
+		seen = true;
+		began = g_ms;
+	}
+	unsigned age = g_ms - began;
+	if ((join_waits && age > 3000) || age > 25000) {
+		JLOG("t=%u ms: scan watchdog: dropping scan %u after %u ms (%s)", g_ms, scans + 1, age,
+		    join_waits ? "a join is waiting" : "no end event");
+		scanning = false;
+		seen = false;
+		scans++;
+		next_scan_ms = 0;
+		api_scans_done++;
+	}
+}
