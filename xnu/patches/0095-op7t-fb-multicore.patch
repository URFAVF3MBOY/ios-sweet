+/*
+ * 0095: as RedwoodGPUSurfaceDrawn(), but the cache is left to the caller: the panel copy
+ * invalidates only the rows it reads, on several processors (SweetFramebuffer.cpp), instead of
+ * the whole surface here under the GPU's lock. Gives the fence to invalidate for (0: nothing to).
+ */
+uint32_t
+RedwoodGPUSurfaceReady(SweetSurface * surface, uint64_t milliseconds)
+{
+	uint32_t fence = surface->gpuDrawn;
+
+	if (fence == 0 || gGPULock == NULL) {
+		return 0;
+	}
+	IOLockLock(gGPULock);
+	if (redwood_gpu_ready()) {
+		(void)gpuWait(fence, milliseconds);
+	}
+	IOLockUnlock(gGPULock);
+	return fence;
+}
