+/*
+ * OnePlus 7T (0095): the copy to the panel on several processors, as HackiOS's
+ * MiniIOMobileFramebuffer (fb_threads, 3 by default: "a frame is in the panel's memory
+ * 3 ms after its turn instead of 9"). present() works out each layer's rectangle as
+ * before, then the panel's rows are split into bands: one per thread, the first done
+ * by present()'s own thread, the others by threads started once (sweetfb_threads=N,
+ * 1..6, default 3; 1 = the old single copy). A surface the GPU drew into (K2) is made
+ * readable band by band: each thread pushes out of the cache only the source rows it
+ * copies, instead of one thread doing the whole surface first.
+ */
+#define SWEET_FB_MAX_THREADS    6
+
+struct sweet_fb_layer_job {
+	uintptr_t dst, src;             /* first byte of the rectangle in the panel / in the surface */
+	uint32_t  dstride, sstride;     /* bytes a row */
+	uint32_t  bytes;                /* bytes copied a row */
+	int32_t   top, rows;            /* panel rows top .. top + rows - 1 */
+	bool      sync;                 /* the GPU wrote the source: invalidate before reading */
+};
+static struct {
+	uint32_t                  layers;
+	int32_t                   height;       /* the panel's rows, split into the bands */
+	struct sweet_fb_layer_job l[SWEET_FB_LAYERS];
+} sweet_fb_job;
+static IOLock   *sweet_fb_job_lock;
+static uint32_t  sweet_fb_threads = 1;  /* including present()'s own */
+static uint32_t  sweet_fb_job_gen, sweet_fb_job_done;
+
+extern "C" kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern "C" void thread_deallocate(thread_t);
+
+static void
+sweet_fb_band(uint32_t band, uint32_t bands)
+{
+	for (uint32_t i = 0; i < sweet_fb_job.layers; i++) {
+		const struct sweet_fb_layer_job *j = &sweet_fb_job.l[i];
+		/* the band is panel rows, so that a layer above another is copied after it in every row */
+		int32_t first = (int32_t)((int64_t)sweet_fb_job.height * band / bands) - j->top;
+		int32_t end = (int32_t)((int64_t)sweet_fb_job.height * (band + 1) / bands) - j->top;
+		if (first < 0) {
+			first = 0;
+		}
+		if (end > j->rows) {
+			end = j->rows;
+		}
+		for (int32_t y = first; y < end; y++) {
+			uintptr_t from = j->src + (uint64_t)y * j->sstride;
+			if (j->sync) {
+				for (uintptr_t line = from & ~(uintptr_t)63; line < from + j->bytes; line += 64) {
+					__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+				}
+				__asm__ volatile ("dsb sy" ::: "memory");
+			}
+			memcpy((void *)(j->dst + (uint64_t)y * j->dstride), (const void *)from, j->bytes);
+		}
+	}
+}
+
+static void
+sweet_fb_worker(void *arg, wait_result_t wr)
+{
+	uint32_t band = (uint32_t)(uintptr_t)arg, seen = 0;
+	(void)wr;
+	for (;;) {
+		IOLockLock(sweet_fb_job_lock);
+		while (sweet_fb_job_gen == seen) {
+			IOLockSleep(sweet_fb_job_lock, &sweet_fb_job_gen, THREAD_UNINT);
+		}
+		seen = sweet_fb_job_gen;
+		IOLockUnlock(sweet_fb_job_lock);
+		sweet_fb_band(band, sweet_fb_threads);
+		IOLockLock(sweet_fb_job_lock);
+		if (++sweet_fb_job_done == sweet_fb_threads - 1) {
+			IOLockWakeup(sweet_fb_job_lock, &sweet_fb_job_done, false);
+		}
+		IOLockUnlock(sweet_fb_job_lock);
+	}
+}
+
+static void
+sweet_fb_threads_start(void)
+{
+	uint32_t want = 3;
+	PE_parse_boot_argn("sweetfb_threads", &want, sizeof(want));
+	if (want < 1) {
+		want = 1;
+	}
+	if (want > SWEET_FB_MAX_THREADS) {
+		want = SWEET_FB_MAX_THREADS;
+	}
+	sweet_fb_job_lock = IOLockAlloc();
+	if (sweet_fb_job_lock == NULL) {
+		return;
+	}
+	uint32_t started = 1;
+	for (uint32_t i = 1; i < want; i++) {
+		thread_t t;
+		if (kernel_thread_start((thread_continue_t)sweet_fb_worker, (void *)(uintptr_t)i, &t) != KERN_SUCCESS) {
+			break;
+		}
+		thread_deallocate(t);
+		started++;
+	}
+	sweet_fb_threads = started;
+	IOLog("SWEET FB: panel copy on %u thread(s)\n", started);
+}
+
+/* every band done: by present()'s own thread and the workers */
+static void
+sweet_fb_copy(void)
+{
+	if (sweet_fb_threads <= 1 || sweet_fb_job_lock == NULL) {
+		sweet_fb_band(0, 1);
+		return;
+	}
+	IOLockLock(sweet_fb_job_lock);
+	sweet_fb_job_done = 0;
+	sweet_fb_job_gen++;
+	IOLockWakeup(sweet_fb_job_lock, &sweet_fb_job_gen, false);
+	IOLockUnlock(sweet_fb_job_lock);
+	sweet_fb_band(0, sweet_fb_threads);
+	IOLockLock(sweet_fb_job_lock);
+	while (sweet_fb_job_done < sweet_fb_threads - 1) {
+		IOLockSleep(sweet_fb_job_lock, &sweet_fb_job_done, THREAD_UNINT);
+	}
+	IOLockUnlock(sweet_fb_job_lock);
+}
