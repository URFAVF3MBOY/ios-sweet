+	{ {0x0344, 0xB6}, {0x035C, 0x40}, {0x0A90, 0x00}, {0x0A94, 0x00}, {0x0A98, 0x00}, {0x0A90, 0x48}, {0x0A94, 0x0F}, {0x0A98, 0x0A}, {0x0A8C, 0x50}, {0x0A8C, 0x5F}, {0x0368, 0x8E}, {0x036C, 0x59}, {0x0304, 0x06}, {0x030C, 0xffff}, {0x0308, 0xfffe}, {0x0314, 0x20}, {0x0350, 0x00}, {0x0388, 0x00}, {0x038C, 0x7f}, {0x0390, 0x7f}, {0x0318, 0x3e}, {0x031C, 0x41}, {0x0320, 0x41}, {0x0324, 0x7F}, {0x0328, 0x00}, {0x032C, 0x00}, {0x0344, 0x32}, {0x0360, 0x02}, {0x03CC, 0x41}, {0x0364, 0x00}, {0x03DC, 0x50}, {0x0AB0, 0x40}, {0x035C, 0x40}, {0x0AB0, 0x40}, {0x0A80, 0x00}, {0x0AB0, 0x23}, {0x035C, 0x40}, {0x0A84, 0x00}, {0x0A88, 0x04}, {0x0AAC, 0x55}, {0x03DC, 0xA0}, {0x0364, 0x2B}, {0x0800, 0x02} },
