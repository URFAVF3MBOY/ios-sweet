+/* 0160: n bytes as hex, for the logs */
+static void
+w_hex(char *out, uint32_t cap, const uint8_t *b, uint32_t n)
+{
+	static const char hx[] = "0123456789abcdef";
+	uint32_t o = 0;
+	for (uint32_t i = 0; i < n && o + 3 <= cap; i++) {
+		out[o++] = hx[b[i] >> 4];
+		out[o++] = hx[b[i] & 15];
+	}
+	out[o] = 0;
+}
