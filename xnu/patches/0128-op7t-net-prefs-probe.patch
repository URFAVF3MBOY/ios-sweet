+/*
+ * 0128 (diagnostic): after the link first comes up, read configd's two preference files from the
+ * kernel and say what is in them -- configd never brings en0 up (no SIOCSIFFLAGS, no DHCP) even after
+ * they were moved aside so it would rebuild them (net.drop, 2026-10-24). Counts a few words in each
+ * (binary plists keep ASCII strings as they are): does a Wi-Fi service for en0 exist at all?
+ */
+static char net_probe_buf[64 * 1024];
+
+static unsigned
+net_probe_count(const char *buf, int n, const char *word)
+{
+	int w = (int)strlen(word);
+	unsigned c = 0;
+
+	for (int i = 0; i + w <= n; i++) {
+		if (memcmp(buf + i, word, (size_t)w) == 0) {
+			c++;
+		}
+	}
+	return c;
+}
+
+static void
+net_prefs_probe(void)
+{
+	static const char *const files[2] = {
+		"/private/var/preferences/SystemConfiguration/preferences.plist",
+		"/private/var/preferences/SystemConfiguration/NetworkInterfaces.plist",
+	};
+	vfs_context_t ctx = vfs_context_current();
+
+	for (int f = 0; f < 2; f++) {
+		vnode_t vp = NULLVP;
+		int resid = 0, n, error;
+
+		error = vnode_open(files[f], FREAD, 0, 0, &vp, ctx);
+		if (error != 0) {
+			printf("net: probe %s: cannot open (%d)\n", files[f], error);
+			continue;
+		}
+		error = vn_rdwr(UIO_READ, vp, (caddr_t)net_probe_buf, (int)sizeof(net_probe_buf), 0, UIO_SYSSPACE, 0,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		(void)vnode_close(vp, FREAD, ctx);
+		n = error == 0 ? (int)sizeof(net_probe_buf) - resid : 0;
+		printf("net: probe %s: %d bytes (error %d); en0 %u, IEEE80211 %u, AirPort %u, Wi-Fi %u, DHCP %u, "
+		    "NetworkServices %u, ServiceOrder %u, CurrentSet %u\n", files[f], n, error,
+		    net_probe_count(net_probe_buf, n, "en0"), net_probe_count(net_probe_buf, n, "IEEE80211"),
+		    net_probe_count(net_probe_buf, n, "AirPort"), net_probe_count(net_probe_buf, n, "Wi-Fi"),
+		    net_probe_count(net_probe_buf, n, "DHCP"), net_probe_count(net_probe_buf, n, "NetworkServices"),
+		    net_probe_count(net_probe_buf, n, "ServiceOrder"), net_probe_count(net_probe_buf, n, "CurrentSet"));
+		/* the first time, the whole file (they are small) as hex, 32 bytes a line, to decode the plist */
+		static int dumped[2];
+		if (!dumped[f] && n > 0) {
+			dumped[f] = 1;
+			for (int o = 0; o < n && o < 2048; o += 32) {
+				char line[3 * 32 + 1];
+				int k = 0;
+				for (int i = o; i < n && i < o + 32; i++) {
+					static const char hx[] = "0123456789abcdef";
+					line[k++] = hx[((unsigned char)net_probe_buf[i]) >> 4];
+					line[k++] = hx[((unsigned char)net_probe_buf[i]) & 15];
+				}
+				line[k] = 0;
+				printf("net: probe %d +%04x %s\n", f, o, line);
+			}
+		}
+	}
+}
+
 /* The interface's own thread: for a link that wants to be asked, and for the minute's line in the log. */
 static void
 net_thread(__unused void *parameter, __unused wait_result_t result)
 {
 	uint64_t said = 0, total;
-	unsigned quiet = 0;
+	unsigned quiet = 0, probe_wait = 0, probes = 0;
 
 	for (unsigned tick = 1;; tick++) {
 		quiet = net_link->poll != NULL && net_link->poll() ? 0 : quiet + 1;
@@ -296,6 +366,14 @@
 			    net_count.sent, net_count.sent_bytes, net_count.received, net_count.received_bytes,
 			    net_count.dropped_out, net_count.dropped_in);
 		}
+		/* 0128: the preference files, ~5 s and ~60 s after the link first came up */
+		if (net_link_up && probes < 2) {
+			probe_wait += quiet < 100 ? 2 : 10;
+			if ((probes == 0 && probe_wait >= 5000) || (probes == 1 && probe_wait >= 60000)) {
+				probes++;
+				net_prefs_probe();
+			}
+		}
 		delay_for_interval(quiet < 100 ? 2 : 10, NSEC_PER_MSEC);
 	}
 }
