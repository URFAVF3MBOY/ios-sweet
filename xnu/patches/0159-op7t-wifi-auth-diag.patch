+/*
+ * 0159: what the radio hears while a join runs. Join 2026-11-08: VDEV_START ok, then four auth
+ * requests with no reply (ETIMEDOUT in state 2, 1.6 s), nothing logged in between.
+ */
+static unsigned d_ap_frames, d_other_frames, d_ap_mgmt_logged;
+
+static void
+w_diag_rx(const uint8_t *f, uint32_t flen)
+{
+	if (s_state == S_IDLE) {
+		return;
+	}
+	bool from_ap = memcmp(f + 10, s_bssid, 6) == 0;
+	if (from_ap) {
+		d_ap_frames++;
+	} else {
+		d_other_frames++;
+	}
+	bool beacon = (f[0] & 0x0C) == 0 && ((f[0] >> 4) == 8 || (f[0] >> 4) == 5);
+	if ((from_ap || memcmp(f + 4, our_mac, 6) == 0) && !beacon && d_ap_mgmt_logged < 40) {
+		d_ap_mgmt_logged++;
+		JLOG("t=%u ms: join: heard fc %02x%02x len %u from %02x:%02x:%02x:**:**:** to %02x:%02x:%02x:**:**:** (state %u)",
+		    g_ms, f[0], f[1], flen, f[10], f[11], f[12], f[4], f[5], f[6], s_state);
+	}
+}
