+/* clean [p, p+n) of this processor's cache out to memory (the SMMU walks memory, not the cache) */
+static void k1_clean(const void *p, uint64_t n)
+{
+	vm_offset_t s = (vm_offset_t)p;
+	for (vm_offset_t line = s & ~(vm_offset_t)63; line < s + n; line += 64)
+		__asm__ volatile("dc civac, %0" : : "r"(line) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/*
+ * One zeroed 4K L3 table from kernel memory: HackiOS space_new_table(). A kmem page is
+ * PAGE_SIZE (16K on this kernel) and physically one page, so it is cut into 4K tables, each
+ * with its own kvtophys. Never given back (as HackiOS): at most K1_NTABLES (384) = 1.5 MiB.
+ */
+static uint64_t *k1_new_table(void)
+{
+	static vm_offset_t spare;
+	static unsigned spare_left;
+	if (spare_left == 0) {
+		if (kmem_alloc(kernel_map, &spare, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS)
+			return NULL;
+		spare_left = PAGE_SIZE / 4096;
+	}
+	return (uint64_t *)(spare + PAGE_SIZE - 4096 * spare_left--);
+}
+
 /* one 4K page; a fresh 2 MiB table is zeroed and hung in the L2 before use (no TLB issue: never valid before) */
 int sweet_gpu_map(uint64_t va, uint64_t pa, int read_only)
 {
 	if (va < K1_VA_BASE || va >= K1_VA_BASE + K1_VA_SIZE || (va & 0xfffULL) || (pa & 0xfffULL))
 		return 0;
 	uint32_t t = (uint32_t)((va - K1_VA_BASE) >> 21);
-	uintptr_t l3 = K1_POOL_PA + (uintptr_t)t * 0x1000;
-	if (!(k1_l3_live & (1U << t))) {
-		volatile uint64_t *tab = (volatile uint64_t *)k1p(l3);
-		for (unsigned i = 0; i < 512; i++)
-			tab[i] = 0;
+	uint64_t *tab = k1_l3[t];
+	if (tab == NULL) {
+		tab = k1_new_table();
+		if (tab == NULL)
+			return 0;
+		uint64_t tpa = kvtophys((vm_offset_t)tab);
+		if (tpa == 0 || (tpa & 0xfffULL))
+			return 0;
+		k1_clean(tab, 4096);			/* its zeroes in memory before the L2 points at it */
+		*sp64(GPU_PT_PA + 0x1000 + (uintptr_t)((va >> 21) & 0x1ffU) * 8) = tpa | PTE_TABLE;
 		__asm__ volatile("dsb sy" ::: "memory");
-		*sp64(GPU_PT_PA + 0x1000 + (uintptr_t)((va >> 21) & 0x1ffU) * 8) = (uint64_t)l3 | PTE_TABLE;
-		k1_l3_live |= 1U << t;
+		k1_l3[t] = tab;
+		k1_l3_made++;
 	}
-	((volatile uint64_t *)k1p(l3))[(va >> 12) & 0x1ffU] =
-	    pa | PTE_PAGE | PTE_ATTR | (read_only ? K1_PTE_RO : 0);
+	tab[(va >> 12) & 0x1ffU] = pa | PTE_PAGE | PTE_ATTR | (read_only ? K1_PTE_RO : 0);
+	k1_clean(&tab[(va >> 12) & 0x1ffU], 8);
 	return 1;
 }
 
@@ -544,8 +583,12 @@ int sweet_gpu_unmap(uint64_t va, uint64_t size)
 		if (v < K1_VA_BASE || v >= K1_VA_BASE + K1_VA_SIZE)
 			continue;
 		uint32_t t = (uint32_t)((v - K1_VA_BASE) >> 21);
-		if (k1_l3_live & (1U << t))
-			((volatile uint64_t *)k1p(K1_POOL_PA + (uintptr_t)t * 0x1000))[(v >> 12) & 0x1ffU] = 0;
+		if (k1_l3[t] != NULL) {
+			uint64_t *e = &k1_l3[t][(v >> 12) & 0x1ffU];
