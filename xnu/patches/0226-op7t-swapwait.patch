  */
+void
+AppleCLCD::swapShown(uint32_t id)
+{
+	IOLockLock(fLock);
+	fShownSwap = id;
+	IOLockWakeup(fLock, &fShownSwap, false);
+	IOLockUnlock(fLock);
+}
+
+/* 0226: sel 6. kIOReturnSuccess once swap `id` is on the panel, the display is off, or after 50 ms. */
+void
+AppleCLCD::swapWait(uint32_t id)
+{
+	if (fSwapWait == 0) {
+		return;
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(50, kMillisecondScale, &deadline);
+	IOLockLock(fLock);
+	fSwapWaits++;
+	while ((int32_t)(fShownSwap - id) < 0 && !fPowerOff && (int32_t)(fSwapID - id) >= 0) {
+		if (IOLockSleepDeadline(fLock, &fShownSwap, deadline, THREAD_UNINT) == THREAD_TIMED_OUT) {
+			if (fSwapWaitTimeouts++ < 8) {
+				IOLog("HOTDOGB FB: SwapWait(%u) timed out, %u shown\n", id, fShownSwap);
+			}
+			break;
+		}
+	}
+	IOLockUnlock(fLock);
+	if ((fSwapWaits % 5000) == 0) {
+		IOLog("HOTDOGB FB: %u SwapWaits, %u timed out\n", fSwapWaits, fSwapWaitTimeouts);
+	}
+}
