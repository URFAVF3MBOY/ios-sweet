+/* ---- clock and pins ---- */
+
+static bool
+clock_up(void)
+{
+	uint32_t cfg;
+
+	wr(gcc, GCC_VOTE_WRAP2, rd(gcc, GCC_VOTE_WRAP2) | GCC_S3_BIT);
+	if (!wait_bits(gcc, GCC_S3_CBCR, 1u << 31, false, 10000)) {
+		printf("sweet_bt: s3 branch did not start: %#x\n", rd(gcc, GCC_S3_CBCR));
+		return false;
+	}
+	/* clk-rcg2: M, N = ~(n - m), D = ~n (16-bit), CFG src << 8, pre-div 2 * 1 - 1, mode dual edge, then UPDATE */
+	wr(gcc, GCC_S3_RCG + 8, 384);
+	wr(gcc, GCC_S3_RCG + 0xc, ~(15625u - 384u) & 0xffffu);
+	wr(gcc, GCC_S3_RCG + 0x10, ~15625u & 0xffffu);
+	cfg = rd(gcc, GCC_S3_RCG + 4);
+	cfg &= ~(0x1fu | (7u << 8) | (3u << 12));
+	cfg |= 1u | (6u << 8) | (2u << 12);
+	wr(gcc, GCC_S3_RCG + 4, cfg);
+	wr(gcc, GCC_S3_RCG, rd(gcc, GCC_S3_RCG) | 1u);
+	if (!wait_bits(gcc, GCC_S3_RCG, 1u, false, 10000)) {
+		printf("sweet_bt: s3 rcg update did not finish: cmd %#x\n", rd(gcc, GCC_S3_RCG));
+		return false;
+	}
+	printf("sweet_bt: s3 rcg now cmd %#x cfg %#x m %#x n %#x d %#x (want 7.3728 MHz), branch %#x\n", rd(gcc, GCC_S3_RCG),
+	    rd(gcc, GCC_S3_RCG + 4), rd(gcc, GCC_S3_RCG + 8), rd(gcc, GCC_S3_RCG + 0xc), rd(gcc, GCC_S3_RCG + 0x10),
+	    rd(gcc, GCC_S3_CBCR));
+	return true;
+}
