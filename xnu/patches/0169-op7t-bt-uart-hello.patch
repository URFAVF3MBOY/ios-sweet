+static inline void
+wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(base + off) = v;
+}
+
+/* Wait (polling every 10 us) until (reg & mask) is set or clear; false on timeout. */
+static bool
+wait_bits(vm_offset_t base, uint32_t off, uint32_t mask, bool set, unsigned timeout_us)
+{
+	for (unsigned t = 0; t <= timeout_us; t += 10) {
+		if (((rd(base, off) & mask) != 0) == set) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
