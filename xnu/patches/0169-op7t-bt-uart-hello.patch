+/* baud and flow control (Linux set_termios); RX is stopped across it */
+static void
+termios(unsigned baud, bool flow)
+{
+	uint32_t div = SE_CLK_HZ / (baud * oversampling);
+	bool rx = (rd(se, SE_GENI_STATUS) & S_GENI_CMD_ACTIVE) != 0;
+
+	rx_stop();
+	wr(se, SE_UART_LOOPBACK_CFG, 0);
+	wr(se, SE_UART_TX_TRANS_CFG, flow ? 0 : UART_CTS_MASK);
+	wr(se, SE_UART_TX_PARITY_CFG, 0);
+	wr(se, SE_UART_RX_TRANS_CFG, 0);
+	wr(se, SE_UART_RX_PARITY_CFG, 0);
+	wr(se, SE_UART_TX_WORD_LEN, 8);
+	wr(se, SE_UART_RX_WORD_LEN, 8);
+	wr(se, SE_UART_TX_STOP_BIT_LEN, 0);
+	wr(se, GENI_SER_M_CLK_CFG, 1u | (div << 4));
+	wr(se, GENI_SER_S_CLK_CFG, 1u | (div << 4));
+	/* RFR (our RTS): the SE drives it from the RX FIFO when flow control is on; held "not ready" otherwise */
+	wr(se, SE_UART_MANUAL_RFR, flow ? 0 : ((1u << 31) | (1u << 1)));
+	printf("sweet_bt: uart %u baud (div %u, %ux), flow control %s\n", baud, div, oversampling, flow ? "on" : "off");
+	if (rx) {
+		rx_start();
+	}
