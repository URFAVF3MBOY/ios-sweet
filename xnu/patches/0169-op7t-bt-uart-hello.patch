+	oversampling = ver >= QUP_SE_VERSION_2_5 ? UART_OVERSAMPLING / 2 : UART_OVERSAMPLING;
+	tx_depth = (rd(se, SE_HW_PARAM_0) >> 16) & 0x3f;
+	rx_depth = (rd(se, SE_HW_PARAM_1) >> 16) & 0x3f;
+	printf("sweet_bt: QUP version %#x (oversampling %u), fifo depth tx %u rx %u words\n", ver, oversampling, tx_depth, rx_depth);
+
+	rx_stop();
+	wr(se, SE_UART_RX_STALE_CNT, 10 * 16);
+	/* geni_se_config_packing(8 bits, 4 a word, lsb first) for TX and RX */
+	wr(se, SE_GENI_TX_PACKING_CFG0, 0x0004380eu);
+	wr(se, SE_GENI_TX_PACKING_CFG1, 0x000c3e0eu);
+	wr(se, SE_GENI_RX_PACKING_CFG0, 0x0004380eu);
+	wr(se, SE_GENI_RX_PACKING_CFG1, 0x000c3e0eu);
+	wr(se, SE_GENI_BYTE_GRAN, 0);
+	/* geni_se_init: interrupts cleared (none used), clocks gated on, outputs on, defaults */
+	wr(se, SE_GSI_EVENT_EN, 0);
+	wr(se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	wr(se, SE_GENI_S_IRQ_CLEAR, 0xffffffffu);
+	wr(se, GENI_CGC_CTRL, rd(se, GENI_CGC_CTRL) | 0x7fu);
+	wr(se, GENI_OUTPUT_CTRL, 0x7fu);
+	wr(se, GENI_FORCE_DEFAULT_REG, 1);
+	wr(se, SE_IRQ_EN, 0);
+	wr(se, SE_GENI_DMA_MODE_EN, 0);
+	wr(se, SE_GENI_M_IRQ_EN, 0);
+	wr(se, SE_GENI_S_IRQ_EN, 0);
+	wr(se, SE_GENI_RX_WATERMARK_REG, 2);
+	wr(se, SE_GENI_RX_RFR_WATERMARK_REG, rx_depth > 2 ? rx_depth - 2 : 1);
+	wr(se, SE_GENI_TX_WATERMARK_REG, 0);
+	return true;
