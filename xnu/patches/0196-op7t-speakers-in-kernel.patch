+extern int sweet_adsp_start(void);
+extern int sweet_adsp_stage(void);
+extern int sweet_adsp_apr_send(const void *p, size_t n);
+extern int sweet_adsp_apr_recv(void *dst, size_t cap, size_t *got);
+/* sweet_smmu.c (0194/0195, exported by this patch) */
+extern int sweet_audio_buffer(uint64_t *pa, vm_offset_t *va, uint32_t *size);
+extern uint32_t sweet_audio_ring_take(uint32_t *frames, uint32_t max);
