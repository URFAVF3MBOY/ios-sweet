+static const struct tfa_write tfa_speaker_35[] = {
+	{ 0x64, 14, 2, 0x2 },
+	{ 0x23, 1, 1, 0x1 },
+	{ 0x00, 4, 1, 0x1 },
+	{ 0x61, 6, 4, 0x4 },
+	{ 0x02, 4, 1, 0x0 },
+	{ 0x62, 14, 2, 0x0 },
+};
+/* 32768 * 10^(-dB/20), dB = 0..30 */
+static const uint16_t sound_gain_q15[31] = {32767, 29205, 26029, 23198, 20675, 18427, 16423, 14637, 13045, 11627, 10362, 9235, 8231, 7336, 6538, 5827, 5193, 4629, 4125, 3677, 3277, 2920, 2603, 2320, 2068, 1843, 1642, 1464, 1305, 1163, 1036};
+
+static int
+tfa_rd(uint8_t addr, uint8_t reg, uint16_t *v)
+{
+	uint8_t b[2];
+	int e = i2c_msg(addr, &reg, 1, NULL, 0, true);
+
+	if (e == 0) {
+		e = i2c_msg(addr, NULL, 0, b, 2, false);
+	}
+	if (e == 0) {
+		*v = (uint16_t)(b[0] << 8 | b[1]);      /* 16-bit registers, big endian */
+	}
+	return e;
+}
+
+static int
+tfa_wr(uint8_t addr, uint8_t reg, uint16_t v)
+{
+	uint8_t b[3] = { reg, (uint8_t)(v >> 8), (uint8_t)v };
+
+	return i2c_msg(addr, b, 3, NULL, 0, false);
+}
+
+static int
+tfa_bf(uint8_t addr, uint8_t reg, unsigned pos, unsigned len, uint16_t val)
+{
+	uint16_t old, mask = (uint16_t)(((1u << len) - 1) << pos);
+	int e = tfa_rd(addr, reg, &old);
+
+	if (e == 0) {
+		e = tfa_wr(addr, reg, (uint16_t)((old & ~mask) | ((val << pos) & mask)));
+	}
+	return e;
+}
+
+static int
+tfa_apply(uint8_t addr, const struct tfa_write *w, unsigned n)
+{
+	for (unsigned i = 0; i < n; i++) {
+		int e = w[i].len == 16 ? tfa_wr(addr, w[i].reg, w[i].val) : tfa_bf(addr, w[i].reg, w[i].pos, w[i].len, w[i].val);
+		if (e != 0) {
+			return e;
+		}
+	}
+	return 0;
+}
+
+static const uint8_t tfa_addr[2] = { 0x34, 0x35 };
+
+static bool
+tfa_init(void)
+{
+	static const struct { uint8_t reg; uint16_t val; } c74[] = {
+		{ 0x02, 0x22c8 }, { 0x52, 0x57dc }, { 0x53, 0x003e }, { 0x56, 0x0400 }, { 0x61, 0x0110 }, { 0x6f, 0x00a5 },
+		{ 0x70, 0x07f8 }, { 0x73, 0x0047 }, { 0x74, 0x5098 }, { 0x75, 0x8d28 }, { 0x80, 0x0000 }, { 0x83, 0x0799 },
+		{ 0x84, 0x0081 },
+	};
+	bool any = false;
+
+	for (int a = 0; a < 2; a++) {
+		uint8_t addr = tfa_addr[a];
+		uint16_t rev = 0, fb = 0;
+		int e = tfa_rd(addr, 0x03, &rev);
+
+		if (e != 0 || rev != 0x0c74) {
+			LOG("TFA %#x: revision %#x (error %d): not the 0x0c74 these settings are for, left alone", addr, rev, e);
+			continue;
+		}
+		e = tfa_wr(addr, 0x00, 1u << 1);                /* I2CR */
+		sleep_ms(10);
+		e = e ?: tfa_wr(addr, 0x0f, 0x5a6b);            /* keys */
+		e = e ?: tfa_rd(addr, 0xfb, &fb);
+		e = e ?: tfa_wr(addr, 0xa0, fb ^ 0x005a);
+		e = e ?: tfa_wr(addr, 0xa1, 0x005a);
+		e = e ?: tfa_wr(addr, 0x0f, 0);
+		for (unsigned i = 0; e == 0 && i < sizeof(c74) / sizeof(c74[0]); i++) {
+			e = tfa_wr(addr, c74[i].reg, c74[i].val);
+		}
+		if (e == 0) {
+			e = a == 0 ? tfa_apply(addr, tfa_dev_34, sizeof(tfa_dev_34) / sizeof(tfa_dev_34[0])) :
+			    tfa_apply(addr, tfa_dev_35, sizeof(tfa_dev_35) / sizeof(tfa_dev_35[0]));
+		}
+		if (e == 0) {
+			e = a == 0 ? tfa_apply(addr, tfa_speaker_34, sizeof(tfa_speaker_34) / sizeof(tfa_speaker_34[0])) :
+			    tfa_apply(addr, tfa_speaker_35, sizeof(tfa_speaker_35) / sizeof(tfa_speaker_35[0]));
+		}
+		e = e ?: tfa_bf(addr, 0x00, 3, 1, 0);           /* AMPE 0: muted */
+		LOG("TFA %#x: %s", addr, e == 0 ? "set up (rev 0x0c74 settings, container device + speaker), muted" : "FAILED");
+		any |= e == 0;
+	}
+	return any;
+}
+
+static void
+tfa_up(void)
+{
+	for (int a = 0; a < 2; a++) {
+		uint16_t r11 = 0, r14 = 0;
+
+		(void)tfa_bf(tfa_addr[a], 0x01, 2, 1, 1);       /* MANSCONF */
+		(void)tfa_bf(tfa_addr[a], 0x00, 0, 1, 0);       /* PWDN 0 */
+		for (int i = 0; i < 50; i++) {
+			if (tfa_rd(tfa_addr[a], 0x11, &r11) == 0 && (r11 & (1u << 7))) {
+				break;
+			}
+			sleep_ms(10);
+		}
+		(void)tfa_bf(tfa_addr[a], 0x00, 3, 1, 0);       /* (the chip sets AMPE itself in operating) */
+		(void)tfa_rd(tfa_addr[a], 0x14, &r14);
+		LOG("TFA %#x: CLKS %u PLLS %u, state %u", tfa_addr[a], (r11 >> 7) & 1u, (r11 >> 6) & 1u, (r14 >> 3) & 0xfu);
+	}
+}
+
+static void
+tfa_mute(bool on)
+{
+	for (int a = 0; a < 2; a++) {
+		(void)tfa_bf(tfa_addr[a], 0x00, 3, 1, on ? 0 : 1);
+	}
+}
+
+/* ---- APR to the DSP ---- */
+
+#define APR_SVC_AFE     4
+#define APR_SVC_ASM     7
+#define APR_SVC_ADM     8
+#define APR_BASIC_RSP   0x000110e8u
+#define AFE_PORT_CMD_DEVICE_START       0x000100e5u
+#define AFE_PORT_CMD_SET_PARAM_V2       0x000100efu
+#define AFE_SVC_CMD_SET_PARAM           0x000100f3u
+#define AFE_MODULE_AUDIO_DEV_INTERFACE  0x0001020cu
+#define AFE_PARAM_ID_I2S_CONFIG         0x0001020du
+#define AFE_MODULE_CLOCK_SET            0x0001028fu
+#define AFE_PARAM_ID_CLOCK_SET          0x00010290u
+#define ADM_CMD_DEVICE_OPEN_V5          0x00010326u
+#define ADM_CMDRSP_DEVICE_OPEN_V5       0x00010329u
+#define ADM_CMD_MATRIX_MAP_ROUTINGS_V5  0x00010325u
+#define ADM_TOPOLOGY_NONE               0x00010312u
+#define ASM_CMD_SHARED_MEM_MAP_REGIONS  0x00010d92u
+#define ASM_CMDRSP_SHARED_MEM_MAP_REGIONS 0x00010d93u
+#define ASM_STREAM_CMD_OPEN_WRITE_V3    0x00010db3u
+#define ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2 0x00010d98u
+#define ASM_SESSION_CMD_RUN_V2          0x00010daau
+#define ASM_DATA_CMD_WRITE_V2           0x00010dabu
+#define ASM_DATA_EVENT_WRITE_DONE_V2    0x00010d99u
+#define ASM_TOPOLOGY_NONE               0x00010c68u
+#define ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2 0x00010da5u
+#define QUAT_MI2S_RX    0x1006u
+#define CLOCK_QUAD_MI2S_IBIT 0x106u
+#define RATE            48000u
+#define STREAM_PORT     (1u << 8 | 1u)
+#define WRITE_TOKEN     0x80000000u
+#define PERIOD_FRAMES   960u
+#define PERIOD_BYTES    (PERIOD_FRAMES * 4u)
+#define PERIODS         8u
+
+struct apr_hdr {
+	uint16_t field, size;
+	uint8_t src_svc, src_domain;
+	uint16_t src_port;
+	uint8_t dst_svc, dst_domain;
+	uint16_t dst_port;
+	uint32_t token, opcode;
+} __attribute__((packed));
+
+static uint8_t apr_in[4096];
+static size_t apr_in_len, apr_in_at;
+static uint32_t apr_token = 0x200;
+
+static int
+apr_send(uint8_t svc, uint16_t port, uint32_t token, uint32_t opcode, const void *payload, uint32_t len)
+{
+	uint8_t pkt[sizeof(struct apr_hdr) + 128];
+	struct apr_hdr *h = (struct apr_hdr *)pkt;
+
+	if (len > sizeof(pkt) - sizeof(*h)) {
+		return EINVAL;
+	}
+	*h = (struct apr_hdr){ .field = (uint16_t)(2u << 8 | (sizeof(*h) / 4) << 4), .size = (uint16_t)(sizeof(*h) + len),
+		.src_svc = svc, .src_domain = 5, .src_port = port, .dst_svc = svc, .dst_domain = 4, .dst_port = port,
+		.token = token, .opcode = opcode };
+	memcpy(pkt + sizeof(*h), payload, len);
+	return sweet_adsp_apr_send(pkt, sizeof(*h) + len);
+}
+
+/* the next packet from the DSP (opcode, token, payload words); false when none is waiting */
+static bool
+apr_next(uint32_t *opcode, uint32_t *token, const uint32_t **words, uint32_t *nwords)
+{
+	if (apr_in_at >= apr_in_len) {
+		apr_in_len = apr_in_at = 0;
+		if (sweet_adsp_apr_recv(apr_in, sizeof(apr_in), &apr_in_len) != 0 || apr_in_len == 0) {
+			return false;
+		}
+	}
+	uint32_t n;
+	if (apr_in_at + 4 > apr_in_len) {
+		apr_in_len = apr_in_at = 0;
+		return false;
+	}
+	memcpy(&n, apr_in + apr_in_at, 4);
+	if (apr_in_at + 4 + n > apr_in_len) {
+		apr_in_len = apr_in_at = 0;
+		return false;
+	}
+	const uint8_t *p = apr_in + apr_in_at + 4;
+	apr_in_at += 4 + n;
+	if (n < sizeof(struct apr_hdr)) {
+		*opcode = 0;
+		*nwords = 0;
+		return true;
+	}
+	const struct apr_hdr *h = (const struct apr_hdr *)p;
+	uint32_t hl = ((h->field >> 4) & 0xfu) * 4;
+	hl = hl < sizeof(*h) ? sizeof(*h) : hl;
+	*opcode = h->opcode;
+	*token = h->token;
+	*words = (const uint32_t *)(const void *)(p + hl);
+	*nwords = n > hl ? (n - hl) / 4 : 0;
+	return true;
+}
+
+/* a command and its answer within 1 s: the basic response's status (0 ok), or `rsp' (its first words in out) */
+static int
+apr_call(const char *what, uint8_t svc, uint16_t port, uint32_t opcode, const void *payload, uint32_t len, uint32_t rsp,
+    uint32_t *out, uint32_t nout)
+{
+	uint32_t tok = ++apr_token;
+
+	if (apr_send(svc, port, tok, opcode, payload, len) != 0) {
+		LOG("%s: could not be sent", what);
+		return EIO;
+	}
+	for (int i = 0; i < 200; i++) {
+		uint32_t op, token, nw;
+		const uint32_t *w;
+
+		while (apr_next(&op, &token, &w, &nw)) {
+			if (rsp != 0 && op == rsp) {
+				for (uint32_t k = 0; k < nout && k < nw; k++) {
+					out[k] = w[k];
+				}
+				return 0;
+			}
+			if (op == APR_BASIC_RSP && nw >= 2 && w[0] == opcode) {
+				if (w[1] != 0) {
+					LOG("%s: refused, status %#x", what, w[1]);
+				}
+				return w[1] == 0 ? 0 : EIO;
+			}
+		}
+		sleep_ms(5);
+	}
+	LOG("%s: no answer", what);
+	return ETIMEDOUT;
+}
+
+static int
+afe_param(const char *what, bool service, uint32_t module, uint32_t param, const void *data, uint16_t len)
+{
+	uint8_t body[16 + 12 + 32];
+	uint32_t at = service ? 16 : 16;
+
+	struct { uint32_t module, param; uint16_t size, reserved; } __attribute__((packed)) ph = { module, param, len, 0 };
+	if (service) {
+		uint32_t h[4] = { (uint32_t)sizeof(ph) + len, 0, 0, 0 };
+		memcpy(body, h, 16);
+	} else {
+		struct { uint16_t port, size; uint32_t a, b, c; } __attribute__((packed)) h = { QUAT_MI2S_RX,
+			(uint16_t)(sizeof(ph) + len), 0, 0, 0 };
+		memcpy(body, &h, 16);
+	}
+	memcpy(body + at, &ph, sizeof(ph));
+	memcpy(body + at + sizeof(ph), data, len);
+	return apr_call(what, APR_SVC_AFE, 0, service ? AFE_SVC_CMD_SET_PARAM : AFE_PORT_CMD_SET_PARAM_V2, body,
+	           at + (uint32_t)sizeof(ph) + len, 0, NULL, 0);
+}
+
+static bool
+port_start(void)
+{
+	struct { uint32_t version, clk_id, freq; uint16_t attri, root; uint32_t enable; } __attribute__((packed)) clk =
+	{ 1, CLOCK_QUAD_MI2S_IBIT, RATE * 32 * 2, 1, 0, 1 };
+	struct { uint32_t version; uint16_t bits, lines, stereo, ws; uint32_t rate; uint16_t a, b; } __attribute__((packed)) i2s =
+	{ 1, 32, 2, 1, 1, RATE, 0, 0 };
+	uint16_t start[2] = { QUAT_MI2S_RX, 0 };
+
+	return afe_param("bit clock 3.072 MHz", true, AFE_MODULE_CLOCK_SET, AFE_PARAM_ID_CLOCK_SET, &clk, sizeof(clk)) == 0 &&
+	       afe_param("port 0x1006 I2S SD1 32-bit", false, AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_I2S_CONFIG, &i2s,
+	       sizeof(i2s)) == 0 &&
+	       apr_call("port 0x1006 started", APR_SVC_AFE, 0, AFE_PORT_CMD_DEVICE_START, start, sizeof(start), 0, NULL, 0) == 0;
+}
+
+/* ---- the stream and its feeder ---- */
+
+static uint64_t buf_dsp;
+static vm_offset_t buf_va;
+static uint32_t map_handle;
+
+static bool
+stream_open(void)
+{
+	uint64_t pa;
+	uint32_t size, w[2] = { 0, 0 };
+
+	if (sweet_audio_buffer(&pa, &buf_va, &size) != 0 || size < PERIODS * 4096u) {
+		LOG("no DSP buffer (0194)");
+		return false;
+	}
+	buf_dsp = pa | (1ull << 32);                    /* the audio stream's SID bit (0194's alias) */
+	struct { uint16_t pool, regions; uint32_t prop, lo, hi, size; } __attribute__((packed)) map =
+	{ 3, 1, 0, (uint32_t)buf_dsp, (uint32_t)(buf_dsp >> 32), PERIODS * 4096u };
+	if (apr_call("buffer mapped", APR_SVC_ASM, 0, ASM_CMD_SHARED_MEM_MAP_REGIONS, &map, sizeof(map),
+	    ASM_CMDRSP_SHARED_MEM_MAP_REGIONS, w, 1) != 0) {
+		return false;
+	}
+	map_handle = w[0];
+	struct { uint16_t flags, mode, ep1, ep2; uint32_t topology; uint16_t channels, bits; uint32_t rate; uint8_t map[8]; }
+	__attribute__((packed)) adm = { 0, 1, QUAT_MI2S_RX, 0xffff, ADM_TOPOLOGY_NONE, 2, 16, RATE, { 1, 2 } };
+	if (apr_call("ADM path to 0x1006", APR_SVC_ADM, QUAT_MI2S_RX, ADM_CMD_DEVICE_OPEN_V5, &adm, sizeof(adm),
+	    ADM_CMDRSP_DEVICE_OPEN_V5, w, 2) != 0 || w[0] != 0) {
+		LOG("ADM path refused (%#x)", w[0]);
+		return false;
+	}
+	uint16_t copp = (uint16_t)w[1];
+	struct { uint32_t flags; uint16_t sink, bits; uint32_t topology, format; } __attribute__((packed)) open =
+	{ 0, 0, 16, ASM_TOPOLOGY_NONE, ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2 };
+	struct { uint32_t matrix, sessions; uint16_t session, copps, copp0, copp1; } __attribute__((packed)) route =
+	{ 0, 1, 1, 1, copp, 0 };
+	struct { uint32_t size; uint16_t channels, bits; uint32_t rate; uint16_t sign, res; uint8_t map[8]; }
+	__attribute__((packed)) fmt = { 20, 2, 16, RATE, 1, 0, { 1, 2 } };
+	uint32_t run[3] = { 0, 0, 0 };
+	return apr_call("ASM stream open", APR_SVC_ASM, STREAM_PORT, ASM_STREAM_CMD_OPEN_WRITE_V3, &open, sizeof(open), 0,
+	           NULL, 0) == 0 &&
+	       apr_call("session routed", APR_SVC_ADM, 0, ADM_CMD_MATRIX_MAP_ROUTINGS_V5, &route, sizeof(route), 0, NULL, 0) == 0 &&
+	       apr_call("stream format", APR_SVC_ASM, STREAM_PORT, ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2, &fmt, sizeof(fmt), 0, NULL,
+	       0) == 0 &&
+	       apr_call("session run", APR_SVC_ASM, STREAM_PORT, ASM_SESSION_CMD_RUN_V2, run, sizeof(run), 0, NULL, 0) == 0;
+}
+
+static uint32_t gain_q15 = 8231, gain_db = 12;  /* -12 dB */
+static bool amp_on;
+static uint32_t quiet_periods;
+
+/* one period from the ring (silence where iOS wrote nothing), scaled and clipped, into period k of the buffer */
+static void
+period_fill(uint32_t k)
+{
+	static uint32_t frames[PERIOD_FRAMES];
+	uint32_t got = sweet_audio_ring_take(frames, PERIOD_FRAMES), peak = 0;
+	volatile uint32_t *dst = (volatile uint32_t *)(buf_va + 4096u * k);
+
+	if (got < PERIOD_FRAMES) {
+		sound_short++;
+	}
+	for (uint32_t i = 0; i < PERIOD_FRAMES; i++) {
+		uint32_t f = i < got ? frames[i] : 0, out = 0;
+
+		for (int c = 0; c < 2; c++) {
+			int32_t s = (int16_t)(f >> (16 * c)), v = (s * (int32_t)gain_q15) >> 15;
+			uint32_t m = (uint32_t)(v < 0 ? -v : v);
+
+			if (v > 32767 || v < -32768) {
+				sound_clipped++;
+				v = v > 0 ? 32767 : -32768;
+			}
+			peak = m > peak ? m : peak;
+			out |= ((uint32_t)(uint16_t)v) << (16 * c);
+		}
+		dst[i] = out;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	if (peak > 8) {
+		quiet_periods = 0;
+		if (!amp_on) {
+			tfa_mute(false);
+			amp_on = true;
+			sound_amp_on++;
+		}
+	} else if (amp_on && ++quiet_periods >= 150) {          /* 3 s of silence */
+		tfa_mute(true);
+		amp_on = false;
+	}
+}
+
+static void
+period_post(uint32_t k)
+{
+	uint64_t a = buf_dsp + 4096u * k;
+	uint32_t w[8] = { (uint32_t)a, (uint32_t)(a >> 32), map_handle, PERIOD_BYTES, k, 0, 0, 0 };
+
+	(void)apr_send(APR_SVC_ASM, STREAM_PORT, WRITE_TOKEN | k, ASM_DATA_CMD_WRITE_V2, w, sizeof(w));
+}
+
+static void
+feed(void)
+{
+	for (uint32_t k = 0; k < PERIODS; k++) {
+		period_fill(k);
+		period_post(k);
+	}
+	sound_stage = ST_PLAYING;
+	LOG("playing: iOS's sound from /dev/redwood-audio, %u dB below full, amplifiers on while there is sound", gain_db);
+	for (;;) {
+		uint32_t op, token, nw;
+		const uint32_t *w;
+		bool any = false;
+
+		while (apr_next(&op, &token, &w, &nw)) {
+			if (op == ASM_DATA_EVENT_WRITE_DONE_V2 && (token & WRITE_TOKEN)) {
+				uint32_t k = token & 31u;
+				if (k < PERIODS) {
+					period_fill(k);
+					period_post(k);
+					sound_periods++;
+				}
+				any = true;
+			}
+		}
+		if (!any) {
+			sleep_ms(2);
+		}
+	}
+}
+
+static void
+sound_thread(__unused void *arg, __unused wait_result_t wr_)
+{
+	uint32_t delay_s = 15;
+
+	(void)PE_parse_boot_argn("sweetsounddelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("sweetsoundgain", &gain_db, sizeof(gain_db));
+	gain_q15 = sound_gain_q15[gain_db > 30 ? 30 : gain_db];
+	sound_stage = ST_WAIT;
+	sleep_ms(delay_s * 1000);
+
+	sound_stage = ST_DSP;
+	int e = sweet_adsp_start();
+	for (int i = 0; i < 600 && sweet_adsp_stage() >= 0 && sweet_adsp_stage() < 6; i++) {
+		sleep_ms(100);
+	}
+	if (sweet_adsp_stage() < 6) {
+		LOG("the audio DSP did not come up (start %d, stage %d): no sound", e, sweet_adsp_stage());
+		goto failed;
+	}
+	sleep_ms(500);
+	gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	se4 = ml_io_map(SE4_PA, 0x4000);
+	sound_stage = ST_I2C;
+	if (gcc == 0 || se4 == 0 || !i2c_init()) {
+		LOG("the amplifiers' I2C could not be set up");
+		goto failed;
+	}
+	sound_stage = ST_AMPS;
+	if (!tfa_init()) {
+		goto failed;
+	}
+	sound_stage = ST_PORT;
+	pin(137, 1, 8);
+	pin(138, 1, 8);
+	pin(140, 1, 8);
+	if (!port_start()) {
+		goto failed;
+	}
+	tfa_up();
+	sound_stage = ST_STREAM;
+	if (!stream_open()) {
+		goto failed;
+	}
+	feed();                                         /* (does not return) */
+failed:
+	sound_failed_at = sound_stage;
+	sound_stage = -sound_stage;
+	LOG("stopped at stage %d", sound_failed_at);
+}
+
+void
+sweet_sound_init(void)
+{
+	int on = 1;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("sweetsound", &on, sizeof(on));
+	if (!on) {
+		LOG("off (sweetsound=0)");
+		return;
+	}
+	if (sweet_audio_dev_make() != 0) {
+		LOG("/dev/redwood-audio could not be made");
+	}
+	if (kernel_thread_start(sound_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+static int
+sysctl_sweetsound SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char text[200];
+	int len = snprintf(text, sizeof(text), "stage %d periods %llu short %llu clipped %llu amp-on %llu amp %s",
+	    sound_stage, sound_periods, sound_short, sound_clipped, sound_amp_on, amp_on ? "on" : "off");
+
+	return SYSCTL_OUT(req, text, (size_t)len + 1);
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweetsound, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, sysctl_sweetsound, "A",
+    "the speakers from boot (0196): stage (7 playing; negative: stopped there) and counters");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
