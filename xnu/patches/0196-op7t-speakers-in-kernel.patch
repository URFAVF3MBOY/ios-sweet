+/* 0196: also called at boot by sweet_sound.c, before the audio server starts */
+int
+sweet_audio_dev_make(void)
+{
+	if (rw_major >= 0) {
+		return 0;
+	}
 	rw_major = cdevsw_add(-1, &rw_audio_cdevsw);
 	if (rw_major < 0 || devfs_make_node(makedev(rw_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-audio") == NULL) {
 		printf("HOTDOGB AUDIO: /dev/redwood-audio could not be made (major %d)\n", rw_major);
+		rw_major = -1;
 		return EIO;
 	}
-	printf("HOTDOGB AUDIO: /dev/redwood-audio made (major %d): restart the audio server so its plug-in opens it\n",
-		rw_major);
+	printf("HOTDOGB AUDIO: /dev/redwood-audio made (major %d)\n", rw_major);
 	return 0;
 }
 
+/* 0196: frames from the ring for sweet_sound.c's feeder; returns how many (0 when iOS wrote nothing) */
+uint32_t
+sweet_audio_ring_take(uint32_t *frames, uint32_t max)
+{
+	uint32_t got;
+
+	lck_mtx_lock(&rw_audio_lock);
+	got = MIN(max, rw_head - rw_tail);
+	for (uint32_t i = 0; i < got; i++) {
+		frames[i] = rw_ring[(rw_tail + i) % RW_RING_FRAMES];
+	}
+	rw_tail += got;
+	lck_mtx_unlock(&rw_audio_lock);
+	return got;
+}
