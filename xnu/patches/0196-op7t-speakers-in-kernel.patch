+/*
+ * 0196: the speakers, in the kernel, from boot (OnePlus 7T). What tools/sweetaudio.py + sweet-media.sh did from
+ * userland (2026-11-11, heard by the user), with nothing to run by hand and no script in the image:
+ *
+ *   at boot (sweet_sound_init, from sweet_ufs.c next to the other drivers)
+ *     /dev/redwood-audio made at once (sweet_smmu.c, 0195), so the audio server's HAL plug-in (RedwoodAudio.driver)
+ *     opens it the first time it is loaded: no mediaserverd restart
+ *   then a thread, after sweetsounddelay seconds (default 15: the vendor firmware the DSP loads must be reachable)
+ *     1. the audio DSP started (SweetModem.cpp: sweet_adsp_start), waited for until its audio services are up
+ *     2. QUPv3 wrap0 SE4 as an I2C master at 400 kHz (GCC votes, S4 RCG at XO, pins 51/52 to qup4)
+ *     3. both TFA9874 amplifiers (0x34 right, 0x35 left): I2C reset, keys, NXP's rev 0x0c74 settings
+ *        (tfa_init.c tfa9874_specific), the 7T's container writes (tfa98xx.cnt: device + "speaker" profile,
+ *        built in below), muted (AMPE 0)
+ *     4. the quaternary MI2S pins (137 SCK, 138 WS, 140 SD1; qua_mi2s, 8 mA), the bit clock (3.072 MHz) and AFE
+ *        port 0x1006 (I2S on SD1, 32-bit stereo, 48 kHz, word select ours, started); the amplifiers out of
+ *        powerdown on that clock (MANSCONF 1, PWDN 0, CLKS awaited), still muted
+ *     5. the stream: the DSP buffer mapped (0194), an ADM path to 0x1006 (16-bit, no processing), ASM session 1
+ *        opened, routed, run; periods (20 ms) refilled from /dev/redwood-audio's ring as the DSP gives them back
+ *        (silence where iOS wrote nothing), scaled by sweetsoundgain dB (default 12 below: no speaker protection),
+ *        clipped; the amplifiers on at the first sound, off after 3 s of silence
+ *
+ * Boot-args: sweetsound=0 none of it (the userland tools then still work); sweetsounddelay=N; sweetsoundgain=N
+ * (attenuation in dB, 0..30). Log lines "HOTDOGB SOUND: ...". kern.sweetsound reads the stage reached (see enum
+ * below) and the counters.
+ *
+ * Numbers: as tools/sweetaudio.py (whose sources it names): GCC/QUP/TLMM from Linux sm8150 drivers and the 7T's
+ * live device tree, the GENI I2C sequence of sweet_touch.c, the TFA9874 sequence of NXP's open tfa98xx driver
+ * (Goodix-vas/tfa98xx), the APR/AFE/ADM/ASM packets of HackiOS vayu_audio.c.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
