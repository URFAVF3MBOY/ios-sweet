+
+#define LOG(fmt, ...) printf("HOTDOGB SOUND: " fmt "\n", ##__VA_ARGS__)
+
+enum {
+	ST_OFF = 0, ST_WAIT, ST_DSP, ST_I2C, ST_AMPS, ST_PORT, ST_STREAM, ST_PLAYING,
+};
+static int sound_stage, sound_failed_at;
+static uint64_t sound_periods, sound_short, sound_clipped, sound_amp_on;
+
+static void
+sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+/* ---- registers: GCC, QUPv3 wrap0 SE4, TLMM pins ---- */
+
+#define GCC_PA          0x00100000u
+#define GCC_SIZE        0x00060000u
+#define VOTE0           0x5200cu        /* QUP wrap0 votes: m_ahb bit 6, s_ahb 7, s4 14 */
+#define VOTE_BITS       ((1u << 6) | (1u << 7) | (1u << 14))
+#define S4_RCG          0x17608u        /* CMD, +4 CFG, +0x14 DFSR, +0x1c perf level 0 */
+#define S4_BR           0x17604u
+#define MAHB_BR         0x17004u
+#define SAHB_BR         0x17008u
+#define SE4_PA          0x00890000u
+#define TLMM_SOUTH      0x03d00000u
+
+static vm_offset_t gcc, se4;
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (int i = 0; i < 5000; i++) {
+		if (!(rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* a pin: function `fn', drive `ma' mA, no pull (TLMM cfg: pull [1:0], func [5:2], drive [8:6]) */
+static void
+pin(unsigned n, unsigned fn, unsigned ma)
+{
+	vm_offset_t p = ml_io_map(TLMM_SOUTH + n * 0x1000u, 0x1000);
+
+	if (p != 0) {
+		uint32_t cfg = rd(p, 0);
+		wr(p, 0, (cfg & ~0x3ffu) | (fn << 2) | (((ma / 2) - 1) << 6));
+	}
+}
+
+static bool
+clocks_on(void)
+{
+	wr(gcc, VOTE0, rd(gcc, VOTE0) | VOTE_BITS);
+	if (rd(gcc, S4_RCG + 0x14) & 1u) {                      /* DFS: level 0 must be XO / 1 */
+		if ((rd(gcc, S4_RCG + 0x1c) & 0x371fu) != 1u) {
+			LOG("SE4 clock in DFS mode, level 0 not XO/1: stopped");
+			return false;
+		}
+	} else {
+		wr(gcc, S4_RCG + 4, (rd(gcc, S4_RCG + 4) & ~(0x371fu | (1u << 20))) | 1u);
+		wr(gcc, S4_RCG, rd(gcc, S4_RCG) | 1u);
+		if (!wait_clear(gcc, S4_RCG, 1u)) {
+			LOG("SE4 clock update did not finish");
+			return false;
+		}
+	}
+	if (!wait_clear(gcc, MAHB_BR, 1u << 31) || !wait_clear(gcc, S4_BR, 1u << 31)) {
+		LOG("SE4 clocks halted (m_ahb %#x, s4 %#x)", rd(gcc, MAHB_BR), rd(gcc, S4_BR));
+		return false;
+	}
+	(void)wait_clear(gcc, SAHB_BR, 1u << 31);               /* (hardware-gated when idle: fine) */
+	return true;
+}
+
+/* ---- SE4 as an I2C master (GENI), as sweet_touch.c / sweetaudio.py ---- */
+
+#define SE_STATUS       0x040
+#define SE_MCLK         0x048
+#define SE_FW           0x068
+#define SE_CLK_SEL      0x07c
+#define SE_DMA          0x258
+#define SE_TX_LEN       0x26c
+#define SE_RX_LEN       0x270
+#define SE_SCL          0x278
+#define SE_CMD          0x600
+#define SE_CTRL         0x604
+#define SE_IRQ          0x610
+#define SE_IRQ_EN       0x614
+#define SE_IRQ_CLR      0x618
+#define SE_TX           0x700
+#define SE_RX           0x780
+#define SE_TX_COUNT     0x800
+#define SE_RX_COUNT     0x804
+#define SE_TX_WM        0x80c
+#define SE_HW_TX        0xe24
+#define SE_HW_RX        0xe28
+#define I_DONE          1u
+#define I_NACK          (1u << 10)
+#define I_RX_WM         (1u << 26)
+#define I_RX_LAST       (1u << 27)
+#define I_TX_WM         (1u << 30)
+#define I_ERRORS        (0x3eu | (1u << 9) | (1u << 10) | (1u << 12))
+#define PACK0           0x0007f8feu
+#define PACK1           0x000ffefeu
+
+static bool
+i2c_init(void)
+{
+	if (!clocks_on()) {
+		return false;
+	}
+	pin(51, 1, 2);
+	pin(52, 1, 2);
+	uint32_t fw = rd(se4, SE_FW), tx = rd(se4, SE_HW_TX), rx = rd(se4, SE_HW_RX);
+	if (((fw >> 8) & 0xffu) != 3 || ((tx >> 24) & 0x3fu) != 32 || ((rx >> 24) & 0x3fu) != 32) {
+		LOG("SE4: no I2C firmware / 32-bit FIFOs (fw %#x tx %#x rx %#x)", fw, tx, rx);
+		return false;
+	}
+	if (rd(se4, SE_STATUS) & 0x1001u) {
+		LOG("SE4 busy");
+		return false;
+	}
+	wr(se4, 0xe18, 0);
+	wr(se4, 0xe1c, 0);
+	wr(se4, 0x644, 0);
+	wr(se4, SE_IRQ_CLR, 0xffffffffu);
+	wr(se4, 0x648, 0xffffffffu);
+	wr(se4, SE_DMA, 0);
+	wr(se4, 0x28, rd(se4, 0x28) | 0x7fu);
+	wr(se4, 0xe30, rd(se4, 0xe30) | 0x0fu);
+	wr(se4, 0x24, 0x7f);
+	wr(se4, 0x20, 1);
+	wr(se4, SE_CLK_SEL, 0);
+	wr(se4, SE_MCLK, (2u << 4) | 1u);                       /* 400 kHz from 19.2 MHz */
+	wr(se4, SE_SCL, (5u << 20) | (12u << 10) | 24u);
+	wr(se4, 0x254, 0);
+	wr(se4, 0x260, PACK0);
+	wr(se4, 0x284, PACK0);
+	wr(se4, 0x264, PACK1);
+	wr(se4, 0x288, PACK1);
+	wr(se4, SE_TX_WM, 0);
+	wr(se4, 0x810, 0);
+	wr(se4, 0x814, ((rx >> 16) & 0x3fu) - 1);
+	wr(se4, SE_IRQ_EN, I_DONE | I_ERRORS | I_RX_WM | I_RX_LAST | I_TX_WM);
+	return rd(se4, 0x260) == PACK0 && rd(se4, 0x264) == PACK1;
+}
+
+static void
+i2c_abort(void)
+{
+	wr(se4, SE_CTRL, 2);
+	for (int i = 0; i < 2000 && !(rd(se4, SE_IRQ) & (1u << 5)); i++) {
+	}
+	for (int i = 0; i < 64 && (rd(se4, SE_RX_COUNT) & 0x1ffffffu); i++) {
+		(void)rd(se4, SE_RX);
+	}
+	wr(se4, SE_IRQ_CLR, 0xffffffffu);
+}
+
+/* one FIFO message: a write of up to 3 bytes, or a read of nr (<= 4) bytes */
+static int
+i2c_msg(uint8_t addr, const uint8_t *tx, unsigned ntx, uint8_t *rxb, unsigned nr, bool stretch)
+{
+	uint32_t got = 0, have = 0;
+	bool sent = false;
+
+	if (!wait_clear(se4, SE_STATUS, 1u)) {
+		return EBUSY;
+	}
+	wr(se4, SE_IRQ_CLR, 0xffffffffu);
+	wr(se4, SE_TX_WM, ntx ? 1 : 0);
+	wr(se4, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : ntx);
+	wr(se4, SE_CMD, ((nr ? 2u : 1u) << 27) | ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	for (int i = 0; i < 4000; i++) {
+		uint32_t irq = rd(se4, SE_IRQ);
+
+		if (irq & I_ERRORS) {
+			for (int j = 0; j < 2000 && !(irq & I_DONE); j++) {
+				irq = rd(se4, SE_IRQ);
+			}
+			wr(se4, SE_IRQ_CLR, irq);
+			if (!(irq & I_DONE)) {
+				i2c_abort();
+			}
+			return (irq & I_NACK) ? ENXIO : EIO;
+		}
+		if (ntx && !sent && (irq & I_TX_WM)) {
+			uint32_t w = 0;
+			for (unsigned k = 0; k < ntx; k++) {
+				w |= (uint32_t)tx[k] << (8 * k);
+			}
+			wr(se4, SE_TX, w);
+			sent = true;
+			wr(se4, SE_TX_WM, 0);
+		}
+		uint32_t count = rd(se4, SE_RX_COUNT) & 0x1ffffffu;
+		for (uint32_t k = 0; k < count && k < 64; k++) {
+			uint32_t w = rd(se4, SE_RX);
+			if (have == 0) {
+				got = w;
+			}
+			have++;
+		}
+		if (irq & I_DONE) {
+			wr(se4, SE_IRQ_CLR, irq);
+			for (unsigned k = 0; k < nr; k++) {
+				rxb[k] = (uint8_t)(got >> (8 * k));
+			}
+			return 0;
+		}
+		wr(se4, SE_IRQ_CLR, irq & (I_RX_WM | I_RX_LAST | I_TX_WM));
+	}
+	i2c_abort();
+	return ETIMEDOUT;
+}
