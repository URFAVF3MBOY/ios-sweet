+/*
+ * 0225: buffers from RAM the kernel does not manage, write-combined everywhere, no cache upkeep.
+ *
+ * Buffers here are ordinary cached memory (the write-combined ones panicked, above), so a
+ * submission pushes every buffer the program has mapped out of the cache with dc civac, whole
+ * (sweetgpudirty=0, 0192's default, since 0145/0146's page-by-page push drew wrong triangles).
+ * Measured 2026-11-13: a Metal command buffer (metal2vulkan keeps two 64 MiB heaps mapped) spent
+ * 3.2 ms of its 4.2 in the submission, pushing ~107 MB; the window server ~12.8 MB, ~0.7 ms, a
+ * submission. And a write-combined view of a managed page would be a mismatched alias of the
+ * physmap's cacheable one (flame's 0115: wrong words read back), so the fix is memory the kernel
+ * never managed: no physmap view, nothing of it ever in a cache. Linux maps freedreno's buffers
+ * the same way (MSM_BO_WC) and keeps no cache upkeep for them either.
+ *
+ * The pool is the ADT's /chosen "sweet-gpu-pool" = <base, size> (tools/adt_gpu_pool.py takes it
+ * off the top of dram-size, so the kernel never had it). Mapped once into the kernel
+ * write-combined; a buffer is a run of its pages (a bitmap, 16 KiB a bit), zeroed through that
+ * view, and mapped write-combined into the program (clientMemoryForType). A run goes back only
+ * when its descriptor has no other holder (a program's mapping of it holds one): until then it
+ * waits in gPoolGone, looked at again on the next allocation. No property, sweetgpupool=0, or a
+ * full pool: the buffer is made as before. IOSurfaces are not affected.
+ */
+#define GPU_POOL_PAGE           (16ull << 10)
+#define GPU_POOL_GONE           256
+static struct {
+	uint64_t        base, size;                     /* physical */
+	uint8_t *       kernel;                         /* the write-combined view of all of it */
+	uint64_t *      used;                           /* a bit per page */
+	uint32_t        pages, hint, free_pages;
+	uint32_t        made, missed;                   /* buffers made from it / that did not fit */
+} gPool;
+static IOMemoryDescriptor *     gPoolGone[GPU_POOL_GONE];
+static uint32_t                 gPoolGoneCount;
+static TUNABLE(uint32_t, gPoolWanted, "sweetgpupool", 1);
+
+static void
+poolStart(void)
+{
+	DTEntry chosen;
+	const void * prop = NULL;
+	unsigned int length = 0;
+
+	if (gPoolWanted == 0 || SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "sweet-gpu-pool", &prop, &length) != kSuccess || length != 16) {
+		IOLog("RedwoodGPU: no buffer pool (sweet-gpu-pool %s): buffers are cached memory\n",
+		    gPoolWanted == 0 ? "turned off" : "not in the ADT");
+		return;
+	}
+	uint64_t base = ((const uint64_t *) prop)[0], size = ((const uint64_t *) prop)[1];
+
+	if ((base | size) & (GPU_POOL_PAGE - 1) || size == 0) {
+		IOLog("RedwoodGPU: buffer pool %#llx + %#llx is not in whole pages: not used\n", base, size);
+		return;
+	}
+	gPool.pages = (uint32_t) (size / GPU_POOL_PAGE);
+	gPool.used = IONewZero(uint64_t, (gPool.pages + 63) / 64);
+	gPool.kernel = (uint8_t *) ml_io_map_wcomb((vm_offset_t) base, (vm_size_t) size);
+	if (gPool.used == NULL || gPool.kernel == NULL) {
+		IOLog("RedwoodGPU: buffer pool %#llx + %#llx cannot be mapped: not used\n", base, size);
+		gPool.pages = 0;
+		return;
+	}
+	gPool.base = base;
+	gPool.size = size;
+	gPool.free_pages = gPool.pages;
+	IOLog("RedwoodGPU: buffer pool %llu MB at %#llx, write-combined, no cache upkeep\n", size >> 20, base);
+}
+
+static bool
+poolMemory(IOMemoryDescriptor * memory)
+{
+	if (gPool.size == 0 || memory == NULL) {
+		return false;
+	}
+	addr64_t pa = memory->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+
+	return pa >= gPool.base && pa < gPool.base + gPool.size;
+}
+
+static inline bool
+poolBit(uint32_t page)
+{
+	return (gPool.used[page / 64] >> (page % 64)) & 1;
+}
+
+static void
+poolMark(uint32_t first, uint32_t count, bool used)
+{
+	for (uint32_t p = first; p < first + count; p++) {
+		if (used) {
+			gPool.used[p / 64] |= 1ull << (p % 64);
+		} else {
+			gPool.used[p / 64] &= ~(1ull << (p % 64));
+		}
+	}
+	gPool.free_pages += used ? -count : count;
+}
+
+/* With the lock held: the descriptors given back whose last other holder is gone, back into the pool. */
+static void
+poolSweep(void)
+{
+	for (uint32_t i = 0; i < gPoolGoneCount;) {
+		IOMemoryDescriptor * m = gPoolGone[i];
+
+		if (m->getRetainCount() > 1) {
+			i++;
+			continue;
+		}
+		addr64_t pa = m->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+
+		poolMark((uint32_t) ((pa - gPool.base) / GPU_POOL_PAGE), (uint32_t) (m->getLength() / GPU_POOL_PAGE), false);
+		m->release();
+		gPoolGone[i] = gPoolGone[--gPoolGoneCount];
+	}
+}
+
+/* With the lock held: `size` bytes (whole 16 KiB pages) from the pool, zeroed. NULL: none. */
+static IOMemoryDescriptor *
+poolTake(uint64_t size, uint8_t ** kernel)
+{
+	if (gPool.size == 0 || size == 0 || (size & (GPU_POOL_PAGE - 1))) {
+		return NULL;
+	}
+	poolSweep();
+	uint32_t need = (uint32_t) (size / GPU_POOL_PAGE), run = 0, first = 0;
+
+	if (need > gPool.free_pages) {
+		gPool.missed++;
+		return NULL;
+	}
+	/* first fit from the hint, once round */
+	for (uint32_t n = 0; n < gPool.pages + need; n++) {
+		uint32_t p = (gPool.hint + n) % gPool.pages;
+
+		if (p == 0) {
+			run = 0;                                /* (a run does not wrap) */
+		}
+		if (poolBit(p)) {
+			run = 0;
+			continue;
+		}
+		if (run++ == 0) {
+			first = p;
+		}
+		if (run == need) {
+			IOMemoryDescriptor * m = IOMemoryDescriptor::withPhysicalAddress(gPool.base + first * GPU_POOL_PAGE,
+			    size, kIODirectionInOut);
+
+			if (m == NULL) {
+				return NULL;
+			}
+			poolMark(first, need, true);
+			gPool.hint = (first + need) % gPool.pages;
+			gPool.made++;
+			*kernel = gPool.kernel + first * GPU_POOL_PAGE;
+			return m;
+		}
+	}
+	gPool.missed++;
+	return NULL;
+}
+
+/* With the lock held: a buffer's memory let go of; a pool run goes back once nobody else holds it. */
+static void
+gpuMemoryRelease(IOMemoryDescriptor * memory)
+{
+	if (!poolMemory(memory)) {
+		memory->release();
+		return;
+	}
+	if (gPoolGoneCount == GPU_POOL_GONE) {
+		poolSweep();
+	}
+	if (gPoolGoneCount < GPU_POOL_GONE) {
+		gPoolGone[gPoolGoneCount++] = memory;
+		poolSweep();
+	} else {
+		static uint32_t said;
+
+		if (said++ < 4) {
+			IOLog("RedwoodGPU: %u pool buffers given back are still mapped: one stays out of the pool\n", gPoolGoneCount);
+		}
+		memory->release();                      /* (its run stays marked: lost, not handed out twice) */
+	}
+}
