diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -1847,6 +1847,101 @@
 	__builtin_unreachable();
 }
 
+#if defined(SWEET)
+/*
+ * sweet profiler (0114, from ios-sailfish 0111-0113/0148; bsd/dev/sweet_sample.c sets
+ * sweet_prof_pid): every
+ * interrupt taken while a thread of that process runs records its user pc
+ * (or counts a kernel-mode sample), then the callers: kernel frames tagged
+ * with their depth 1-3 in the low 2 bits, user frames (up to 32) tagged 1.
+ */
+#define SWEET_PROF_USER_FRAMES 32
+extern pmap_paddr_t mmu_uvtop(vm_offset_t va);
+extern boolean_t pmap_valid_address(pmap_paddr_t addr);
+extern vm_map_address_t phystokv(pmap_paddr_t pa);
+
+/*
+ * 16-byte user frame record {fp, lr} at va, read without faulting: AT
+ * S1E0R through the interrupted task's tables (mmu_uvtop), then the kernel's
+ * physical window, RAM only. Only called for samples taken in user mode,
+ * so no interrupted kernel code has an AT/PAR_EL1 sequence in flight.
+ */
+static inline bool
+sweet_prof_user_frame(uint64_t va, uint64_t rec[2])
+{
+	if ((va & 15) || va == 0 || va >= MACH_VM_MAX_ADDRESS) {
+		return false;
+	}
+	pmap_paddr_t pa = mmu_uvtop((vm_offset_t)va);
+	if (pa == 0 || !pmap_valid_address(pa)) {
+		return false;
+	}
+	const uint64_t *p = (const uint64_t *)phystokv(pa);
+	rec[0] = p[0];
+	rec[1] = p[1];
+	return true;
+}
+#define SWEET_PROF_MAX 262144
+int sweet_prof_pid;
+uint64_t sweet_prof_pc[SWEET_PROF_MAX];
+uint32_t sweet_prof_n, sweet_prof_kernel, sweet_prof_all;
+extern int task_pid(task_t task);
+
+static inline void
+sweet_prof_irq(arm_saved_state_t *state)
+{
+	int pid = sweet_prof_pid;
+	if (pid <= 0) {
+		return;
+	}
+	os_atomic_inc(&sweet_prof_all, relaxed);
+	if (task_pid(current_task()) != pid) {
+		return;
+	}
+	/* Kernel pcs are stored unslid (0xfffffff007...: nm of the built kernel). */
+	uint64_t pc = get_saved_state_pc(state);
+	if (!PSR64_IS_USER(get_saved_state_cpsr(state))) {
+		os_atomic_inc(&sweet_prof_kernel, relaxed);
+		pc = VM_KERNEL_UNSLIDE(pc);
+	}
+	uint32_t i = os_atomic_inc_orig(&sweet_prof_n, relaxed);
+	if (i < SWEET_PROF_MAX) {
+		sweet_prof_pc[i] = pc;
+	}
+	if (PSR64_IS_USER(get_saved_state_cpsr(state))) {
+		/* user callers: frame-pointer return addresses, tag 1 */
+		uint64_t fp = get_saved_state_fp(state), rec[2];
+		for (int d = 0; d < SWEET_PROF_USER_FRAMES && sweet_prof_user_frame(fp, rec); d++) {
+			if (rec[1] == 0) {
+				break;
+			}
+			i = os_atomic_inc_orig(&sweet_prof_n, relaxed);
+			if (i < SWEET_PROF_MAX) {
+				sweet_prof_pc[i] = (rec[1] & ~3ULL) | 1;
+			}
+			if (rec[0] <= fp) {
+				break;          /* stacks grow down: callers' frames are higher */
+			}
+			fp = rec[0];
+		}
+		return;
+	}
+	/*
+	 * Kernel callers: frame-pointer return addresses, depth 1-3 in the low
+	 * 2 bits (frames inside this thread's kernel stack only).
+	 */
+	vm_offset_t lo = current_thread()->kernel_stack, hi = lo + kernel_stack_size;
+	uint64_t fp = get_saved_state_fp(state);
+	for (uint64_t d = 1; d <= 3 && fp >= lo && fp + 16 <= hi && (fp & 15) == 0; d++) {
+		i = os_atomic_inc_orig(&sweet_prof_n, relaxed);
+		if (i < SWEET_PROF_MAX) {
+			sweet_prof_pc[i] = (VM_KERNEL_UNSLIDE(((uint64_t *)fp)[1]) & ~3ULL) | d;
+		}
+		fp = ((uint64_t *)fp)[0];
+	}
+}
+#endif
+
