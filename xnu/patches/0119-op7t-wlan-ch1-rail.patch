@@ -5747,6 +5747,14 @@ soc_power_up(void)
 {
 	static const struct { const char *res; unsigned mv; } wlan_rails[] = {
 		{ "ldoa1", 752 }, { "ldoa7", 1800 }, { "ldoc2", 1304 }, { "ldoc11", 3104 },
+		/*
+		 * 0119: WCN3990 vdd-3.3-ch1 = PM8150L L10 (the 7T Pro's working mainline Wi-Fi uses all five
+		 * rails, hotdog-linux-bringup validate-mainline616-build.sh). The 7T's downstream icnss node
