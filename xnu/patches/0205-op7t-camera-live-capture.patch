+/*
+ * 0205: a stream group translated through a bank whose tables map ONLY [pa, pa + 2 MiB) (pa 2 MiB aligned,
+ * below 4 GiB) to itself; everything else faults (the bank terminates faulting transactions). For the camera
+ * IFE writing real sensor frames: a wrong frame size then ends in an SMMU fault, not in kernel memory.
+ * Tables: one L1 page (T0SZ 25: 512 GiB, 1 GiB per entry) pointing at one L2 page with a single 2 MiB block.
+ */
+int sweet_smmu_window_group(uint32_t sid, uint32_t smask, uint64_t pa);
+
+int
+sweet_smmu_window_group(uint32_t sid, uint32_t smask, uint64_t pa)
+{
+	static uint64_t tables_pa;
+	static vm_offset_t tables_va;
+
+	if ((pa & 0x1fffffull) != 0 || pa + 0x200000ull > 0x100000000ull) {
+		return -1;
+	}
+	if (tables_va == 0) {
+		vm_offset_t kva = 0;
+		ppnum_t pn;
+
+		if (kmem_alloc_contig(kernel_map, &kva, 2 * PAGE_SIZE, PAGE_MASK, (ppnum_t)(atop(0x100000000ull) - 1), 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return -1;
+		}
+		pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+		if (pn == 0) {
+			return -1;
+		}
+		tables_pa = ptoa_64(pn);
+		tables_va = ml_io_map_wcomb((vm_offset_t)tables_pa, 2 * PAGE_SIZE);
+		if (tables_va == 0) {
+			return -1;
+		}
+	}
+	volatile uint64_t *l1 = (volatile uint64_t *)tables_va;
+	volatile uint64_t *l2 = (volatile uint64_t *)(tables_va + PAGE_SIZE);
+	for (unsigned i = 0; i < 512; i++) {
+		l1[i] = 0;
+		l2[i] = 0;
+	}
+	l1[(pa >> 30) & 511] = (tables_pa + PAGE_SIZE) | 3u;                     /* table */
+	l2[(pa >> 21) & 511] = pa | (1u << 10) | (2u << 8) | (1u << 6) | 1u;      /* 2 MiB block, as the identity map's */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	int bank = smmu_identity_masked(sid, smask, tables_pa);
+	printf("HOTDOGB SMMU: window %#llx + 2 MiB for SID %#x/%#x (tables %#llx): bank %d\n", pa, sid, smask, tables_pa, bank);
+	return bank;
+}
+
+/* 0205: a bank's fault status (FSR) and fault address (FAR), then FSR cleared; -1 if unknown */
+int sweet_smmu_bank_fault(int bank, uint32_t *fsr, uint64_t *far);
+
+int
+sweet_smmu_bank_fault(int bank, uint32_t *fsr, uint64_t *far)
+{
+	if (smmu == 0 || bank < 0 || bank > 127) {
+		return -1;
+	}
+	uint32_t idr1 = smmu_rd(0x24);
+	uint32_t pagesize = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+	uint32_t cb_base = (1u << (((idr1 >> 28) & 7u) + 1u)) * pagesize;
+	uint32_t cbo = cb_base + (uint32_t)bank * pagesize;
+
+	if (cbo + pagesize > SMMU_SIZE) {
+		return -1;
+	}
+	*fsr = smmu_rd(cbo + CB_FSR);
+	*far = smmu_rd64(cbo + 0x60);           /* CB_FAR */
+	smmu_wr(cbo + CB_FSR, *fsr);
+	return 0;
+}
