+/* 0205: a 2 MiB, 2 MiB-aligned uncached capture buffer below 4 GiB (for sweet_smmu_window_group) */
+int sweet_cam_dma_buffer_2m(uint64_t *pa, vm_offset_t *va);
+
+int
+sweet_cam_dma_buffer_2m(uint64_t *pa, vm_offset_t *va)
+{
+	vm_offset_t kva = 0;
+	ppnum_t pn;
+	uint64_t p;
+
+	if (kmem_alloc_contig(kernel_map, &kva, 0x200000, 0x1fffff, (ppnum_t)(atop(0x100000000ull) - 1), 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+	p = ptoa_64(pn);
+	if (pn == 0 || (p & 0x1fffffull) != 0 || p < 0x80000000ull || p + 0x200000ull > 0x100000000ull) {
+		return ERANGE;
+	}
+	*va = ml_io_map((vm_offset_t)p, 0x200000);
+	if (*va == 0) {
+		return ENOMEM;
+	}
+	*pa = p;
+	return 0;
 }
 
