+		sweet_fps_copies++;
+		if (sweet_fps_t0 == 0) {
+			sweet_fps_t0 = now;
+		} else if (now - sweet_fps_t0 >= sweet_fps_second) {
+			uint64_t el = now - sweet_fps_t0;
+			sweet_fps_last_swaps = (uint32_t)((uint64_t)sweet_fps_swaps * sweet_fps_second / el);
+			sweet_fps_last_copies = (uint32_t)((uint64_t)sweet_fps_copies * sweet_fps_second / el);
+			IOLog("HOTDOGB FB: %u fps (backboardd), %u panel copies/s\n",
+			    sweet_fps_last_swaps, sweet_fps_last_copies);
+			sweet_fps_swaps = sweet_fps_copies = 0;
+			sweet_fps_t0 = now;
+		}
+		sweet_fps_draw(fPixels, fRowBytes, fWidth, fHeight, sweet_fps_last_swaps, sweet_fps_last_copies);
+	}
 	for (uint32_t i = 0; i < nheld; i++) {
 		held[i]->release();
 	}
