+/* 0229: the newest swap not yet presented, presented (present() waits for the GPU to finish its surface). */
+void
+AppleCLCD::flipCalled(thread_call_param_t owner, thread_call_param_t unused)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+
+	(void)unused;
+	if (rec == NULL) {
+		return;                                 /* (the vsync tick presents it) */
+	}
+	IOLockLock(fb->fPresentLock);
+	IOLockLock(fb->fLock);
+	bool take = fb->fDirty && !fb->fPowerOff;
+	if (take) {
+		memcpy(rec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+		fb->fDirty = false;
+	}
+	IOLockUnlock(fb->fLock);
+	if (take) {
+		fb->present(rec);
+	}
+	IOLockUnlock(fb->fPresentLock);
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+}
