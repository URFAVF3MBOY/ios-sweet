+static bool
+sweet_bt_env(struct image_params *imgp, char *env, size_t size)
+{
+	int on = 1;
+
+	(void)PE_parse_boot_argn("sweetbtenv", &on, sizeof(on));
+	if (!on || imgp->ip_ndp == NULL || imgp->ip_ndp->ni_cnd.cn_nameptr == NULL ||
