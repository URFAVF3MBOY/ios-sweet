+	}
+}
+
+/*
+ * 0197: from boot. bt_ran is taken at once, so kern.sweetbt=1 says EALREADY while this runs (bt_up.sh waits for
+ * stage 6 instead). A try that stops before stage 6 is repeated after 10 s, three tries in all: the power-off/on
+ * pulses at the start of sweet_bt_up put the chip back into boot mode.
+ */
+static void
+bt_boot_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t delay_s = 12;
+
+	(void)PE_parse_boot_argn("sweetbtdelay", &delay_s, sizeof(delay_s));
+	printf("sweet_bt: boot: bring-up in %u s\n", delay_s);
+	if (delay_s > 600) {
+		delay_s = 600;
+	}
+	delay((int)(delay_s * 1000000));
+	for (int attempt = 1; attempt <= 3; attempt++) {
+		bt_bring_up();
+		printf("sweet_bt: boot: try %d -> stage %d\n", attempt, bt_stage);
+		if (bt_stage == 6) {
+			return;
+		}
+		delay(10000000);
+	}
+	bt_ran = false;         /* (kern.sweetbt=1 may try again by hand) */
+	printf("sweet_bt: boot: no Bluetooth (stage %d after 3 tries; kern.sweetbt=1 can retry)\n", bt_stage);
+}
+
+void sweet_bt_init(void);
+
+void
+sweet_bt_init(void)
+{
