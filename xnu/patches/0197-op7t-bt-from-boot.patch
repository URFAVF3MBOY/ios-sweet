+/* chip up to stage 6, then the io thread and the kernel controls (kern.sweetbt=1 and, 0197, the boot thread) */
+static void
+bt_bring_up(void)
+{
+	bt_stage = 1;
+	lck_mtx_lock(&bt_io_lock);
+	bt_stage = sweet_bt_up();
+	if (bt_stage == 6) {
+		/* what came in after the NVM, for kern.sweetbtio's first read */
+		memcpy(io_rx, rx_keep, rx_kept);
+		io_rx_len = rx_kept;
+		rx_kept = 0;
+	}
+	lck_mtx_unlock(&bt_io_lock);
