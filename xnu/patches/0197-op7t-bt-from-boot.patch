+	if (!on) {
+		printf("sweet_bt: boot: off (sweetbt=0; kern.sweetbt=1 still works)\n");
+		return;
+	}
+	bt_ran = true;
+	if (kernel_thread_start(bt_boot_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_set_thread_name(t, "sweet-bt-boot");
+		thread_deallocate(t);
+	} else {
+		bt_ran = false;
+		printf("sweet_bt: boot: thread NOT started\n");
+	}
+}
