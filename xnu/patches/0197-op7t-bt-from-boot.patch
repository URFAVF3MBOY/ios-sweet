+/*
+ * ---- 0197: bluetoothd's expectations of Apple's (Broadcom) chips, met on the WCN3990 (was bthook, 11-10) ----
+ *
+ * The chip's bytes for a client are cut into whole H4 packets here; each complete packet may be edited, then
+ * goes to the client. Bytes that do not start a packet (none expected: in-band sleep is off) pass as they are.
+ *   Command Complete 0x1002 (Read Local Supported Commands): octet 18 bit 3 set (0x0C5B supported); without it
+ *     bluetoothd quits "OI_HCICMD_WriteDefaultErroneousDataReporting (status=628)".
+ *   Command Complete 0x0C5B: status -> 0.
+ *   Command Complete of a vendor command (OGF 0x3F) with status 1 (unknown) and nothing more: status 0, the
+ *     command's first parameter byte, then zeros, BT_VSC_PAD bytes after the status in all. bcm_vsc.c's reply
+ *     parsers assert "ByteStream_NumReadBytesAvail >= N" or time out ("BD_VSC_... timedout") on a short one.
+ * The client's commands are followed (bt_fix_tx) only to remember each vendor command's first parameter byte.
+ * Both parsers start over at every connect (bluetoothd off/on reconnects; the old stream may end mid-packet).
+ */
+#define BT_VSC_PAD              32
+static int bt_fix = 1;                  /* boot-arg sweetbtfix */
+static uint8_t bt_vsc_first[64];        /* first parameter byte of the last vendor command, by OCF & 63 */
+static struct {
+	uint8_t buf[2048];
+	unsigned n, need;
+} bt_rxp;
+static struct {
+	uint8_t hdr[5];
+	unsigned n, skip;               /* header bytes collected; payload bytes still to pass */
+} bt_txp;
+
+/* the client's bytes, as sent: only vendor command headers matter */
+static void
+bt_fix_tx(const uint8_t *b, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		if (bt_txp.skip != 0) {
+			bt_txp.skip--;
+			continue;
+		}
+		if (bt_txp.n == 0 && b[i] != HCI_COMMAND_PKT && b[i] != 0x02 && b[i] != 0x03) {
+			continue;
+		}
+		bt_txp.hdr[bt_txp.n++] = b[i];
+		uint8_t t = bt_txp.hdr[0];
+
+		if (t == HCI_COMMAND_PKT && bt_txp.n == 5) {
+			/* 01 op_lo op_hi len p0 (len >= 1 here): the first parameter byte */
+			if ((bt_txp.hdr[2] >> 2) == 0x3f) {
+				bt_vsc_first[bt_txp.hdr[1] & 63] = bt_txp.hdr[4];
+			}
+			bt_txp.skip = bt_txp.hdr[3] - 1u;
+			bt_txp.n = 0;
+		} else if (t == HCI_COMMAND_PKT && bt_txp.n == 4 && bt_txp.hdr[3] == 0) {
+			if ((bt_txp.hdr[2] >> 2) == 0x3f) {
+				bt_vsc_first[bt_txp.hdr[1] & 63] = 0;
+			}
+			bt_txp.n = 0;
+		} else if (t == 0x02 && bt_txp.n == 5) {
+			bt_txp.skip = (unsigned)(bt_txp.hdr[3] | bt_txp.hdr[4] << 8);
+			bt_txp.n = 0;
+		} else if (t == 0x03 && bt_txp.n == 4) {
+			bt_txp.skip = bt_txp.hdr[3];
+			bt_txp.n = 0;
+		}
+	}
+}
+
+/* one complete packet in bt_rxp.buf: edit it into out (room for n + BT_VSC_PAD); returns its new length */
+static unsigned
+bt_fix_packet(uint8_t *out)
+{
+	uint8_t *p = bt_rxp.buf;
+	unsigned n = bt_rxp.n;
+
+	if (p[0] == HCI_EVENT_PKT && p[1] == 0x0e && n >= 7) {
+		uint16_t op = (uint16_t)(p[4] | p[5] << 8);
+
+		if (op == 0x1002 && n > 7 + 18 && !(p[7 + 18] & 0x08)) {
+			p[7 + 18] |= 0x08;
+			bt_fix_edits++;
+		} else if (op == 0x0c5b && p[6] != 0) {
+			p[6] = 0;
+			bt_fix_edits++;
+		} else if ((op >> 10) == 0x3f && p[2] == 4 && p[6] == 0x01) {
+			bzero(out, 7 + BT_VSC_PAD);
+			out[0] = HCI_EVENT_PKT;
+			out[1] = 0x0e;
+			out[2] = 4 + BT_VSC_PAD;
+			out[3] = p[3];
+			out[4] = p[4];
+			out[5] = p[5];
+			out[6] = 0;
+			out[7] = bt_vsc_first[op & 63];
+			bt_fix_edits++;
+			return 7 + BT_VSC_PAD;
+		}
+	}
+	memcpy(out, p, n);
+	return n;
 }
 
+/* the chip's bytes for the client, edited; out has room for 2 * n + BT_VSC_PAD + sizeof(bt_rxp.buf) */
+static unsigned
+bt_fix_rx(const uint8_t *b, unsigned n, uint8_t *out)
+{
+	unsigned o = 0;
+
+	for (unsigned i = 0; i < n; i++) {
+		if (bt_rxp.n == 0 && b[i] != HCI_EVENT_PKT && b[i] != HCI_ACL_PKT && b[i] != HCI_SCO_PKT) {
+			out[o++] = b[i];
+			continue;
+		}
+		if (bt_rxp.n < sizeof(bt_rxp.buf)) {
+			bt_rxp.buf[bt_rxp.n] = b[i];
+		}
+		bt_rxp.n++;
+		if (bt_rxp.need == 0) {
+			uint8_t t = bt_rxp.buf[0];
+
+			if (t == HCI_EVENT_PKT && bt_rxp.n == 3) {
+				bt_rxp.need = 3u + bt_rxp.buf[2];
+			} else if (t == HCI_SCO_PKT && bt_rxp.n == 4) {
+				bt_rxp.need = 4u + bt_rxp.buf[3];
+			} else if (t == HCI_ACL_PKT && bt_rxp.n == 5) {
+				bt_rxp.need = 5u + (unsigned)(bt_rxp.buf[3] | bt_rxp.buf[4] << 8);
+			}
+			if (bt_rxp.need > sizeof(bt_rxp.buf)) {
+				/* too big to hold (should not happen): pass the header on, then the rest unparsed */
+				printf("sweet_bt: fix: packet of %u bytes, passed on unparsed\n", bt_rxp.need);
+				memcpy(out + o, bt_rxp.buf, bt_rxp.n);
+				o += bt_rxp.n;
+				bt_rxp.n = 0;
+				unsigned rest = bt_rxp.need - (bt_rxp.buf[0] == HCI_ACL_PKT ? 5u : bt_rxp.buf[0] == HCI_SCO_PKT ? 4u : 3u);
+				bt_rxp.need = 0;
+				while (rest != 0 && i + 1 < n) {
+					out[o++] = b[++i];
+					rest--;
+				}
+				/* (a rest that spans reads is lost to the framing; logged above) */
+				continue;
+			}
+		}
+		if (bt_rxp.need != 0 && bt_rxp.n >= bt_rxp.need) {
+			o += bt_fix_packet(out + o);
+			bt_rxp.n = bt_rxp.need = 0;
+		}
+	}
+	return o;
+}
