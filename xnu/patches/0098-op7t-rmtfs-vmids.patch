diff --git a/iokit/Kernel/arm/SweetModem.cpp b/iokit/Kernel/arm/SweetModem.cpp
--- a/iokit/Kernel/arm/SweetModem.cpp
+++ b/iokit/Kernel/arm/SweetModem.cpp
@@ -2092,8 +2092,18 @@ rmtfs_rx(uint32_t node, uint32_t port, uint16_t txn, uint16_t msg, const uint8_t
 			if (rmtfs_va == NULL) {
 				rmtfs_pa = 0;
 			} else {
-				static const uint32_t v[] = { VMID_HLOS, VMID_MSS_MSA, VMID_NAV };
