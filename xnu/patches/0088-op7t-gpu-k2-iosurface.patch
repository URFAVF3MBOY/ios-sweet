+/*
+ * The memory of an IOSurface as a buffer (HackiOS's surfaceBuffer, on SweetSurface): its pixels,
+ * from byte 0 of the surface's memory. The surface is held for as long as the buffer is there. A
+ * surface that is a buffer of this client's already is that buffer again, as with Linux's handles.
+ * Asked only to describe (kRedwoodDescribe), no buffer is made.
+ */
+IOReturn
+RedwoodGPUUserClient::surfaceBuffer(struct redwood_surface * request)
+{
+	SweetSurface * s = sweet_surface_copy(request->surface);
+	struct gpu_buffer * b = NULL;
+	uint64_t size, began = mach_absolute_time();
+
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	size = round_page_64(s->allocSize);
+	if (s->memory == NULL || size == 0 || size > GPU_BUFFER_MAX || s->memory->getLength() < size) {
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	request->size = size;
+	request->offset = s->offset;
+	request->rowBytes = s->bytesPerRow;
+	request->width = s->width;
+	request->height = s->height;
+	request->pixelFormat = s->pixelFormat;
+	request->planes = s->planeCount;
+	if (request->handle == kRedwoodDescribe) {
+		request->handle = 0;
+		s->release();
+		return kIOReturnSuccess;
+	}
+
+	IOLockLock(gGPULock);
+	for (uint32_t i = 0; i < GPU_BUFFERS; i++) {
+		if (fBuffers[i].memory != NULL && fBuffers[i].surface == s) {
+			b = &fBuffers[i];
+			request->handle = i + 1;
+			break;
+		}
+	}
+	if (b != NULL) {
+		s->release();
+	} else if ((b = newBuffer(s->memory, 0, size, 0, &request->handle)) != NULL) {
+		s->memory->retain();
+		b->memory = s->memory;
+		b->kernel = (uint8_t *) s->kernelAddress();
+		b->surface = s;
+		gGPUStat.surfaces++;
+	}
+	gGPUStat.taking += mach_absolute_time() - began;
+	IOLockUnlock(gGPULock);
+	if (b == NULL) {
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	return kIOReturnSuccess;
+}
