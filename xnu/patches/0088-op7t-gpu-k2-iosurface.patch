+/*
+ * The display's driver (SweetFramebuffer.cpp) before it copies a surface to the panel: the GPU's
+ * last submission that names the surface is to be done (HackiOS MiniIOSurfaceDrawn), and what the
+ * GPU wrote is read from memory, not from this processor's cache (kitty's surfaces are cached
+ * memory): the surface's lines are cleaned and invalidated once per new submission.
+ */
+bool
+RedwoodGPUSurfaceDrawn(SweetSurface * surface, uint64_t milliseconds)
+{
+	uint32_t fence = surface->gpuDrawn;
+	bool done = true;
+
+	if (fence != 0 && gGPULock != NULL) {
+		IOLockLock(gGPULock);
+		done = !redwood_gpu_ready() || gpuWait(fence, milliseconds);
+		if (done && surface->gpuSynced != fence) {
+			uintptr_t pixels = surface->kernelAddress();
+
+			if (pixels != 0) {
+				redwood_gpu_to_memory((void *) pixels, surface->allocSize);
+			}
+			surface->gpuSynced = fence;
+		}
+		IOLockUnlock(gGPULock);
+	}
+	return done;
+}
