+/* kitty's IOSurface seed: a u32 in the surface's state page (SweetSurface.cpp SWEET_SURFACE_STATE_SEED) */
+#define SWEET_SURFACE_SEED_AT   0xc
+
+static uint32_t
+surfaceSeed(SweetSurface * s)
+{
+	return s->state != NULL ? *(volatile uint32_t *) ((uint8_t *) s->state->getBytesNoCopy() + SWEET_SURFACE_SEED_AT) : 0;
+}
