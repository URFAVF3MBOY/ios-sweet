diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -320,6 +320,251 @@
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
+/*
+ * ---- K1a (G5): the kernel half of HackiOS's GPU interface on the A640 ----
+ * After HackiOS redwood_adreno.c (redwood_gpu_address/_free, _map/_mapped/_unmap, _submit,
+ * _done): a GPU address allocator, 4K pages mapped into the 3D core's SMMU context at run
+ * time, unmapping with TLB maintenance on that context, and a submit of indirect buffers
+ * ending in a fence. RedwoodGPU's user client (K1b) will sit on top of these.
+ *   VA window 0x10000000-0x13ffffff: L2 entries 128..159 of the shim's L2 (L1[0]), one L3
+ *   table per 2 MiB from a 32-table pool at scratch +0x500000 (slice SL_K1, 192 KiB:
+ *   0x20000 tables, 0x10000 test pages).
+ *   TLB: TLBIASID 0 + TLBSYNC on the GPU's own context bank (found by its SMR,
+ *   SID 0 mask 0x401, as the shim programs it). HackiOS does this routinely on the GPU's
+ *   context; our "no CB access while a master runs" rule came from the GMU's CB0. The
+ *   self-test checks it: map page A at VA v, GPU writes; unmap (TLB maintenance); map page B
+ *   at the same v, GPU writes; B must get the value and A must not.
+ * Self-test: boot-arg sweetk1=1 (default 0), after the 0084 tests.
+ */
+#define SL_K1_PA		(SCRATCH_PA + 0x500000UL)
+#define SL_K1_LEN		0x30000UL
+#define K1_POOL_PA		SL_K1_PA			/* 32 L3 tables */
+#define K1_TEST_PA		(SL_K1_PA + 0x20000UL)		/* 16 test pages */
+#define K1_VA_BASE		0x10000000ULL
+#define K1_VA_SIZE		0x04000000ULL
+#define K1_PTE_RO		(1ULL << 7)			/* AP[2]: read-only */
+#define K1_FENCE_OFF		0x180U				/* scratch word, after 0084's */
+#define K1_SMMU_PA		0x02ca0000UL
+#define SMMU_IDR1_OFF		0x24U
+#define SMMU_SMR_OFF(n)		(0x800U + 4U * (n))
+#define SMMU_S2CR_OFF(n)	(0xc00U + 4U * (n))
+#define CB_TLBIASID		0x610U
+#define CB_TLBSYNC		0x7f0U
+#define CB_TLBSTATUS		0x7f4U
+#define K1_GPU_SMR		(0x80000000U | (0x401U << 16))	/* VALID | mask 0x401 | SID 0 */
+
+static vm_offset_t sl_k1, k1_cb;
+static uint32_t k1_l3_live;			/* bit t: pool table t is in the L2 */
+static struct { uint64_t start, size; } k1_free[64];
+static unsigned k1_nfree, k1_lost;
+static uint32_t k1_fence;
+
+static vm_offset_t k1p(uintptr_t pa)		/* K1 slice PA -> kernel VA */
+{
+	return sl_k1 + (pa - SL_K1_PA);
+}
+
+uint64_t sweet_gpu_address(uint64_t size)
+{
+	size = (size + 0xfffULL) & ~0xfffULL;
+	for (unsigned i = 0; i < k1_nfree; i++) {
+		if (k1_free[i].size >= size) {
+			uint64_t a = k1_free[i].start;
+			k1_free[i].start += size;
+			k1_free[i].size -= size;
+			if (k1_free[i].size == 0) {
+				for (unsigned j = i; j + 1 < k1_nfree; j++)
+					k1_free[j] = k1_free[j + 1];
+				k1_nfree--;
+			}
+			return a;
+		}
+	}
+	return 0;
+}
+
+void sweet_gpu_address_free(uint64_t a, uint64_t size)
+{
+	unsigned at;
+	size = (size + 0xfffULL) & ~0xfffULL;
+	for (at = 0; at < k1_nfree && k1_free[at].start < a; at++)
+		;
+	if (at > 0 && k1_free[at - 1].start + k1_free[at - 1].size == a) {
+		k1_free[at - 1].size += size;
+		if (at < k1_nfree && a + size == k1_free[at].start) {
+			k1_free[at - 1].size += k1_free[at].size;
+			for (unsigned j = at; j + 1 < k1_nfree; j++)
+				k1_free[j] = k1_free[j + 1];
+			k1_nfree--;
+		}
+	} else if (at < k1_nfree && a + size == k1_free[at].start) {
+		k1_free[at].start = a;
+		k1_free[at].size += size;
+	} else if (k1_nfree < 64) {
+		for (unsigned j = k1_nfree; j > at; j--)
+			k1_free[j] = k1_free[j - 1];
+		k1_free[at].start = a;
+		k1_free[at].size = size;
+		k1_nfree++;
+	} else {
+		k1_lost += (unsigned)(size >> 12);	/* counted, never handed out again */
+	}
+}
+
+/* one 4K page; a fresh 2 MiB table is zeroed and hung in the L2 before use (no TLB issue: never valid before) */
+int sweet_gpu_map(uint64_t va, uint64_t pa, int read_only)
+{
+	if (va < K1_VA_BASE || va >= K1_VA_BASE + K1_VA_SIZE || (va & 0xfffULL) || (pa & 0xfffULL))
+		return 0;
+	uint32_t t = (uint32_t)((va - K1_VA_BASE) >> 21);
+	uintptr_t l3 = K1_POOL_PA + (uintptr_t)t * 0x1000;
+	if (!(k1_l3_live & (1U << t))) {
+		volatile uint64_t *tab = (volatile uint64_t *)k1p(l3);
+		for (unsigned i = 0; i < 512; i++)
+			tab[i] = 0;
+		__asm__ volatile("dsb sy" ::: "memory");
+		*sp64(GPU_PT_PA + 0x1000 + (uintptr_t)((va >> 21) & 0x1ffU) * 8) = (uint64_t)l3 | PTE_TABLE;
+		k1_l3_live |= 1U << t;
+	}
+	((volatile uint64_t *)k1p(l3))[(va >> 12) & 0x1ffU] =
+	    pa | PTE_PAGE | PTE_ATTR | (read_only ? K1_PTE_RO : 0);
+	return 1;
+}
+
+void sweet_gpu_mapped(void)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int k1_tlb_flush(void)
+{
+	if (!k1_cb)
+		return 0;
+	*(volatile uint32_t *)(k1_cb + CB_TLBIASID) = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(k1_cb + CB_TLBSYNC) = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	for (unsigned i = 0; i < 100000; i++) {
+		if (!(*(volatile uint32_t *)(k1_cb + CB_TLBSTATUS) & 1U))
+			return 1;
+		delay(1);
+	}
+	return 0;
+}
+
+int sweet_gpu_unmap(uint64_t va, uint64_t size)
+{
+	for (uint64_t o = 0; o < size; o += 0x1000) {
+		uint64_t v = va + o;
+		if (v < K1_VA_BASE || v >= K1_VA_BASE + K1_VA_SIZE)
+			continue;
+		uint32_t t = (uint32_t)((v - K1_VA_BASE) >> 21);
+		if (k1_l3_live & (1U << t))
+			((volatile uint64_t *)k1p(K1_POOL_PA + (uintptr_t)t * 0x1000))[(v >> 12) & 0x1ffU] = 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	return k1_tlb_flush();
+}
+
+/* HackiOS redwood_gpu_submit, on 0084's ring: invalidate CCU, the IBs, then the fence (synchronous here) */
+uint32_t sweet_gpu_submit(const uint64_t *ib_va, const uint32_t *ib_dw, uint32_t count)
+{
+	uint32_t dw[4 + 4 * 8 + 4], n = 0;
+	if (count > 8)
+		return 0;
+	if (++k1_fence == 0)
+		k1_fence = 1;
+	dw[n++] = cp_type7(CP_OP_EVENT_WRITE, 1); dw[n++] = EV_CCU_INV_DEPTH;
+	dw[n++] = cp_type7(CP_OP_EVENT_WRITE, 1); dw[n++] = EV_CCU_INV_COLOR;
+	for (uint32_t i = 0; i < count; i++) {
+		dw[n++] = cp_type7(CP_OP_INDIRECT_BUFFER_PFE, 3);
+		dw[n++] = (uint32_t)ib_va[i];
+		dw[n++] = (uint32_t)(ib_va[i] >> 32);
+		dw[n++] = ib_dw[i];
+	}
+	dw[n++] = cp_type7(CP_OP_EVENT_WRITE, 4);
+	dw[n++] = EV_CACHE_FLUSH_TS;
+	dw[n++] = GPU_VA_SCR + K1_FENCE_OFF;
+	dw[n++] = 0;
+	dw[n++] = k1_fence;
+	return ring_submit(dw, n, K1_FENCE_OFF, k1_fence) == 1 ? k1_fence : 0;
+}
+
+/* find the GPU's context bank (SMR set by the shim) and map its page */
+static int k1_find_cb(void)
+{
+	vm_offset_t g = ml_io_map(K1_SMMU_PA, 0x1000);
+	if (!g)
+		return 0;
+	uint32_t idr1 = *(volatile uint32_t *)(g + SMMU_IDR1_OFF);
+	uint32_t num_global = 1U << (((idr1 >> 28) & 7U) + 1U);
+	for (uint32_t n = 0; n < 32; n++) {
+		if (*(volatile uint32_t *)(g + SMMU_SMR_OFF(n)) == K1_GPU_SMR) {
+			uint32_t cb = *(volatile uint32_t *)(g + SMMU_S2CR_OFF(n)) & 0xffU;
+			k1_cb = ml_io_map(K1_SMMU_PA + 0x1000UL * (num_global + cb), 0x1000);
+			printf("SWEET K1: GPU context: smr %u cb %u (num_global %u)\n", n, cb, num_global);
+			return k1_cb != 0;
+		}
+	}
+	printf("SWEET K1: no SMR with %#x (shim GPU context missing)\n", K1_GPU_SMR);
+	return 0;
+}
+
+static int k1_write_and_check(uint64_t va, uint32_t magic, uint64_t ib_va, volatile uint32_t *ib)
+{
+	uint32_t n = 0;
+	ib[n++] = cp_type7(CP_OP_MEM_WRITE, 3);
+	ib[n++] = (uint32_t)(va + 0x10);
+	ib[n++] = (uint32_t)((va + 0x10) >> 32);
+	ib[n++] = magic;
+	__asm__ volatile("dsb sy" ::: "memory");
+	return sweet_gpu_submit(&ib_va, &n, 1) != 0;
+}
+
+static void k1_selftest(void)
+{
+	int on = 0;
+	(void)PE_parse_boot_argn("sweetk1", &on, sizeof(on));
+	if (!on)
+		return;
+	sl_k1 = ml_io_map(SL_K1_PA, SL_K1_LEN);
+	if (!sl_k1 || !k1_find_cb()) {
+		printf("SWEET K1: setup failed (slice %#lx cb %#lx)\n", (unsigned long)sl_k1, (unsigned long)k1_cb);
+		return;
+	}
+	k1_free[0].start = K1_VA_BASE;
+	k1_free[0].size = K1_VA_SIZE;
+	k1_nfree = 1;
+	volatile uint32_t *pa_a = (volatile uint32_t *)k1p(K1_TEST_PA);
+	volatile uint32_t *pa_b = (volatile uint32_t *)k1p(K1_TEST_PA + 0x1000);
+	volatile uint32_t *ibp = (volatile uint32_t *)k1p(K1_TEST_PA + 0x2000);
+	for (unsigned i = 0; i < 0x1000 / 4; i++) {
+		pa_a[i] = 0;
+		pa_b[i] = 0;
+	}
+	uint64_t ibva = sweet_gpu_address(0x1000), v = sweet_gpu_address(0x1000);
+	int ok1 = ibva && v && sweet_gpu_map(ibva, K1_TEST_PA + 0x2000, 1) && sweet_gpu_map(v, K1_TEST_PA, 0);
+	sweet_gpu_mapped();
+	int w1 = ok1 && k1_write_and_check(v, 0x0001a001U, ibva, ibp);
+	printf("SWEET K1: map+submit va %#llx ib %#llx: fence %s, page A = %#x (want 0x1a001)\n",
+	    v, ibva, w1 ? "ok" : "MISSING", pa_a[4]);
+	int tlb = sweet_gpu_unmap(v, 0x1000);
+	printf("SWEET K1: unmap + TLB maintenance on the GPU context: %s\n", tlb ? "ok" : "TIMEOUT");
+	sweet_gpu_map(v, K1_TEST_PA + 0x1000, 0);
+	sweet_gpu_mapped();
+	int w2 = k1_write_and_check(v, 0x0001a002U, ibva, ibp);
+	printf("SWEET K1: same va on page B: fence %s, B = %#x (want 0x1a002), A = %#x (want 0x1a001)\n",
+	    w2 ? "ok" : "MISSING", pa_b[4], pa_a[4]);
+	sweet_gpu_unmap(v, 0x1000);
+	sweet_gpu_unmap(ibva, 0x1000);
+	sweet_gpu_address_free(v, 0x1000);
+	sweet_gpu_address_free(ibva, 0x1000);
+	int pass = w1 && w2 && tlb && pa_a[4] == 0x0001a001U && pa_b[4] == 0x0001a002U;
+	printf("SWEET K1: %s (free list %u hole(s), first %#llx size %#llx, hwfault %#x)\n",
+	    pass ? "K1a PASS -- dynamic GPU maps, TLB maintenance and IB submit work" : "K1a FAILED",
+	    k1_nfree, k1_free[0].start, k1_free[0].size, grd(A6XX_CP_HW_FAULT));
+}
+
 static void sweet_gpu_thread(void *arg, wait_result_t result)
 {
 	unsigned delay_s = 8;
@@ -432,6 +677,7 @@
 	    grd(A6XX_CP_HW_FAULT), good, G4_CHECK_ROWS * 252U);
 	if (drew == 1 && good == G4_CHECK_ROWS * 252U)
 		printf("SWEET GPU4: THE GPU DREW THE PANEL FROM XNU -- gradient in the top-left corner\n");
+	k1_selftest();
 out:
 	printf("SWEET GPU4: thread exiting\n");
 	thread_terminate(current_thread());
