+	case 0x05:			/* TIMESTAMP */
+		*value = mach_absolute_time();
+		return true;
+	case 0x07:			/* PRIORITIES */
+		*value = 1;
+		return true;
+	case 0x10:			/* HIGHEST_BANK_BIT */
+		*value = 15;
+		return true;
+	case 0x12:			/* UBWC_SWIZZLE */
+		*value = 6;
+		return true;
+	default:			/* MAX_FREQ (0x04), VA_START/VA_SIZE (0x0e/0x0f, as HackiOS without gpu_va), ... */
+		return false;
+	}
+}
