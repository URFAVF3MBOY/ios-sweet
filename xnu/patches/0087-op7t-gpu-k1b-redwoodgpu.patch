+	sweet_gpu_address_free(address, size);
+}
+
+void redwood_gpu_space(uint64_t *used, uint32_t *live, uint64_t *largest, unsigned *holes, unsigned *most,
+    uint64_t *lost, uint32_t *refused)
+{
+	uint64_t free_bytes = 0, big = 0;
+	for (unsigned i = 0; i < k1_nfree; i++) {
+		free_bytes += k1_free[i].size;
+		if (k1_free[i].size > big)
+			big = k1_free[i].size;
+	}
+	*used = K1_VA_SIZE - free_bytes;
+	*live = 0;
+	*largest = big;
+	*holes = k1_nfree;
+	*most = 64;
+	*lost = (uint64_t)k1_lost << 12;
+	*refused = 0;
+}
+
+bool redwood_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	return sweet_gpu_map(address, phys, read_only ? 1 : 0) != 0;
+}
+
+void redwood_gpu_mapped(void)
+{
+	sweet_gpu_mapped();
+}
+
+void redwood_gpu_unmap(uint64_t address, uint64_t size)
+{
+	if (!sweet_gpu_unmap(address, size))
+		printf("SWEET K1: TLB maintenance timed out unmapping %#llx+%#llx\n", address, size);
+}
+
+/* push what this processor wrote out of its cache (HackiOS to_memory); (NULL, 0): a barrier */
+void redwood_gpu_to_memory(void *start, uint64_t size)
+{
+	vm_offset_t s = (vm_offset_t)start;
+	for (vm_offset_t line = s & ~(vm_offset_t)63; line < s + size; line += 64)
+		__asm__ volatile("dc civac, %0" : : "r"(line) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* HackiOS redwood_gpu_submit: returns the submission's number; 0 = the ring stayed full (2 s) */
+uint32_t redwood_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	volatile uint32_t *ring = gva32(GPU_VA_RB);
+	uint32_t n = 0, w, room = 0;
+	if (!k1b_on || count == 0 || count > 128)
+		return 0;
+	int stale = k1_uche_stale;
+	if (stale) {
+		k1b_ring[n++] = cp_type7(CP_OP_EVENT_WRITE, 1); k1b_ring[n++] = EV_CACHE_INVALIDATE;
+	}
+	k1b_ring[n++] = cp_type7(CP_OP_EVENT_WRITE, 1); k1b_ring[n++] = EV_CCU_INV_DEPTH;
+	k1b_ring[n++] = cp_type7(CP_OP_EVENT_WRITE, 1); k1b_ring[n++] = EV_CCU_INV_COLOR;
+	for (uint32_t i = 0; i < count; i++) {
+		k1b_ring[n++] = cp_type7(CP_OP_INDIRECT_BUFFER_PFE, 3);
+		k1b_ring[n++] = (uint32_t)addresses[i];
+		k1b_ring[n++] = (uint32_t)(addresses[i] >> 32);
+		k1b_ring[n++] = words[i];
+	}
+	uint32_t next = k1b_fence + 1 ? k1b_fence + 1 : 1;
+	k1b_ring[n++] = cp_type7(CP_OP_EVENT_WRITE, 4);
+	k1b_ring[n++] = EV_CACHE_FLUSH_TS;
+	k1b_ring[n++] = GPU_VA_SCR + K1B_FENCE_OFF;
+	k1b_ring[n++] = 0;
+	k1b_ring[n++] = next;
+	w = grd(A6XX_CP_RB_WPTR) & (K1B_RING_WORDS - 1U);
+	for (int i = 0; i < 20000; i++) {
+		room = (grd(A6XX_CP_RB_RPTR) - w - 1U) & (K1B_RING_WORDS - 1U);
+		if (room >= n + 4U)
+			break;
+		delay(100);
+	}
+	if (room < n + 4U)
+		return 0;
+	if (stale)
+		k1_uche_stale = 0;
+	for (uint32_t i = 0; i < n; i++)
+		ring[(w + i) & (K1B_RING_WORDS - 1U)] = k1b_ring[i];
+	__asm__ volatile("dsb sy" ::: "memory");
+	gwrr(A6XX_CP_RB_WPTR, (w + n) & (K1B_RING_WORDS - 1U));
+	k1b_fence = next;
+	return next;
+}
+
+bool redwood_gpu_done(uint32_t fence)
+{
+	volatile uint32_t *word = gva32(GPU_VA_SCR + K1B_FENCE_OFF);
+	return (int32_t)(*word - fence) >= 0;
+}
+
+uint32_t redwood_gpu_last(void)
+{
+	return k1b_fence;
+}
+
+void redwood_gpu_worked(uint64_t *microseconds, uint32_t *submissions, uint32_t by[7])
+{
+	*microseconds = 0;
+	*submissions = 0;
+	for (int i = 0; i < 7; i++)
+		by[i] = 0;
+}
+
+/* a submission did not come back: what the core and its (own) SMMU context say */
+void redwood_gpu_report(const char *why)
+{
+	uint32_t fsr = k1_cb ? *(volatile uint32_t *)(k1_cb + SMMU_CB_FSR) : 0;
+	uint64_t far = k1_cb ? *(volatile uint64_t *)(k1_cb + SMMU_CB_FAR) : 0;
+	printf("SWEET K1: GPU %s: fence %#x of %#x, rptr %#x wptr %#x rbbm %#x hwfault %#x cpint %#x, "
+	    "smmu fsr %#x far %#llx\n", why, *gva32(GPU_VA_SCR + K1B_FENCE_OFF), k1b_fence,
+	    grd(A6XX_CP_RB_RPTR), grd(A6XX_CP_RB_WPTR), grd(A6XX_RBBM_STATUS), grd(A6XX_CP_HW_FAULT),
+	    grd(A6XX_CP_INTERRUPT_STATUS), fsr, far);
+}
+
+bool redwood_gpu_recover(void)
+{
+	return false;
+}
+
+void redwood_gpu_stop(void)
+{
+	k1b_on = 0;
+}
+
+/* boot-arg sweetk1b=1: TCR2, the fence word, the RedwoodGPU service; sweetk1b=2 also its self-test */
+static void k1b_start(void)
+{
+	int on = 0;
+	(void)PE_parse_boot_argn("sweetk1b", &on, sizeof(on));
+	if (!on)
+		return;
+	k1_probe();				/* (no-op when sweetk1=1 ran it) */
+	if (!k1_probed || !k1_setup(1)) {
+		printf("SWEET K1B: K1 setup failed: no RedwoodGPU\n");
+		return;
+	}
+	*gva32(GPU_VA_SCR + K1B_FENCE_OFF) = 0;
+	k1b_fence = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	k1b_on = 1;
+	if (on >= 2)
+		(void)RedwoodGPUSelfTest();
+	RedwoodGPUStart();
+}
