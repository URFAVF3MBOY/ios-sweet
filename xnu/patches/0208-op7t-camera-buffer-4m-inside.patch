op7t-0208: camera buffer: 4 MiB contiguous, use the 2 MiB-aligned half inside

0207's stages (2026-11-12): stage 1 (PLLs, all capture clocks) fine; stage
2, the 2 MiB-aligned buffer, FROZE the phone: kmem_alloc_contig with
pnum_mask = atop(2 MiB) - 1 (0206) hangs. Now 4 MiB contiguous with page
alignment (as the audio / test-pattern buffers, which work) and the 2 MiB
at the first 2 MiB boundary inside it for the SMMU window.

Apply after 0207.
---
diff --git a/bsd/dev/sweet_smmu.c b/bsd/dev/sweet_smmu.c
index a620882..7cdadf8 100644
--- a/bsd/dev/sweet_smmu.c
+++ b/bsd/dev/sweet_smmu.c
@@ -469,23 +469,28 @@ sweet_cam_dma_buffer_2m(uint64_t *pa, vm_offset_t *va)
 {
 	vm_offset_t kva = 0;
 	ppnum_t pn;
-	uint64_t p;
-
-	/* 0206: physical alignment is pnum_mask (in pages); mask only aligns the virtual address */
-	if (kmem_alloc_contig(kernel_map, &kva, 0x200000, PAGE_MASK, (ppnum_t)(atop(0x100000000ull) - 1),
-	    (ppnum_t)(atop(0x200000ull) - 1), KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+	uint64_t p, aligned;
+
+	/*
+	 * 0208: asking kmem_alloc_contig for 2 MiB physical alignment (pnum_mask, 0206) froze the phone (0207 stage
+	 * 2, 2026-11-12). Instead: 4 MiB contiguous with plain page alignment (what the audio and test-pattern
+	 * buffers use), and the 2 MiB-aligned 2 MiB that always lies inside it.
+	 */
+	if (kmem_alloc_contig(kernel_map, &kva, 0x400000, PAGE_MASK, (ppnum_t)(atop(0x100000000ull) - 1), 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
 		return ENOMEM;
 	}
 	pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
 	p = ptoa_64(pn);
-	if (pn == 0 || (p & 0x1fffffull) != 0 || p < 0x80000000ull || p + 0x200000ull > 0x100000000ull) {
+	aligned = (p + 0x1fffffull) & ~0x1fffffull;
+	if (pn == 0 || p < 0x80000000ull || aligned + 0x200000ull > p + 0x400000ull || aligned + 0x200000ull > 0x100000000ull) {
 		return ERANGE;
 	}
-	*va = ml_io_map((vm_offset_t)p, 0x200000);
+	*va = ml_io_map((vm_offset_t)aligned, 0x200000);
 	if (*va == 0) {
 		return ENOMEM;
 	}
-	*pa = p;
+	*pa = aligned;
 	return 0;
 }
 
