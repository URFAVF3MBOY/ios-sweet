+			if (strlcpy(env, "DYLD_INSERT_LIBRARIES=", size) >= size) {
+				return false;
+			}
+			if (nlen < len) {               /* 0112: NAME=LIB */
+				size_t have = strlen(env), want = len - nlen - 1;
+				if (want == 0 || have + want + 1 > size) {
+					return false;
+				}
+				memcpy(env + have, at + nlen + 1, want);
+				env[have + want] = '\0';
+			} else if (strlcat(env, lib, size) >= size) {
 				return false;
 			}
 			return true;
