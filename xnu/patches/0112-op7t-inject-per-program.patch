 	size_t namelen;
 
@@ -5599,12 +5601,25 @@ sweet_inject_env(struct image_params *imgp, char *env, size_t size)
 	for (at = names; *at != '\0';) {
 		size_t len = 0;
 
+		size_t nlen;
+
 		while (at[len] != '\0' && at[len] != ',') {
 			len++;
 		}
-		if (len == namelen && strncmp(at, name, len) == 0) {
