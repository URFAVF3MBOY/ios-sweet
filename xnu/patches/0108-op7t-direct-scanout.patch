 static uint64_t      sweet_surface_wired;       /* bytes of buffer surfaces */
 #define SWEET_SURFACE_WIRED_MAX         (1536ull << 20)
 
+/*
+ * OnePlus 7T, direct scanout (0108, boot-arg sweetscan=1|2): backboardd's full-screen surfaces
+ * come from a pool of contiguous RAM below 4 GiB that the kernel does not manage, so that
+ * AppleCLCD can point the display's source pipes straight at them instead of copying every frame
+ * into the splash buffer (topaz patches 0092-0103 do the same on SM6225). The display fetches
+ * 32-bit addresses only; iOS's own memory is all above 4 GiB on the 7T.
+ * Pool: 14 slots of 0xD40000 (13.25 MiB: one 1125x2436 BGRA surface, 4544 bytes a row,
+ * IOSurfaceAllocSize 13893632): 8 at 0xB1000000-0xB7A00000, 3 at 0xAD000000-0xAF7C0000, 3 at
+ * 0xB9000000-0xBB7C0000 (the low DDR bank ends at 0xBBB00000). Clear of the GPU's
+ * 0xB0000000-0xB0530000, USB's 0xB0800000, 0096's modem pool 0xB8000000-0xB9000000 and everything in
+ * the 7T DT's reserved-memory (mtp_mem ends 0xACE00000). First boot (8 slots): backboardd keeps
+ * about 9 full-screen surfaces in turn, so every 7th frame missed the pool and was copied.
+ * Mapped write-combined everywhere (as the splash surface): no cache upkeep before the display
+ * reads it. A surface that does not fit, or once the pool is full, is made as before.
+ */
+#define SWEET_SCAN_SLOT                 0x00D40000ull
+#define SWEET_SCAN_SLOTS                14
+static uint64_t
+sweet_scan_slot_pa(uint32_t i)
+{
+	if (i < 8) {
+		return 0xB1000000ull + i * SWEET_SCAN_SLOT;
+	}
+	if (i < 11) {
+		return 0xAD000000ull + (i - 8) * SWEET_SCAN_SLOT;
+	}
+	return 0xB9000000ull + (i - 11) * SWEET_SCAN_SLOT;
+}
+static uint32_t      sweet_scan_mode = ~0u;     /* boot-arg sweetscan, read once */
+static uint32_t      sweet_scan_used;           /* bit per slot, under sweet_surface_lock */
+static uint32_t      sweet_scan_logged;
+
+static bool
+sweet_scan_wanted(const SweetSurface *s, const char *proc)
+{
+	if (sweet_scan_mode == ~0u) {
+		uint32_t m = 0;
+		PE_parse_boot_argn("sweetscan", &m, sizeof(m));
+		sweet_scan_mode = m;
+	}
+	return sweet_scan_mode != 0 && strcmp(proc, "backboardd") == 0 &&
+	       s->width == 1125 && s->height == 2436 && s->pixelFormat == 'BGRA' &&
+	       s->bytesPerElement == 4 && s->planeCount == 0 && s->allocSize <= SWEET_SCAN_SLOT;
+}
+
+/* a free slot (1-based), or 0 */
+static uint32_t
+sweet_scan_take(void)
+{
+	uint32_t slot = 0;
+	IOLockLock(sweet_surface_lock);
+	for (uint32_t i = 0; i < SWEET_SCAN_SLOTS; i++) {
+		if (!(sweet_scan_used & (1u << i))) {
+			sweet_scan_used |= 1u << i;
+			slot = i + 1;
+			break;
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return slot;
+}
+
+uint64_t
+sweet_surface_scan_phys(SweetSurface *s)
+{
+	return (s != NULL && s->scanSlot != 0) ? sweet_scan_slot_pa(s->scanSlot - 1) : 0;
+}
