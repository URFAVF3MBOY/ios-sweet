+/* ---------------------------------------------------------------- 0108 direct scanout */
+
+#define MDSS_VIG0_PA    0x0AE05000u     /* downstream DT qcom,sde-sspp-off 0x5000 (VIG0), 0x7000 (VIG1) */
+#define MDSS_VIG1_PA    0x0AE07000u
+#define MDSS_CTL0_PA    0x0AE02000u     /* qcom,sde-ctl-off 0x2000 */
+#define SSPP_SRC_XY     0x08
+#define SSPP_SRC0_ADDR  0x14
+#define SSPP_YSTRIDE0   0x24
+#define CTL_FLUSH       0x18
+#define CTL_FLUSH_VIGS  0x20003u        /* VIG0 bit 0, VIG1 bit 1, CTL bit 17 */
+
+void
+AppleCLCD::scanSetup(void)
+{
+	PE_parse_boot_argn("sweetscan", &fScanMode, sizeof(fScanMode));
+	if (fScanMode == 0) {
+		return;
+	}
+	fVig0 = (volatile uint32_t *)ml_io_map(MDSS_VIG0_PA, 0x1000);
+	fVig1 = (volatile uint32_t *)ml_io_map(MDSS_VIG1_PA, 0x1000);
+	fCtl0 = (volatile uint32_t *)ml_io_map(MDSS_CTL0_PA, 0x1000);
+	if (fVig0 == NULL || fVig1 == NULL || fCtl0 == NULL) {
+		IOLog("SWEET SCAN: display registers not mapped: off\n");
+		fScanMode = 0;
+		return;
+	}
+	fBootAddr = fVig0[SSPP_SRC0_ADDR / 4];
+	fBootStride = fVig0[SSPP_YSTRIDE0 / 4];
+	fBootXY0 = fVig0[SSPP_SRC_XY / 4];
+	fBootXY1 = fVig1[SSPP_SRC_XY / 4];
+	IOLog("SWEET SCAN: mode %u; ABL: VIG0 0x%x stride %u xy 0x%x size 0x%x img 0x%x, VIG1 0x%x xy 0x%x, CTL0 top 0x%x\n",
+	    fScanMode, fBootAddr, fBootStride, fBootXY0, fVig0[0], fVig0[1], fVig1[SSPP_SRC0_ADDR / 4], fBootXY1,
+	    fCtl0[0x14 / 4]);
+	if (fBootAddr != (uint32_t)fPhys || fVig1[SSPP_SRC0_ADDR / 4] != (uint32_t)fPhys || fBootXY0 != 0 ||
+	    fBootXY1 != fWidth / 2 || fBootStride != fRowBytes) {
+		IOLog("SWEET SCAN: the display is not set up as on the 2026-10-24 probe (splash 0x%llx): off\n", fPhys);
+		fScanMode = 0;
+	}
+}
+
+void
+AppleCLCD::scanTo(uint32_t addr, uint32_t stride, uint32_t xy0, uint32_t xy1)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");       /* the pixels before the switch */
+	fVig0[SSPP_SRC0_ADDR / 4] = addr;
+	fVig0[SSPP_YSTRIDE0 / 4] = stride;
+	fVig0[SSPP_SRC_XY / 4] = xy0;
+	fVig1[SSPP_SRC0_ADDR / 4] = addr;
+	fVig1[SSPP_YSTRIDE0 / 4] = stride;
+	fVig1[SSPP_SRC_XY / 4] = xy1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fCtl0[CTL_FLUSH / 4] = CTL_FLUSH_VIGS;          /* taken at the next refresh; never CTL_START */
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+void
+AppleCLCD::scanSplash(void)
+{
+	scanTo(fBootAddr, fBootStride, fBootXY0, fBootXY1);
+	OSSafeReleaseNULL(fScanned);
+	if (fScanCopies++ < 8 || (fScanCopies % 500) == 0) {
+		IOLog("SWEET SCAN: a frame copied (%u so far), %u flipped\n", fScanCopies, fScanFlips);
+	}
+}
+
+/* One full-screen layer, from the scanout pool: point the pipes at it. False: copy as before. */
+bool
+AppleCLCD::scanPresent(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104), layer = SWEET_FB_LAYERS, n = 0;
+
+	if (fScanMode == 0 || fPowerOff) {
+		return false;
+	}
+	for (uint32_t i = 0; i < SWEET_FB_LAYERS; i++) {
+		if ((mask & (1u << i)) && get32(rec, 0x54 + 4 * i) != 0) {
+			layer = i;
+			n++;
+		}
+	}
+	if (n != 1) {
+		return false;
+	}
+	const uint8_t *a = rec + 0x64 + 16 * layer, *b = rec + 0xc4 + 16 * layer;
+	uint32_t bw = get32(b, 8), bh = get32(b, 12);
+	if (get32(a, 0) != 0 || get32(a, 4) != 0 || get32(b, 0) != 0 || get32(b, 4) != 0 ||
+	    !((bw == fLogicalW && bh == fLogicalH) || (bw == 0 && bh == 0))) {
+		return false;
+	}
+	SweetSurface *s = sweet_surface_copy(get32(rec, 0x54 + 4 * layer));
+	uint64_t pa = sweet_surface_scan_phys(s);
+	if (pa == 0 || s->width != fLogicalW || s->height != fLogicalH || s->offset != 0 ||
+	    s->bytesPerRow < fLogicalW * 4 || (s->bytesPerRow & 63) != 0 ||
+	    pa + (uint64_t)s->bytesPerRow * s->height > 0x100000000ull) {
+		OSSafeReleaseNULL(s);
+		return false;
+	}
+	(void)RedwoodGPUSurfaceReady(s, 100);           /* the GPU done drawing it (at most 100 ms) */
+	uint32_t row0 = (uint32_t)(pa + (uint64_t)fOffY * s->bytesPerRow);
+	if (fScanMode == 2) {
+		scanTo(row0 + (uint32_t)fOffX * 4, s->bytesPerRow, fBootXY0, fBootXY1);
+	} else {
+		scanTo(row0, s->bytesPerRow, fBootXY0 + (uint32_t)fOffX, fBootXY1 + (uint32_t)fOffX);
+	}
+	if (fScanFlips++ < 8 || (fScanFlips % 1000) == 0) {
+		IOLog("SWEET SCAN: flip %u: surface %u at 0x%llx (mode %u)\n", fScanFlips, s->id, pa, fScanMode);
+	}
+	if (fScanned != NULL) {
+		fScanned->release();            /* (the display may fetch it one more refresh: a slot is
+		                                 * only reused once its surface is freed by backboardd) */
+	}
+	fScanned = s;                           /* held while shown */
+	return true;
+}
+
 static uint64_t sweet_fb_logged;        /* selectors already logged (< 64) */
 
