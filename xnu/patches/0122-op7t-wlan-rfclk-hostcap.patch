+extern "C" int sweet_rpmh_clk_enable(const char *res, unsigned unused);      /* 0122 */
 
 #define AOP_MSGRAM_PA       0x0C300000ull
 #define AOP_MSGRAM_SIZE     0x1000u
@@ -5789,6 +5801,22 @@
 		e = vote_retry(sweet_rpmh_vreg_enable, wlan_rails[i].res, wlan_rails[i].mv);
 		LOG("rpmh: WCN3990 rail %s %u mV: %d", wlan_rails[i].res, wlan_rails[i].mv, e);
