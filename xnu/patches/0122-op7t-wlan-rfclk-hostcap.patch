+	/*
+	 * 0122: the WCN3990's reference clock. Mainline sm8150.dtsi gives the Wi-Fi node
+	 * clocks = <&rpmhcc RPMH_RF_CLK2> ("cxo_ref_clk_pin"), which ath10k_snoc switches on with the
