diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -13,6 +13,7 @@
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
 int sweet_rpmh_arc_level(const char *res, unsigned vlvl);
+int sweet_rpmh_clk_enable(const char *res, unsigned unused);
 
 /* Live downstream DT has two positional reg entries, no reg-names. */
 #define RH_RSC_PA       0x18220000u
@@ -436,5 +437,43 @@
 	}
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
+}
+/*
+ * 0122: an RPMh clock vote (Linux clk-rpmh DEFINE_CLK_RPMH_VRM, sm8150 "rfclka2" = RPMH_RF_CLK2):
+ * a VRM resource in cmd-db, switched on by writing 1 at +4 (CLK_RPMH_VRM_EN_OFFSET). Only the
+ * WCN3990's reference clock; only ever switched on.
+ */
+int
+sweet_rpmh_clk_enable(const char *res, unsigned unused)
+{
+	(void)unused;
+	if (!res || strcmp(res, "rfclka2")) {
+		printf("HOTDOGB RPMH: clock vote only for rfclka2\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("HOTDOGB RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, RH_VRM, &address, NULL, NULL);
+	}
+	if (!error) {
+		const uint32_t offsets[1] = {4};
+		const uint32_t values[1] = {1};
+		error = rh_send(address, 1, offsets, values);
+	}
+out:
+	if (error) {
+		printf("HOTDOGB RPMH: %s clock vote failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
 }
 #endif /* ARM64_BOARD_CONFIG_SWEET */
