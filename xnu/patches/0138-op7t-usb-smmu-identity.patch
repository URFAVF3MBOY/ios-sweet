From: fish <lunarisfelix02@gmail.com>
Date: Sun, 25 Oct 2026 05:00:00 +0000
Subject: [PATCH] op7t-0138: identity-mapped SMMU context bank for USB (bypass is refused)

Boot with sweetusb=2, 2026-10-25 (sweet-log.txt): 0133 wrote S2CR TYPE 1
(bypass) for SID 0x140 and it read back as TYPE 2 (fault): Qualcomm's
hypervisor does not let the OS bypass the SMMU, so USB was not started.
Now, as Linux arm-smmu does when a device attaches: a free stage-1 AArch64
context bank whose page table (one level-1 table at 0xb07ff000, free scratch
RAM, mapped Normal non-cacheable) maps 0x80000000-0xffffffff to itself in two
1 GiB blocks, so the DMA addresses the USB driver programs (physical, in the
low DDR bank) keep working; faults abort the transfer, no stall, no IRQ.
Every register is read back; a bank the hypervisor refuses is put back and
the next tried. USB start-up uses it by default (sweetusbsmmu=1; 2 = 0133's
bypass, 0 = nothing). By hand: sysctl kern.sweetsmmu_map=0x140, then
sysctl kern.sweetsmmu shows the bank. Log: "HOTDOGB SMMU: bank ...".
sweet_smmu.c was syntax-checked with clang -Wall -Wextra on stub headers.

Apply after 0137.
---
 bsd/dev/sweet_smmu.c | 183 +++++++++++++++++++++++++++++++++++++++++++++++++++
 bsd/dev/sweet_usb.c  |  16 +++--
 2 files changed, 193 insertions(+), 6 deletions(-)

diff --git a/bsd/dev/sweet_smmu.c b/bsd/dev/sweet_smmu.c
index fa135d8..f487d1a 100755
--- a/bsd/dev/sweet_smmu.c
+++ b/bsd/dev/sweet_smmu.c
@@ -18,8 +18,10 @@
 
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <kern/kalloc.h>
+#include <kern/clock.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);
 
 #define SMMU_PA         0x15000000u
 #define SMMU_SIZE       0x00100000u
@@ -186,6 +188,187 @@ sysctl_sweetsmmu_bypass SYSCTL_HANDLER_ARGS
 	return smmu_bypass_last >= 0 ? 0 : EIO;
 }
 
+/*
+ * 0138: a translating context bank for a stream ID, mapping DMA addresses to the same physical
+ * addresses, for USB. 0133's bypass is refused on the 7T: the S2CR written as TYPE 1 reads back
+ * as TYPE 2 (fault) -- Qualcomm's hypervisor does not let the OS bypass the SMMU (boot
+ * 2026-10-25, sweet-log.txt: "SMR[93] 80000140 S2CR 00020000: bypass NOT taken"). This is what
+ * Linux's arm-smmu does when it attaches a device, reduced to a fixed identity map:
+ *   one 4 KiB level-1 table at SMMU_PT_PA (free scratch RAM, below USB's 0xb0800000; the GPU's
+ *   scratch slices end at 0xb0530000), mapped write-combined (Normal non-cacheable) so no cache
+ *   maintenance is needed and the walks are non-cacheable too; two 1 GiB blocks, identity,
+ *   0x80000000-0xffffffff (all of the low DDR bank: USB's DMA area 0xb0800000, ABL's event
+ *   buffer 0xffaf9000), Normal non-cacheable, read/write;
+ *   a free context bank (no valid SMR's translating S2CR points at it, SCTLR.M clear), AArch64
+ *   stage 1 (CBA2R.VA64, CBAR type 1), T0SZ 25 (39-bit, walk starts at level 1), 4K granule,
+ *   TTBR1 walks off, MAIR attr 0 = 0x44; SCTLR M|TRE|AFE|CFRE|ASIDPNE: a fault aborts the
+ *   transfer (no stall) and raises no interrupt (nothing would handle it);
+ *   then S2CR (translate, CBNDX) and SMR (valid, SID, mask 0), as arm_smmu_write_sme does.
+ * Every write is read back; a bank the hypervisor does not let us have is put back and the next
+ * one tried. kern.sweetsmmu shows the result (bank registers, FSR/FAR after a fault).
+ */
+#define SMMU_PT_PA      0xb07ff000u
+#define CB_SCTLR        0x00
+#define CB_TCR2         0x10
+#define CB_TTBR0        0x20
+#define CB_TTBR1        0x28
+#define CB_TCR          0x30
+#define CB_MAIR0        0x38
+#define CB_MAIR1        0x3c
+#define CB_FSR          0x58
+#define CB_TLBIALL      0x618
+#define CB_TLBSYNC      0x7f0
+#define CB_TLBSTATUS    0x7f4
+
+int sweet_smmu_identity(uint32_t sid);
+static int smmu_identity_last = -1;
+static vm_offset_t smmu_pt;
+
+static void
+smmu_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(smmu + off) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+smmu_cb_setup(uint32_t pagesize, uint32_t cbo, uint32_t cb, uint32_t pasize)
+{
+	uint64_t ttbr0 = (uint64_t)SMMU_PT_PA | ((uint64_t)cb << 48);           /* ASID = bank */
+	uint32_t sctlr = (1u << 0) | (1u << 1) | (1u << 2) | (1u << 5) | (1u << 12);  /* M TRE AFE CFRE ASIDPNE */
+
+	smmu_wr(cbo + CB_SCTLR, 0);
+	smmu_wr(pagesize + 0x800 + 4 * cb, 1u);                                 /* CBA2R: VA64 */
+	smmu_wr(pagesize + 4 * cb, (1u << 16) | (3u << 8) | (0xfu << 12));     /* CBAR: S1, S2 bypass */
+	smmu_wr(cbo + CB_TCR2, (pasize & 7u) | (7u << 15));                    /* PASize, SEP upstream */
+	smmu_wr(cbo + CB_TTBR0, (uint32_t)ttbr0);
+	smmu_wr(cbo + CB_TTBR0 + 4, (uint32_t)(ttbr0 >> 32));
+	smmu_wr(cbo + CB_TTBR1, 0);
+	smmu_wr(cbo + CB_TTBR1 + 4, 0);
+	smmu_wr(cbo + CB_TCR, 25u | (1u << 23));                                /* T0SZ 25, 4K, NC walks, EPD1 */
+	smmu_wr(cbo + CB_MAIR0, 0x44u);
+	smmu_wr(cbo + CB_MAIR1, 0);
+	smmu_wr(cbo + CB_FSR, smmu_rd(cbo + CB_FSR));                           /* clear old faults */
+	smmu_wr(cbo + CB_TLBIALL, 0);
+	smmu_wr(cbo + CB_TLBSYNC, 0);
+	for (int i = 0; i < 1000 && (smmu_rd(cbo + CB_TLBSTATUS) & 1u); i++) {
+		delay(1);
+	}
+	smmu_wr(cbo + CB_SCTLR, sctlr);
+
+	bool ok = smmu_rd64(cbo + CB_TTBR0) == ttbr0 && (smmu_rd(cbo + CB_SCTLR) & 1u) &&
+	    (smmu_rd(cbo + CB_TCR) & 0x3fu) == 25u && ((smmu_rd(pagesize + 4 * cb) >> 16) & 3u) != 0;
+	printf("HOTDOGB SMMU: bank %u: CBAR %08x CBA2R %08x TCR %08x TCR2 %08x TTBR0 %016llx MAIR0 %08x SCTLR %08x: %s\n", cb,
+	    smmu_rd(pagesize + 4 * cb), smmu_rd(pagesize + 0x800 + 4 * cb), smmu_rd(cbo + CB_TCR), smmu_rd(cbo + CB_TCR2),
+	    (unsigned long long)smmu_rd64(cbo + CB_TTBR0), smmu_rd(cbo + CB_MAIR0), smmu_rd(cbo + CB_SCTLR),
+	    ok ? "taken" : "NOT taken");
+	if (!ok) {
+		smmu_wr(cbo + CB_SCTLR, 0);
+	}
+	return ok;
+}
+
+int
+sweet_smmu_identity(uint32_t sid)
+{
+	if (sid > 0x7fffu) {
+		return -1;
+	}
+	if (smmu == 0) {
+		smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+		if (smmu == 0) {
+			return -1;
+		}
+	}
+	if (smmu_pt == 0) {
+		smmu_pt = ml_io_map_wcomb(SMMU_PT_PA, 0x1000);
+		if (smmu_pt == 0) {
+			return -1;
+		}
+		volatile uint64_t *l1 = (volatile uint64_t *)smmu_pt;
+		for (unsigned i = 0; i < 512; i++) {
+			l1[i] = 0;
+		}
+		/* 1 GiB blocks: PA | AF | SH outer | AP RW (any) | AttrIndx 0 | block */
+		for (unsigned i = 2; i < 4; i++) {
+			l1[i] = ((uint64_t)i << 30) | (1u << 10) | (2u << 8) | (1u << 6) | 1u;
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+
+	uint32_t idr0 = smmu_rd(0x20), idr1 = smmu_rd(0x24), idr2 = smmu_rd(0x28);
+	uint32_t nsmr = MIN(idr0 & 0xffu, 128u), ncb = MIN(idr1 & 0xffu, 128u);
+	uint32_t pagesize = (idr1 & (1u << 31)) ? 0x10000u : 0x1000u;
+	uint32_t cb_base = (1u << (((idr1 >> 28) & 7u) + 1u)) * pagesize;
+	uint32_t pasize = MIN((idr2 >> 4) & 0xfu, 2u);                          /* OAS, at most 40 bits */
+	uint8_t used[128] = {};
+	int smr_i = -1, free_smr = -1;
+
+	for (uint32_t i = 0; i < nsmr; i++) {
+		uint32_t smr = smmu_rd(0x800 + 4 * i), s2cr = smmu_rd(0xc00 + 4 * i);
+		uint32_t id = smr & 0x7fffu, mask = (smr >> 16) & 0x7fffu;
+		if (!(smr & (1u << 31))) {
+			free_smr = (int)i;
+			continue;
+		}
+		if (((s2cr >> 16) & 3u) == 0 && (s2cr & 0xffu) < 128) {
+			used[s2cr & 0xffu] = 1;
+		}
+		if (((sid ^ id) & ~mask & 0x7fffu) == 0) {
+			smr_i = (int)i;                 /* ours from before (0133's fault entry): reuse it */
+		}
+	}
+	if (smr_i < 0) {
+		smr_i = free_smr;
+	}
+	if (smr_i < 0) {
+		printf("HOTDOGB SMMU: no free SMR for SID %#x\n", sid);
+		return -1;
+	}
+	int cb = -1;
+	unsigned tries = 0;
+	for (int n = (int)ncb - 1; n >= 0 && tries < 8; n--) {
+		uint32_t cbo = cb_base + (uint32_t)n * pagesize;
+		if (used[n] || cbo + pagesize > SMMU_SIZE || (smmu_rd(cbo + CB_SCTLR) & 1u)) {
+			continue;
+		}
+		tries++;
+		if (smmu_cb_setup(pagesize, cbo, (uint32_t)n, pasize)) {
+			cb = n;
+			break;
+		}
+	}
+	if (cb < 0) {
+		printf("HOTDOGB SMMU: SID %#x: no context bank could be set up (%u tried)\n", sid, tries);
+		return -1;
+	}
+	smmu_wr(0xc00 + 4 * (uint32_t)smr_i, (uint32_t)cb);                     /* S2CR: translate, bank */
+	smmu_wr(0x800 + 4 * (uint32_t)smr_i, (1u << 31) | sid);                 /* SMR: valid, mask 0 */
+	uint32_t smr = smmu_rd(0x800 + 4 * (uint32_t)smr_i), s2cr = smmu_rd(0xc00 + 4 * (uint32_t)smr_i);
+	bool ok = smr == ((1u << 31) | sid) && ((s2cr >> 16) & 3u) == 0 && (s2cr & 0xffu) == (uint32_t)cb;
+	printf("HOTDOGB SMMU: SID %#x -> SMR[%d] %08x S2CR %08x -> bank %d, identity 0x80000000-0xffffffff: %s\n", sid, smr_i,
+	    smr, s2cr, cb, ok ? "in place" : "NOT taken (read back differs)");
+	return ok ? cb : -1;
+}
+
+/* sysctl kern.sweetsmmu_map=0x140: the same by hand (root); reading gives the bank (or -1) */
+static int
+sysctl_sweetsmmu_map SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = smmu_identity_last, changed = 0;
+	int error = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+
+	if (error != 0 || !changed) {
+		return error;
+	}
+	smmu_identity_last = sweet_smmu_identity((uint32_t)value);
+	return smmu_identity_last >= 0 ? 0 : EIO;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweetsmmu_map, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweetsmmu_map, "I", "write a stream ID: identity-mapped SMMU context bank for it (0138)");
+
 SYSCTL_PROC(_kern, OID_AUTO, sweetsmmu_bypass, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
     sysctl_sweetsmmu_bypass, "I", "write a stream ID: SMMU bypass for it (0133)");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index ea1cc46..b99a91a 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -46,6 +46,7 @@ extern kern_return_t thread_terminate(thread_t);
 static vm_offset_t ud_start_dwc;
 static void ud_start_thread(void *arg, wait_result_t wr);
 extern int sweet_smmu_bypass(uint32_t sid);    /* sweet_smmu.c, 0133 */
+extern int sweet_smmu_identity(uint32_t sid);  /* sweet_smmu.c, 0138 */
 
 #define GCC_PA                  0x00100000
 #define GCC_SIZE                0x00090000
@@ -917,13 +918,16 @@ ud_start_thread(void *arg, wait_result_t wr)
 	/*
 	 * 0133: on the 7T, USB (SID 0x140) has no SMMU stream match and unmatched streams fault
 	 * (sysctl kern.sweetsmmu, 2026-10-25): its first DMA would fault. Let it through first.
-	 * sweetusbsmmu=0 skips this (the 0092 behaviour).
+	 * 0138: bypass is refused by the hypervisor (S2CR reads back as fault), so by default an
+	 * identity-mapped context bank (DMA address = physical address, as the driver programs).
+	 * sweetusbsmmu=1 identity map (default), 2 bypass (0133), 0 nothing (the 0092 behaviour).
 	 */
-	int smmu_bypass = 1;
-	PE_parse_boot_argn("sweetusbsmmu", &smmu_bypass, sizeof(smmu_bypass));
-	if (smmu_bypass) {
-		int smr = sweet_smmu_bypass(0x140);
-		printf("HOTDOGB USB: SMMU bypass for SID 0x140: %s (SMR %d)\n", smr >= 0 ? "ok" : "FAILED", smr);
+	int smmu_mode = 1;
+	PE_parse_boot_argn("sweetusbsmmu", &smmu_mode, sizeof(smmu_mode));
+	if (smmu_mode) {
+		int smr = smmu_mode == 2 ? sweet_smmu_bypass(0x140) : sweet_smmu_identity(0x140);
+		printf("HOTDOGB USB: SMMU %s for SID 0x140: %s (%d)\n", smmu_mode == 2 ? "bypass" : "identity map",
+		    smr >= 0 ? "ok" : "FAILED", smr);
 		if (smr < 0) {
 			printf("HOTDOGB USB: not starting: its DMA would fault\n");
 			thread_terminate(current_thread());
