+			*iva = ((va + o) >> 12) & 0xfffffffffffULL;
+			*ivaa = ((va + o) >> 12) & 0xfffffffffffULL;
 		}
+		__asm__ volatile("dsb sy" ::: "memory");
 	}
 	k1_cbw(CB_TLBSYNC, 0);
 	unsigned i;
@@ -586,8 +600,11 @@
 		if (k1_l3[t] != NULL) {
 			uint64_t *e = &k1_l3[t][(v >> 12) & 0x1ffU];
 			*e = 0;
-			vm_offset_t line = (vm_offset_t)e & ~(vm_offset_t)63;
-			__asm__ volatile("dc civac, %0" : : "r"(line) : "memory");
+			/* 0115: a 64-byte line holds 8 entries: clean it once, at its last entry or the end */
+			if ((((vm_offset_t)e + 8) & 63) == 0 || o + 0x1000 >= size) {
+				vm_offset_t line = (vm_offset_t)e & ~(vm_offset_t)63;
+				__asm__ volatile("dc civac, %0" : : "r"(line) : "memory");
+			}
 		}
 	}
 	__asm__ volatile("dsb sy" ::: "memory");
