From: fish <lunarisfelix02@gmail.com>
Date: Sun, 25 Oct 2026 21:30:00 -0400
Subject: [PATCH] op7t-0141: vsync ticks on absolute deadlines (a real 60 Hz), kern.sweetvsync_hz

The framebuffer's vsync timer is the display link of the whole UI, and it was
re-armed 16.667 ms from the END of each tick's work, so every tick lasted
16.7 ms plus present() (GPU wait, flip) plus timer latency: swiping the home
screen gave 1000 flips in 20.8 s = 48/s whatever backboardd's frame cost
(~10 ms; ~55 fps at best, and a 1 ms faster frame bought ~1 fps).
Now each tick is due at the previous deadline plus one period (absolute,
IOTimerEventSource::wakeAtTime); a late tick moves the next deadline ahead in
step instead of piling up. 60 Hz by default; boot-arg sweetvsync_hz and
sysctl kern.sweetvsync_hz (30..240) change it, e.g. 120 for a run that shows
how many frames the pipeline can make, then back to 60.
New code syntax-checked with clang/clang++ -Wall -Wextra on stubs.

Apply after 0140 (bsd/conf/files context).
---
 bsd/conf/files                        |  1 +
 bsd/dev/sweet_vsync.c                 | 32 ++++++++++++++++++
 iokit/Kernel/arm/SweetFramebuffer.cpp | 62 +++++++++++++++++++++++++++++++++--
 3 files changed, 92 insertions(+), 3 deletions(-)

diff --git a/bsd/conf/files b/bsd/conf/files
index dd59268..9904f3b 100644
--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -121,6 +121,7 @@ bsd/dev/sweet_smmu.c			standard
 bsd/dev/sweet_cores.c			standard
 bsd/dev/sweet_swipe.c			standard
 bsd/dev/sweet_reboot.c			standard
+bsd/dev/sweet_vsync.c			standard
 bsd/dev/mem.c				standard
 bsd/dev/munge.c 			optional config_requires_u32_munging
 bsd/dev/unix_startup.c			standard
diff --git a/bsd/dev/sweet_vsync.c b/bsd/dev/sweet_vsync.c
new file mode 100644
index 0000000..cb6e07d
--- /dev/null
+++ b/bsd/dev/sweet_vsync.c
@@ -0,0 +1,32 @@
+/*
+ * 0141: the UI's vsync rate (iokit/Kernel/arm/SweetFramebuffer.cpp), from a root shell.
+ *   sysctl kern.sweetvsync_hz=120   ticks at 120 Hz: CoreAnimation may render that often, so an fps
+ *                                   run shows the pipeline's headroom
+ *   sysctl kern.sweetvsync_hz=60    the normal rate (the panel and iOS's iPhone X identity are 60 Hz)
+ * 30..240; boot-arg sweetvsync_hz for the start.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern uint32_t sweet_vsync_hz_get(void);
+extern int sweet_vsync_hz_set(uint32_t hz);
+
+static int
+sysctl_sweetvsync_hz SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int value = (int)sweet_vsync_hz_get(), changed = 0;
+	int error = sysctl_io_number(req, value, sizeof(value), &value, &changed);
+
+	if (error != 0 || !changed) {
+		return error;
+	}
+	return value < 0 || sweet_vsync_hz_set((uint32_t)value) != 0 ? EINVAL : 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweetvsync_hz, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sysctl_sweetvsync_hz, "I",
+    "UI vsync rate in Hz, 30..240 (0141)");
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 986ac33..33ea2d3 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -99,8 +99,10 @@ class AppleCLCD : public IOMobileFramebuffer {
 	IOWorkLoop         *fWorkLoop;
 	IOTimerEventSource *fVsync;
 	uint64_t            fVsyncCount;
+	uint64_t            fNextVsync;         /* 0141: absolute time of the next tick */
 
 	static void vsyncFired(OSObject *owner, IOTimerEventSource *sender);
+	void rearmVsync(IOTimerEventSource *sender);
 
 public:
 	uint64_t      fPhys;
@@ -160,6 +162,54 @@ OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
  */
 static AppleCLCD *sweet_fb_instance;
 
+/*
+ * 0141: the vsync tick is the display link of the whole UI (CoreAnimation renders on its
+ * notifications), and it was re-armed 16.667 ms from the END of each tick's work: every tick
+ * lasted 16.7 ms plus present() (which waits for the GPU and flips) plus timer latency. Swiping
+ * the home screen (2026-10-25): 1000 flips in 20.8 s = 48/s, whatever backboardd's frame cost
+ * (~10 ms, ~55 fps at best). Now each tick is due at the previous deadline plus one period
+ * (absolute), late ticks skip ahead instead of piling up. The rate is 60 Hz; boot-arg
+ * sweetvsync_hz and sysctl kern.sweetvsync_hz (bsd/dev/sweet_vsync.c) change it, e.g. 120 for
+ * a run that shows how many frames the pipeline can make (headroom), then back to 60.
+ */
+static volatile uint64_t sweet_vsync_period;    /* mach absolute time units */
+static volatile uint32_t sweet_vsync_hz = 60;
+
+extern "C" uint32_t sweet_vsync_hz_get(void);
+extern "C" int sweet_vsync_hz_set(uint32_t hz);
+
+extern "C" uint32_t
+sweet_vsync_hz_get(void)
+{
+	return sweet_vsync_hz;
+}
+
+extern "C" int
+sweet_vsync_hz_set(uint32_t hz)
+{
+	uint64_t period;
+	if (hz < 30 || hz > 240) {
+		return -1;
+	}
+	nanoseconds_to_absolutetime(NSEC_PER_SEC / hz, &period);
+	sweet_vsync_period = period;
+	sweet_vsync_hz = hz;
+	IOLog("HOTDOGB FB: vsync %u Hz\n", hz);
+	return 0;
+}
+
+void
+AppleCLCD::rearmVsync(IOTimerEventSource *sender)
+{
+	uint64_t period = sweet_vsync_period, now = mach_absolute_time();
+
+	fNextVsync += period;
+	if (fNextVsync <= now) {                /* late: the next deadline still ahead, in step */
+		fNextVsync += ((now - fNextVsync) / period + 1) * period;
+	}
+	sender->wakeAtTime(fNextVsync);
+}
+
 void
 SweetFramebufferShow(const uint8_t *pixels, uint32_t width, uint32_t height, uint32_t rowBytes)
 {
@@ -261,7 +311,13 @@ AppleCLCD::start(IOService *provider)
 	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
 	sweet_fb_threads_start();
 	scanSetup();
-	fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
+	uint32_t vsync_hz = 60;
+	PE_parse_boot_argn("sweetvsync_hz", &vsync_hz, sizeof(vsync_hz));
+	if (sweet_vsync_hz_set(vsync_hz) != 0) {        /* (out of range: 60) */
+		(void)sweet_vsync_hz_set(60);
+	}
+	fNextVsync = mach_absolute_time() + sweet_vsync_period;  /* 0141: absolute ticks */
+	fVsync->wakeAtTime(fNextVsync);
 
 	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
 	setProperty("external", false);
@@ -320,7 +376,7 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 				}
 			}
 		}
-		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+		fb->rearmVsync(sender);         /* 0141 */
 		return;
 	}
 	bool flush = fb->fDirty && (count % fb->fFlushTicks) == 0;
@@ -337,7 +393,7 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		fb->present(rec);
 		IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
 	}
-	sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+	fb->rearmVsync(sender);                 /* 0141 */
 }
 
 void
