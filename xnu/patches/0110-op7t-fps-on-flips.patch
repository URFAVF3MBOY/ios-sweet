+/*
+ * 0110: once a second, the "SWEET FB: N fps" line; every frame shown, the counter drawn at px
+ * (0: not drawn). Called for copied frames (the splash buffer) and for flipped ones (0108: the
+ * surface shown) -- 0108 only counted on the copy path, so with every frame flipped the line
+ * and the counter went quiet.
+ */
+static void
+sweet_fps_tick(uintptr_t px, uint32_t stride, uint32_t width, uint32_t height)
+{
+	uint64_t now = mach_absolute_time();
+
+	sweet_fps_copies++;
+	if (sweet_fps_t0 == 0) {
+		sweet_fps_t0 = now;
+	} else if (now - sweet_fps_t0 >= sweet_fps_second) {
+		uint64_t el = now - sweet_fps_t0;
+		sweet_fps_last_swaps = (uint32_t)((uint64_t)sweet_fps_swaps * sweet_fps_second / el);
+		sweet_fps_last_copies = (uint32_t)((uint64_t)sweet_fps_copies * sweet_fps_second / el);
+		IOLog("SWEET FB: %u fps (backboardd), %u frames shown/s\n",
+		    sweet_fps_last_swaps, sweet_fps_last_copies);
+		sweet_fps_swaps = sweet_fps_copies = 0;
+		sweet_fps_t0 = now;
+	}
+	sweet_fps_draw(px, stride, width, height, sweet_fps_last_swaps, sweet_fps_last_copies);
+}
