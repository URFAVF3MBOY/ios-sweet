+/*
+ * Paths the modem's rmtfs client asks for -> GPT partitions. A path may be listed more than once:
+ * OPEN tries each listed partition in order and takes the first that exists.
+ * /oem/nvbk/static and /oem/nvbk/dynamic: OnePlus's modem asks for these (NV backup) right before
+ * it crashed on boots a91837 / 25c58c; topaz's Redmi modem does not. The partition names below are
+ * the usual OnePlus ones (NOT confirmed on this 7T: check `ls /dev/block/by-name` in recovery).
+ */
 static const struct { const char *path, *part; } rmtfs_parts[] = {
 	{ "/boot/modem_fs1", "modemst1" },
 	{ "/boot/modem_fs2", "modemst2" },
 	{ "/boot/modem_fsc", "fsc" },
 	{ "/boot/modem_fsg", "fsg" },
+	{ "/oem/nvbk/static", "oem_stanvbk" },
+	{ "/oem/nvbk/static", "stanvbk" },
+	{ "/oem/nvbk/dynamic", "oem_dycnvbk" },
+	{ "/oem/nvbk/dynamic", "dycnvbk" },
 };
+#define RMTFS_NPARTS        ((uint32_t)(sizeof(rmtfs_parts) / sizeof(rmtfs_parts[0])))
 static uint64_t rmtfs_pa;
 static uint8_t *rmtfs_va;
 static unsigned rmtfs_reads, rmtfs_writes, rmtfs_err;
