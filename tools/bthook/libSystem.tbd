--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-ios, arm64e-ios ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 1319
exports:
  - targets:     [ arm64-ios, arm64e-ios ]
    symbols:     [ _setsockopt, _getsockopt, ___error, _syslog, _snprintf, _setenv, _getenv, _ioctl, _read, _write, _recv, _send, dyld_stub_binder ]
...
