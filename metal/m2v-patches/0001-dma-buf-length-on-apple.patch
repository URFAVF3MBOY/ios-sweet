+/// The bytes of the "dma-buf" `fd` on Apple systems, which have no dma-buf: there the source's
+/// descriptor is whatever the device's driver imports as one (on iOS a regular file as long as the
+/// memory it stands for, which the driver reads to find it), so its file's size is the answer;
+/// `None` for anything but a regular file.
+#[cfg(any(target_os = "ios", target_os = "macos"))]
+fn dma_buf_length(fd: BorrowedFd<'_>) -> Option<u64> {
+    use std::os::fd::AsRawFd;
+    let mut stat = std::mem::MaybeUninit::<libc::stat>::uninit();
+    // SAFETY: the descriptor is open for the call, and `fstat` writes the structure.
+    if unsafe { libc::fstat(fd.as_raw_fd(), stat.as_mut_ptr()) } != 0 {
+        return None;
+    }
+    // SAFETY: the call succeeded, so it wrote the structure.
+    let stat = unsafe { stat.assume_init() };
+    if stat.st_mode & libc::S_IFMT != libc::S_IFREG {
+        return None;
+    }
+    u64::try_from(stat.st_size).ok()
+}
+
 /// No file is a dma-buf on this system.
-#[cfg(not(target_os = "linux"))]
+#[cfg(not(any(target_os = "linux", target_os = "ios", target_os = "macos")))]
 fn dma_buf_length(_fd: BorrowedFd<'_>) -> Option<u64> {
     None
 }
