+    // (metal/test/mtlrender's IOSurface round trip: GPU writes and CPU writes meet, 2026-11-13).
+    if class == PagesClass::DmaBuf {
+        return Ok(());
+    }
     match verdict(class) {
         Verdict::Passed => Ok(()),
