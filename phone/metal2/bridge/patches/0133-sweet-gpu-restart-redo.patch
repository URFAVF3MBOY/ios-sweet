diff --git a/crates/metal2vulkan-runtime/src/gpu_restarts.rs b/crates/metal2vulkan-runtime/src/gpu_restarts.rs
new file mode 100644
index 00000000..efff8c83
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/gpu_restarts.rs
@@ -0,0 +1,167 @@
+//! Sweet 0133 (U12-1b): GPU restarts that dropped this process's work. Turnip 0112 keeps the
+//! `VkDevice` after the kernel recovered a hung GPU; the kernel drops all work in flight and
+//! forces its fences done, so dropped work looks completed. 0112 counts the status checks that
+//! found work dropped (`tu_darwin_restarts`, run inside every `vkWaitForFences` and
+//! `vkWaitSemaphores`). A submission snapshots the count before it goes; once its wait returned,
+//! a count that moved means its work may have been dropped: a waited copy is submitted once more
+//! (`device/submit.rs`, `device/staging.rs`), a command buffer fails with Metal's victim error
+//! (`command_buffer/completion.rs`). Off: `SWEET_RESTART_REDO=0`, or a driver without the count.
+//!
+//! A redo replays the copy's own command buffer alone, never the first work (moves from
+//! `PREINITIALIZED` or a foreign family, zero fills: no longer valid to replay), and only where
+//! no queue was used after the copy went ([`queue_uses`]): later work may have written what the
+//! copy writes. Within 60 s of a redo that itself saw another restart, none is made (a copy that
+//! hangs the GPU is not resubmitted in a loop).
+
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+type Restarts = unsafe extern "C" fn() -> u32;
+
+/// What a command buffer whose work a restart may have dropped reads as its error: Metal's own
+/// description of a victim of a GPU recovery (`CommandBufferError::Execution(1)`, measured).
+pub(crate) const VICTIM: &str = "Discarded (victim of GPU error/recovery)";
+
+static REDONE: AtomicU64 = AtomicU64::new(0);
+static MARKED: AtomicU64 = AtomicU64::new(0);
+
+/// 0112's count now, `None` where it is off or the driver has none.
+pub(crate) fn count() -> Option<u32> {
+    static FOUND: OnceLock<Option<usize>> = OnceLock::new();
+    let found = *FOUND.get_or_init(|| {
+        let off = std::env::var("SWEET_RESTART_REDO").is_ok_and(|v| v.trim() == "0");
+        if off {
+            None
+        } else {
+            find()
+        }
+    });
+    // SAFETY: the address is Turnip 0112's `uint32_t tu_darwin_restarts(void)`.
+    found.map(|address| unsafe { std::mem::transmute::<usize, Restarts>(address)() })
+}
+
+/// Whether the count moved since `at` (a [`count`] taken before the work was submitted).
+pub(crate) fn moved(at: Option<u32>) -> bool {
+    at.is_some_and(|at| count().is_some_and(|now| now != at))
+}
+
+/// Every use of one of the device's `VkQueue`s (`QueueSlot::with`, under the queue's lock,
+/// before the use), of any device of the process.
+static QUEUE_USES: AtomicU64 = AtomicU64::new(0);
+
+/// A `VkQueue` is being used (under its lock).
+pub(crate) fn queue_used() {
+    QUEUE_USES.fetch_add(1, Ordering::AcqRel);
+}
+
+/// The uses of `VkQueue`s so far.
+pub(crate) fn queue_uses() -> u64 {
+    QUEUE_USES.load(Ordering::Acquire)
+}
+
+/// Until when no redo is made: 60 s after a redo that saw another restart.
+static HELD_UNTIL: Mutex<Option<Instant>> = Mutex::new(None);
+
+/// Whether a waited copy submitted when the count was `at` goes again: `Some(why)` where it is
+/// not although the count moved (logged by the caller), `None` where the count did not move.
+pub(crate) fn redo(at: Option<u32>) -> Option<Result<(), &'static str>> {
+    if !moved(at) {
+        return None;
+    }
+    let held = (HELD_UNTIL.lock()).map_or(true, |until| (*until).is_some_and(|u| Instant::now() < u));
+    Some(match held {
+        true => Err("; redo skipped: within 60 s of a redo that saw another restart"),
+        false => Ok(()),
+    })
+}
+
+/// A redo completed, the count `again` as it went: logged, and redos held for 60 s where the
+/// count moved again.
+pub(crate) fn redone(again: Option<u32>) {
+    let extra = match moved(again) {
+        true => {
+            if let Ok(mut until) = HELD_UNTIL.lock() {
+                *until = Some(Instant::now() + Duration::from_secs(60));
+            }
+            "; another restart in the redo's flight: redos held 60 s"
+        }
+        false => "",
+    };
+    note(1, 0, extra);
+}
+
+/// The redo's text where the queue was used after the copy.
+pub(crate) const NEWER_WORK: &str = "; redo skipped: newer work on the queue";
+
+/// One line per redo, with the process's totals, into `/dev/console` and `/var/local/mtl2.log`
+/// (as 0104's notes).
+pub(crate) fn note(redone: u64, marked: u64, extra: &str) {
+    use std::io::Write;
+    let redone = REDONE.fetch_add(redone, Ordering::Relaxed) + redone;
+    let marked = MARKED.fetch_add(marked, Ordering::Relaxed) + marked;
+    let line = format!(
+        "MTL2[{} {}]: GPU restart: redid {redone} staging copies, {marked} command buffers marked \
+         error (restarts {}){extra}\n",
+        std::process::id(),
+        std::env::args().next().unwrap_or_default(),
+        count().unwrap_or(0)
+    );
+    for path in ["/dev/console", "/var/local/mtl2.log"] {
+        if let Ok(mut file) = std::fs::OpenOptions::new().append(true).open(path) {
+            let _ = file.write_all(line.as_bytes());
+        }
+    }
+}
+
+// dyld's image list (`<mach-o/dyld.h>`), as `pipeline/creation_log.rs` reads it.
+#[cfg(target_vendor = "apple")]
+unsafe extern "C" {
+    fn _dyld_image_count() -> u32;
+    fn _dyld_get_image_name(image_index: u32) -> *const std::ffi::c_char;
+}
+
+/// `tu_darwin_restarts` among the process's global symbols, else in the loaded
+/// `libvulkan_freedreno.dylib` (opened with its symbols local), as `creation_log.rs` finds
+/// MoltenVK's statistics.
+#[cfg(target_vendor = "apple")]
+fn find() -> Option<usize> {
+    use std::ffi::CStr;
+    const NAME: &CStr = c"tu_darwin_restarts";
+    // SAFETY: `dlsym` of a NUL-terminated name in the process's global symbols.
+    let global = unsafe { libc::dlsym(libc::RTLD_DEFAULT, NAME.as_ptr()) };
+    if !global.is_null() {
+        return Some(global as usize);
+    }
+    // SAFETY: dyld's image list, read by index below its count; each name is a NUL-terminated
+    // path dyld keeps while the image is loaded.
+    let images = unsafe { _dyld_image_count() };
+    for index in 0..images {
+        // SAFETY: as above.
+        let path = unsafe { _dyld_get_image_name(index) };
+        if path.is_null() {
+            continue;
+        }
+        // SAFETY: as above.
+        let path = unsafe { CStr::from_ptr(path) };
+        if !path.to_bytes().ends_with(b"/libvulkan_freedreno.dylib") {
+            continue;
+        }
+        // SAFETY: `RTLD_NOLOAD` opens only an image already loaded; the handle is kept.
+        let handle = unsafe { libc::dlopen(path.as_ptr(), libc::RTLD_NOLOAD | libc::RTLD_LAZY) };
+        if handle.is_null() {
+            continue;
+        }
+        // SAFETY: `dlsym` of a NUL-terminated name in an open image.
+        let symbol = unsafe { libc::dlsym(handle, NAME.as_ptr()) };
+        if !symbol.is_null() {
+            return Some(symbol as usize);
+        }
+    }
+    None
+}
+
+#[cfg(not(target_vendor = "apple"))]
+fn find() -> Option<usize> {
+    None
+}
