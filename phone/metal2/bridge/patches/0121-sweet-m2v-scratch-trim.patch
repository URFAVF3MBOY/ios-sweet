+/// 0121 (ios-redfin bridge 0111): whether a memoryless color attachment that no draw of its pass
+/// writes or reads leaves the pass's subpass (env `SWEET_M2V_SCRATCH`, off unless set and not `0`).
+/// A tiler then keeps it out of tile memory (Turnip: half the bytes per pixel of CoreAnimation's
+/// two-color passes, twice the pixels per bin) and neither clears nor loads it.
+fn sweet_scratch() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var("SWEET_M2V_SCRATCH").is_ok_and(|v| !v.trim().is_empty() && v.trim() != "0")
+    })
+}
+
+/// 0121's counts of this process, from `SWEET_M2V_SCRATCH` on: passes with a memoryless color,
+/// passes trimmed, attachments trimmed, trimmed passes whose attachment's load was `Clear`, and
+/// why the other passes kept theirs (a draw wrote one; a draw fetched one; anything else).
+static SWEET_SCRATCH_COUNTS: [std::sync::atomic::AtomicU64; 7] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 7];
+
+/// 0121 (ios-redfin bridge 0111): the color indices of `layout`'s memoryless attachments that the
+/// pass's subpass may leave out (`VK_ATTACHMENT_UNUSED`, as the interlock's storage colors are,
+/// `render_target::create`): no draw of the pass writes one (`coverage`, every draw's pixels
+/// bounded) or reads one as an input attachment (`inputs_read`), nor took a view of it (its
+/// extended-range shadow, an instance's storage form or reformatting view, sample planes); the pass
+/// is `simple` (no execution of render commands, pending pipeline, tile dispatch or imageblock),
+/// no instance routes its colors or renders views, the attachment resolves nowhere, and another
+/// attachment stays in the subpass. Metal neither loads nor stores a memoryless texture
+/// (`render_pass::check_memoryless`), so what the pass's clear would have left there is read by
+/// nothing: the pass is the same without it. The pipelines and the instances' secondary command
+/// buffers keep the compatible pass that has it: Turnip runs them in the subpass without it writing
+/// nothing there (the color's MRT format `NONE`, `tu6_emit_mrt`), and their pipelines write it with
+/// an empty mask anyway. Logs its counts at the first such pass and rarely after.
+fn sweet_scratch_free(
+    layout: &PassLayout,
+    instances: &[Instance],
+    coverage: &linear_attachment::Coverage,
+    inputs_read: &BTreeSet<u32>,
+    extended: &ExtendedShadows,
+    simple: bool,
+) -> Vec<u32> {
+    use std::sync::atomic::Ordering::Relaxed;
+    let memoryless: Vec<u32> = (0..layout.colors.len())
+        .filter(|&index| layout.colors[index].as_ref().is_some_and(|c| c.memoryless))
+        .map(|index| index as u32)
+        .collect();
+    if memoryless.is_empty() {
+        return Vec::new();
+    }
+    let shapes_plain = instances.iter().all(|instance| {
+        instance.shape.locations.is_empty() && instance.views == ViewSetup::default()
+    });
+    let mut free = Vec::new();
+    let (mut written, mut read, mut other) = (false, false, !simple || !shapes_plain);
+    for &index in &memoryless {
+        let Some(color) = layout.colors[index as usize].as_ref() else {
+            continue;
+        };
+        if !coverage.sweet_unwritten(index as usize) {
+            written = true;
+            continue;
+        }
+        if inputs_read.contains(&index) {
+            read = true;
+            continue;
+        }
+        let viewed = extended.made(index)
+            || instances.iter().any(|instance| {
+                instance.shape.storage.contains(&index)
+                    || instance.reformats.iter().any(|r| r.index == index as usize)
+            });
+        let resolves = color.resolve.is_some() || color.copied_resolve.is_some();
+        if viewed || resolves || color.planes.is_some() || !simple || !shapes_plain {
+            other = true;
+            continue;
+        }
+        free.push(index);
+    }
+    // Another attachment stays in every instance's subpass.
+    let stays = instances.iter().all(|instance| {
+        instance.shape.depth_stencil.is_some()
+            || layout.colors.iter().enumerate().any(|(index, color)| {
+                let index = index as u32;
+                color.is_some()
+                    && !free.contains(&index)
+                    && !instance.shape.storage.contains(&index)
+            })
+    });
+    if !stays {
+        free.clear();
+        other = true;
+    }
+    let counts = &SWEET_SCRATCH_COUNTS;
+    match free.is_empty() {
+        false => {
+            counts[1].fetch_add(1, Relaxed);
+            counts[2].fetch_add(free.len() as u64, Relaxed);
+            let cleared = free.iter().any(|&index| {
+                layout.colors[index as usize]
+                    .as_ref()
+                    .is_some_and(|color| color.load == LoadAction::Clear)
+            });
+            if cleared {
+                counts[3].fetch_add(1, Relaxed);
+            }
+        }
+        true if written => {
+            counts[4].fetch_add(1, Relaxed);
+        }
+        true if read => {
+            counts[5].fetch_add(1, Relaxed);
+        }
+        true if other => {
+            counts[6].fetch_add(1, Relaxed);
+        }
+        true => {}
+    }
+    // At the 1st pass, each power of two from the 256th to the 4096th, and every 4096th after.
+    let passes = counts[0].fetch_add(1, Relaxed) + 1;
+    if passes == 1 || (passes >= 256 && passes.is_power_of_two()) || passes % 4096 == 0 {
+        let at = |index: usize| counts[index].load(Relaxed);
+        crate::pipestats::line(&format!(
+            "SWEET_M2V_SCRATCH passes={passes} trimmed={} attachments={} cleared={} kept-written={} kept-read={} kept-other={}",
+            at(1),
+            at(2),
+            at(3),
+            at(4),
+            at(5),
+            at(6)
+        ));
+    }
+    free
+}
