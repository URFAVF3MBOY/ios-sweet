Bridge 0123: port of UniXNU bridge 0023 (https://github.com/UniXNU/UniXNU 359d77c; read by name and comment only, its submodule not cloned).
Puts the runtime's own threads that take command buffers to their handlers at the user-interactive class on iOS, as macOS and Linux already do (on iOS the function was an empty stub).
Differs from UniXNU: off by default, and relative -2 unless asked: plain user-interactive is 47 in a foreground or graphics-server task, where xnu 0147 prefers an idle A76.
Knob: SWEET_BRIDGE_QOS (off unless set and not 0; 2 = relative 0, anything else = relative -2; off = same thread classes as before).

diff --git a/crates/metal2vulkan-runtime/src/exit_guard.rs b/crates/metal2vulkan-runtime/src/exit_guard.rs
--- a/crates/metal2vulkan-runtime/src/exit_guard.rs
+++ b/crates/metal2vulkan-runtime/src/exit_guard.rs
@@ -900,8 +900,26 @@ impl SchedAttr {
     }
 }
 
+/// 0123 (UniXNU bridge 0023): the user-interactive class for the threads that take command buffers
+/// to their handlers, where asked (env `SWEET_BRIDGE_QOS`, off unless set and not `0`). `2`: priority
+/// 46, 47 in a foreground or graphics-server task (xnu 0147 then prefers an idle A76); else relative
+/// -2: 45, or 46 there, never 47.
+#[cfg(target_os = "ios")]
+fn run_at_user_interactive() {
+    let Ok(asked) = std::env::var("SWEET_BRIDGE_QOS") else { return };
+    let relative = match asked.trim() {
+        "0" => return,
+        "2" => 0,
+        _ => -2,
+    };
+    // SAFETY: sets the calling thread's own class; no pointer.
+    unsafe {
+        libc::pthread_set_qos_class_self_np(libc::qos_class_t::QOS_CLASS_USER_INTERACTIVE, relative)
+    };
+}
+
 /// Nothing: no such hint here ([`run_at_user_interactive`] on macOS and Linux).
-#[cfg(not(any(target_os = "macos", target_os = "linux")))]
+#[cfg(not(any(target_os = "macos", target_os = "linux", target_os = "ios")))]
 fn run_at_user_interactive() {}
 
