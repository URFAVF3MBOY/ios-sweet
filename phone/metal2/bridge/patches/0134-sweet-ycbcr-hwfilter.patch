+/// 0134: whether texture slots of `pf` hand their linear samples to the device's bilinear filter
+/// (env `SWEET_YCBCR_HWFILTER`, on unless `0`): a `PackedTexels::YCbCr2048` format (the 8- and
+/// 10-bit converted two-plane ones), whose texels the runtime converts into an
+/// `R16G16B16A16_SFLOAT` image, on a device without Metal's own sampler. Its `TexelFormat`
+/// specialization drops `EXACT`, so the function takes the device's arm (`lower::sampler::linear`,
+/// `device_when`) instead of the exact routine's four taps and integer sums; the slot's `VkSampler`
+/// keeps the Metal sampler's linear filter, checked against the view format at bind. Off, `0`:
+/// the exact routine, as before.
+fn sweet_ycbcr_hwfilter(profile: &DeviceProfile, pf: PixelFormat) -> bool {
+    use crate::metal::texel_format::PackedTexels;
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    PackedTexels::of(pf) == Some(PackedTexels::YCbCr2048)
+        && !profile.device_samples()
+        && *ON.get_or_init(|| {
+            let on = std::env::var("SWEET_YCBCR_HWFILTER").map_or(true, |v| v.trim() != "0");
+            crate::env_vars::half_relaxed_note(&format!(
+                "SWEET_YCBCR_HWFILTER mode {}",
+                u8::from(on)
+            ));
+            on
+        })
+}
