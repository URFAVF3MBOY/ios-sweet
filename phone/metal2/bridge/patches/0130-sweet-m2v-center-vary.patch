+/// 0130: `amd-780m-radv` under Turnip's driver ID (env `SWEET_M2V_CENTER_VARY` unset or `1`)
+/// reads a center varying as it is at four samples, requiring `VkProperty::MetalCenterVaryings`,
+/// in a function the pipeline runs without sample shading (`multisample_center_at_sample`, per
+/// sample by its `[[sample_id]]`); the one that writes memory (`multisample_counter`), which runs
+/// under sample shading (`DriverWorkaround::SampleShadingMovesCenterVaryings`), keeps
+/// `InterpolateAtOffset` at offset 0.
+#[test]
+fn turnip_reads_center_varyings_as_they_are_but_under_sample_shading() {
+    let Some(lib) = fixture() else { return };
+    if std::env::var("SWEET_M2V_CENTER_VARY").is_ok_and(|v| v.trim() == "0") {
+        return;
+    }
+    let mut desc = description("amd-780m-radv");
+    desc.driver_id = Some(crate::vk::DriverId::MESA_TURNIP);
+    let dev = Device::new(desc, DevicePolicy::default()).expect("device");
+    let fields = dev.profile().fields();
+    assert!(reads_center_at_pixel(&dev));
+    assert!(fields
+        .workarounds
+        .contains(&DriverWorkaround::SampleShadingMovesCenterVaryings));
+    for (fragment, by_device) in [(CENTER, true), (SAMPLED, true), (COUNTER, false)] {
+        let p = dev
+            .compile_render_pipeline(&render(&lib, fragment, 4), &Budget::standard())
+            .unwrap_or_else(|e| panic!("{fragment}: {e}"));
+        validate(&p, &dev, fragment);
+        assert_eq!(p.graphics.sample_shading, fragment == COUNTER, "{fragment}");
+        let ext = ext_insts(fragment_words(&p));
+        assert_eq!(
+            ext.contains(&INTERPOLATE_AT_OFFSET),
+            !by_device,
+            "{fragment}: {ext:?}"
+        );
+        assert_eq!(
+            p.requirements
+                .properties
+                .contains(&VkProperty::MetalCenterVaryings),
+            by_device,
+            "{fragment}"
+        );
+    }
+    // Under RADV's own ID the profile takes neither.
+    let dev = Device::new(description("amd-780m-radv"), DevicePolicy::default()).expect("device");
+    assert!(!reads_center_at_pixel(&dev));
+    assert!(!dev
+        .profile()
+        .fields()
+        .workarounds
+        .contains(&DriverWorkaround::SampleShadingMovesCenterVaryings));
+}
