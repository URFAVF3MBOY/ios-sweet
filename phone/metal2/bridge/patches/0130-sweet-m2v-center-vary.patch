+/// 0130: whether the function may write memory another invocation or a later command can read
+/// (a store, atomic, image write or copy outside `Thread` memory, or a call the walk cannot see
+/// into): a superset of `StageInterface::writes_memory`, under which link enables the pipeline's
+/// sample shading.
+pub fn may_write_memory(cx: &SelectCx<'_>) -> bool {
+    cx.body
+        .insts
+        .iter()
+        .any(|(id, inst)| discard::side_effect(cx, id, inst))
+}
