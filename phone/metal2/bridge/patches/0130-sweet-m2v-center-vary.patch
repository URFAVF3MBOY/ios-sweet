+/// 0130: whether the device is Turnip and reads center varyings as they are (env
+/// `SWEET_M2V_CENTER_VARY`, on unless `0`; `0` keeps `InterpolateAtOffset` at offset 0, which ir3
+/// lowers to `ddx`/`ddy` with helper invocations live). Turnip reads an undecorated input through
+/// `load_barycentric_pixel` (`nir_lower_io.c`), the pixel-center `ij` its `InterpolateAtOffset`
+/// is computed from (`ir3_nir_lower_load_barycentric_at_offset.c`), so the plain read is that
+/// one's at offset 0, without the derivatives; `sampleShadingEnable` moves it to the sample
+/// (`DriverWorkaround::SampleShadingMovesCenterVaryings`).
+fn sweet_center_vary(desc: &DeviceDescription) -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    desc.driver_id == Some(vk::DriverId::MESA_TURNIP)
+        && *ON.get_or_init(|| {
+            let on = std::env::var("SWEET_M2V_CENTER_VARY").map_or(true, |v| v.trim() != "0");
+            crate::env_vars::half_relaxed_note(&format!(
+                "SWEET_M2V_CENTER_VARY mode {}",
+                u8::from(on)
+            ));
+            on
+        })
+}
