diff --git a/crates/metal2vulkan-runtime/src/render/passhash.rs b/crates/metal2vulkan-runtime/src/render/passhash.rs
new file mode 100644
index 00000000..533db07f
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/render/passhash.rs
@@ -0,0 +1,575 @@
+//! 0122 sweet passhash (`SWEET_PASSHASH`, off by default; 1: backboardd alone, 2: every process
+//! that reads `/var/local/mtl2-env`): measures whether a render pass's draws repeat, so a later
+//! patch can tell whether Core Animation's main pass can be reused from a kept copy. Skips nothing.
+//!
+//! - **What is hashed.** One hash per field ([`FIELDS`]), each fed draw by draw in order, so a
+//!   pass that differs says where: the attachments at the encoder's opening, and at each
+//!   [`draw`](RenderCommandEncoder::draw) what it reads. Draws the frontend dropped (dead fill)
+//!   never arrive here, so the hash is of what the pass really draws.
+//! - **Buffer contents are bounded.** Only slots the pipeline reads: a vertex layout's buffer over
+//!   the elements the draw fetches (an indexed draw's indices are read to find them), another
+//!   slot over the shader's window. A window without a bound ([`Window::Whole`]) takes the draw's
+//!   elements at [`ASSUMED_STRIDE`] in the vertex stage and [`WHOLE_BYTES`] elsewhere. A range
+//!   stops at [`RANGE_BYTES`] (counted `capped`), and a buffer without contents is named only
+//!   (counted `unread`).
+//! - **What it misses (a false match).** There is no generation counter on a texture here, so a
+//!   texture's hash is what its uses name (`Texture::use_key`, the same for every wrapper over one
+//!   IOSurface's bytes): an IOSurface rewritten by an app, or a target drawn again earlier in the
+//!   frame, hashes the same. `same-without-textures` is the other side of that. A pass that loads
+//!   its target hashes the load action, not what it loads (counted `loads`). Argument buffers and
+//!   `useResource` are not followed. A real reuse must also check each sampled surface's writes:
+//!   `IOSurfaceGetSeed` where the writer bumps it, or a count of passes ending on each target.
+//! - **Frames.** Nothing in the bridge ends a frame: backboardd swaps through IOMFB's SwapEnd in
+//!   the kernel, and it commits 1-2 command buffers per swap. So "previous frame" is the last pass
+//!   of the same size and draw class, which is the previous frame's for a pass that comes once per
+//!   frame, as the main pass does (100+ draws). `same-last8` covers classes that come more often.
+
+use super::{Assembly, DrawBuffers, RenderCommandEncoder, RenderStateKind};
+use crate::argument_table::ArgumentTable;
+use crate::buffer::Buffer;
+use crate::key_hash::KeyHasher;
+use crate::render_pass::RenderPassDescriptor;
+use crate::render_values::LoadAction;
+use metal2vulkan::bind::DrawCall;
+use metal2vulkan::metal::VertexStepFunction;
+use metal2vulkan::pipeline::{SlotInterface, Stage, Window};
+use metal2vulkan::vk;
+use std::collections::BTreeMap;
+use std::hash::{Hash, Hasher};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+/// The most bytes hashed of one buffer range.
+const RANGE_BYTES: u64 = 64 * 1024;
+/// Bytes hashed of a slot outside the vertex stage whose window has no bound.
+const WHOLE_BYTES: u64 = 256;
+/// Core Animation's vertex stride (the frontend's sweet cull assumes it too, from its draw log),
+/// for a vertex-stage slot whose window has no bound and no layout.
+const ASSUMED_STRIDE: u64 = 48;
+/// A line per size and class at most this often. Nothing here counts frames (the module docs).
+const LOG_EVERY: Duration = Duration::from_secs(2);
+/// Lines per [`LOG_EVERY`], the largest passes first.
+const LOG_LINES: usize = 6;
+
+/// The fields, in the order `first-diff` looks for the first that differs.
+const FIELDS: [&str; 9] = [
+    "pso",
+    "counts",
+    "state",
+    "inline-bytes",
+    "buffer-contents",
+    "buffer-identity",
+    "texture",
+    "attachment",
+    "target",
+];
+const PSO: usize = 0;
+const COUNTS: usize = 1;
+const STATE: usize = 2;
+const BYTES: usize = 3;
+const BUFFER_DATA: usize = 4;
+const BUFFER_ID: usize = 5;
+const TEXTURE: usize = 6;
+const TARGET: usize = 8;
+
+/// Whether this process hashes its passes (the module docs): read once, at each encoder's opening.
+pub(super) fn requested() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| match std::env::var("SWEET_PASSHASH").as_deref() {
+        Ok("1") => std::env::args()
+            .next()
+            .is_some_and(|name| name.rsplit('/').next() == Some("backboardd")),
+        Ok("2") => true,
+        _ => false,
+    })
+}
+
+/// A pass's hashes so far.
+pub(super) struct PassHash {
+    fields: [KeyHasher; FIELDS.len()],
+    extent: [u32; 2],
+    draws: u64,
+    /// A command that isn't hashed (a tile dispatch, an execution, an indirect or mesh draw): the
+    /// pass never counts as repeating.
+    opaque: bool,
+    /// Its first color attachment loads.
+    loads: bool,
+    nanos: u64,
+    bytes: u64,
+    capped: u64,
+    unread: u64,
+}
+
+impl PassHash {
+    /// The hashes of a pass of `descriptor` and `extent`: its attachments.
+    pub(super) fn open(descriptor: &RenderPassDescriptor, extent: [u32; 2]) -> Box<PassHash> {
+        let began = Instant::now();
+        let mut pass = Box::new(PassHash {
+            fields: [KeyHasher::default(); FIELDS.len()],
+            extent,
+            draws: 0,
+            opaque: false,
+            loads: descriptor.color_attachments[0].load_action == LoadAction::Load,
+            nanos: 0,
+            bytes: 0,
+            capped: 0,
+            unread: 0,
+        });
+        // `attachment` and `target`, the last two fields.
+        let [.., actions, targets] = &mut pass.fields;
+        for color in &descriptor.color_attachments {
+            let Some(texture) = &color.texture else {
+                actions.write_u64(u64::MAX);
+                continue;
+            };
+            texture.use_key().hash(targets);
+            targets.write_u64(color.level);
+            targets.write_u64(color.slice);
+            targets.write_u64(color.depth_plane);
+            color.load_action.hash(actions);
+            color.store_action.hash(actions);
+            for channel in color.clear_color.channels() {
+                actions.write_u64(channel.to_bits());
+            }
+        }
+        let depth = &descriptor.depth_attachment;
+        if let Some(texture) = &depth.texture {
+            texture.use_key().hash(targets);
+            depth.load_action.hash(actions);
+            depth.store_action.hash(actions);
+            actions.write_u64(depth.clear_depth.to_bits());
+        }
+        let stencil = &descriptor.stencil_attachment;
+        if let Some(texture) = &stencil.texture {
+            texture.use_key().hash(targets);
+            stencil.load_action.hash(actions);
+            stencil.store_action.hash(actions);
+            actions.write_u32(stencil.clear_stencil);
+        }
+        pass.nanos = began.elapsed().as_nanos() as u64;
+        pass
+    }
+
+    /// Hash `len` bytes from `at` into `field`.
+    fn contents(&mut self, field: usize, at: *const u8, len: u64) {
+        let hasher = &mut self.fields[field];
+        hasher.write_u64(len);
+        let mut done = 0;
+        // SAFETY: the caller's `at` to `at + len` lies in a mapped buffer. Read a word at a time,
+        // no reference made: a command buffer in flight may be reading or writing these bytes.
+        unsafe {
+            while done + 8 <= len {
+                hasher.write_u64(at.add(done as usize).cast::<u64>().read_unaligned());
+                done += 8;
+            }
+            let mut last = 0u64;
+            for (index, at) in (done..len).map(|byte| at.add(byte as usize)).enumerate() {
+                last |= u64::from(at.read()) << (index * 8);
+            }
+            hasher.write_u64(last);
+        }
+        self.bytes += len;
+    }
+
+    /// Hash `buffer` as bound at `slot` and `offset` of a table, and its bytes `from` to `from +
+    /// len` past the offset.
+    fn buffer_range(&mut self, slot: u32, buffer: &Buffer, offset: u64, from: i64, len: u64) {
+        let identity = &mut self.fields[BUFFER_ID];
+        identity.write_u32(slot);
+        buffer.object_id().hash(identity);
+        identity.write_u64(offset);
+        let start = offset.saturating_add_signed(from).min(buffer.length());
+        let held = buffer.length() - start;
+        if len.min(held) > RANGE_BYTES {
+            self.capped += 1;
+        }
+        let Some(contents) = buffer.contents() else {
+            self.unread += 1;
+            return;
+        };
+        // In the buffer's length, which its contents' mapping covers.
+        let at = contents.as_ptr().wrapping_add(start as usize) as *const u8;
+        self.contents(BUFFER_DATA, at, len.min(held).min(RANGE_BYTES));
+    }
+
+    /// Hash inline bytes bound at `slot`.
+    fn inline_bytes(&mut self, slot: u32, bytes: &crate::argument_table::InlineBytes) {
+        self.fields[BYTES].write_u32(slot);
+        match bytes.region.sweet_contents() {
+            Some(at) => self.contents(BYTES, at, u64::from(bytes.len)),
+            None => self.unread += 1,
+        }
+    }
+
+    /// The pass's end: count it (`opaque`, it never repeats), and log what is due.
+    pub(super) fn finish(mut self: Box<PassHash>, opaque: bool) {
+        let began = Instant::now();
+        let hashes: [u64; FIELDS.len()] = self.fields.map(|field| field.finish());
+        let mut lines = Vec::new();
+        {
+            static STATS: Mutex<Stats> = Mutex::new(Stats {
+                buckets: BTreeMap::new(),
+                logged: None,
+            });
+            let Ok(mut stats) = STATS.lock() else {
+                return;
+            };
+            let class = match self.draws {
+                0 => 0,
+                1..=31 => 1,
+                32..=99 => 2,
+                _ => 3,
+            };
+            let bucket = stats.buckets.entry((self.extent, class)).or_default();
+            bucket.count(hashes, self.opaque || opaque);
+            bucket.draws += self.draws;
+            bucket.loads += u64::from(self.loads);
+            bucket.bytes += self.bytes;
+            bucket.capped += self.capped;
+            bucket.unread += self.unread;
+            self.nanos += began.elapsed().as_nanos() as u64;
+            bucket.nanos += self.nanos;
+            stats.log_into(&mut lines);
+        }
+        for line in lines {
+            crate::pipestats::line(&line);
+        }
+    }
+}
+
+/// What this process's passes of one size and draw class came to since the last line.
+#[derive(Default)]
+struct Bucket {
+    /// The last 8 passes' hashes, newest at `next - 1`.
+    ring: [[u64; FIELDS.len()]; 8],
+    filled: usize,
+    next: usize,
+    passes: u64,
+    draws: u64,
+    same: u64,
+    same_without_buffers: u64,
+    same_without_textures: u64,
+    same_content: u64,
+    same_last8: u64,
+    same_content_last8: u64,
+    first: [u64; FIELDS.len()],
+    loads: u64,
+    nanos: u64,
+    bytes: u64,
+    capped: u64,
+    unread: u64,
+}
+
+/// The fields a pass that repeats may differ in once a buffer's place and a target stop mattering:
+/// its bytes alone, as a pass drawn into a surface of a flip chain, from a ring buffer, would be.
+const CONTENT: u32 = !(1 << BUFFER_ID | 1 << TARGET);
+
+/// Which fields of `a` and `b` differ.
+fn differing(a: &[u64; FIELDS.len()], b: &[u64; FIELDS.len()]) -> u32 {
+    (0..FIELDS.len()).fold(0, |mask, field| mask | u32::from(a[field] != b[field]) << field)
+}
+
+impl Bucket {
+    /// Count a pass of `hashes` against the last ones, and keep it.
+    fn count(&mut self, hashes: [u64; FIELDS.len()], opaque: bool) {
+        self.passes += 1;
+        let kept = (0..self.filled).map(|back| self.ring[(self.next + 7 - back) % 8]);
+        if !opaque {
+            if self.filled > 0 {
+                let mask = differing(&self.ring[(self.next + 7) % 8], &hashes);
+                self.same += u64::from(mask == 0);
+                self.same_without_buffers +=
+                    u64::from(mask & !(1 << BUFFER_DATA | 1 << BUFFER_ID) == 0);
+                self.same_without_textures += u64::from(mask & !(1 << TEXTURE) == 0);
+                self.same_content += u64::from(mask & CONTENT == 0);
+                if mask != 0 {
+                    self.first[mask.trailing_zeros() as usize] += 1;
+                }
+            }
+            let masks = kept.map(|last| differing(&last, &hashes));
+            let (mut any, mut content) = (false, false);
+            for mask in masks {
+                any |= mask == 0;
+                content |= mask & CONTENT == 0;
+            }
+            self.same_last8 += u64::from(any);
+            self.same_content_last8 += u64::from(content);
+        }
+        self.ring[self.next] = hashes;
+        self.next = (self.next + 1) % 8;
+        self.filled = (self.filled + 1).min(8);
+    }
+
+    /// The counts since the last line gone, its hashes kept.
+    fn clear_counts(&mut self) {
+        *self = Bucket {
+            ring: self.ring,
+            filled: self.filled,
+            next: self.next,
+            ..Bucket::default()
+        };
+    }
+
+    fn line(&self, [width, height]: [u32; 2], class: u8) -> String {
+        let passes = self.passes.max(1);
+        let most = (0..FIELDS.len()).max_by_key(|&field| (self.first[field], FIELDS.len() - field));
+        let first_diff = most
+            .filter(|&field| self.first[field] != 0)
+            .map_or("none", |field| FIELDS[field]);
+        let firsts: Vec<String> = (0..FIELDS.len())
+            .filter(|&field| self.first[field] != 0)
+            .map(|field| format!("{}:{}", FIELDS[field], self.first[field]))
+            .collect();
+        format!(
+            "SWEET_PASSHASH size={width}x{height} class={} draws={} passes={} same-as-prev-frame={} same-without-buffers={} same-without-textures={} same-content={} same-last8={} same-content-last8={} first-diff={first_diff} first=[{}] loads={} hash-us={} kb={} capped={} unread={}",
+            ["0", "1-31", "32-99", "100+"][usize::from(class)],
+            self.draws,
+            self.passes,
+            self.same,
+            self.same_without_buffers,
+            self.same_without_textures,
+            self.same_content,
+            self.same_last8,
+            self.same_content_last8,
+            firsts.join(","),
+            self.loads,
+            self.nanos / passes / 1000,
+            self.bytes / passes / 1024,
+            self.capped,
+            self.unread,
+        )
+    }
+}
+
+/// This process's counts, by pass size and draw class.
+struct Stats {
+    buckets: BTreeMap<([u32; 2], u8), Bucket>,
+    logged: Option<Instant>,
+}
+
+impl Stats {
+    /// Past [`LOG_EVERY`] since the last lines, the next ones into `lines`, and the counts cleared.
+    fn log_into(&mut self, lines: &mut Vec<String>) {
+        let now = Instant::now();
+        let Some(logged) = self.logged else {
+            self.logged = Some(now);
+            return;
+        };
+        if now.duration_since(logged) < LOG_EVERY {
+            return;
+        }
+        self.logged = Some(now);
+        let mut largest: Vec<_> = self
+            .buckets
+            .iter()
+            .filter(|(_, bucket)| bucket.passes != 0)
+            .map(|(key, bucket)| {
+                let [width, height] = key.0;
+                (u64::from(width) * u64::from(height) * bucket.passes, *key)
+            })
+            .collect();
+        largest.sort_unstable_by_key(|&(pixels, _)| std::cmp::Reverse(pixels));
+        for &(_, (extent, class)) in largest.iter().take(LOG_LINES) {
+            lines.push(self.buckets[&(extent, class)].line(extent, class));
+        }
+        let more = largest.len().saturating_sub(LOG_LINES);
+        if let (Some(line), 1..) = (lines.last_mut(), more) {
+            line.push_str(&format!(" more-sizes={more}"));
+        }
+        // Sizes come and go with an animation's blur: the ones of this window stay.
+        self.buckets.retain(|_, bucket| bucket.passes != 0);
+        self.buckets.values_mut().for_each(Bucket::clear_counts);
+    }
+}
+
+impl RenderCommandEncoder {
+    /// Hash `draw` into `pass` (the module docs).
+    pub(super) fn sweet_passhash_draw(
+        &self,
+        pass: &mut PassHash,
+        assembly: &Assembly,
+        draw: &DrawCall,
+        buffers: &DrawBuffers<'_>,
+    ) {
+        let began = Instant::now();
+        pass.draws += 1;
+        let Some(RenderStateKind::Graphics(state)) =
+            self.pipeline.as_ref().map(|pipeline| pipeline.kind())
+        else {
+            pass.opaque = true;
+            return;
+        };
+        pass.fields[PSO].write_usize(state.sweet_address());
+        self.state.sweet_hash(&mut pass.fields[STATE]);
+        // The counts, and the elements (first, past the last) a per-vertex layout fetches.
+        let counts = &mut pass.fields[COUNTS];
+        match assembly {
+            Assembly::Primitives(primitive) => std::mem::discriminant(primitive).hash(counts),
+            _ => pass.opaque = true,
+        }
+        let (vertices, instances) = match *draw {
+            DrawCall::Primitives {
+                vertex_start,
+                vertex_count,
+                instance_count,
+                base_instance,
+            } => {
+                let counts = &mut pass.fields[COUNTS];
+                counts.write_u32(vertex_start);
+                counts.write_u32(vertex_count);
+                counts.write_u32(instance_count);
+                counts.write_u32(base_instance);
+                let start = u64::from(vertex_start);
+                (
+                    Some((start, start + u64::from(vertex_count))),
+                    (u64::from(base_instance), u64::from(instance_count)),
+                )
+            }
+            DrawCall::Indexed {
+                index_type,
+                index_count,
+                instance_count,
+                base_vertex,
+                base_instance,
+                ..
+            } => {
+                let counts = &mut pass.fields[COUNTS];
+                counts.write_u32(index_count);
+                counts.write_u32(instance_count);
+                counts.write_i32(base_vertex);
+                counts.write_u32(base_instance);
+                counts.write_u8(u8::from(index_type == vk::IndexType::UINT16));
+                let vertices = hash_indices(pass, buffers, index_type, index_count, base_vertex);
+                (vertices, (u64::from(base_instance), u64::from(instance_count)))
+            }
+            _ => {
+                pass.opaque = true;
+                (None, (0, 1))
+            }
+        };
+        // The vertex layouts' buffers, over the elements the draw fetches.
+        let layouts = state
+            .descriptor()
+            .vertex()
+            .and_then(|descriptor| descriptor.vertex_descriptor.as_ref())
+            .map(|vertex| &vertex.layouts);
+        for (&slot, layout) in layouts.into_iter().flatten() {
+            if let Some(bytes) = self.vertex.bytes.get(&slot) {
+                pass.inline_bytes(slot, bytes);
+                continue;
+            }
+            let Some((buffer, offset)) = self.vertex.buffers.get(&slot) else {
+                continue;
+            };
+            let stride = match layout.stride {
+                Some(stride) => stride,
+                None => self.vertex.attribute_strides.get(&slot).copied().unwrap_or(0),
+            };
+            let stride = u64::from(stride);
+            let (first, end) = match layout.step_function {
+                VertexStepFunction::PerVertex => vertices.unwrap_or((0, 1)),
+                VertexStepFunction::PerInstance => {
+                    let (base, count) = instances;
+                    (base, base + count / u64::from(layout.step_rate.max(1)) + 1)
+                }
+                _ => (0, 1),
+            };
+            let from = first.saturating_mul(stride) as i64;
+            let len = end.saturating_sub(first).saturating_mul(stride.max(1));
+            pass.buffer_range(slot, buffer, *offset, from, len);
+        }
+        // The slots the pipeline's functions read.
+        for (slot, interface) in &state.base().interface.slots {
+            let table: &ArgumentTable = match slot.stage {
+                Stage::Vertex => &self.vertex,
+                Stage::Fragment => &self.fragment,
+                Stage::Object => &self.object,
+                Stage::Mesh => &self.mesh,
+                _ => continue,
+            };
+            let index = slot.index;
+            match interface {
+                SlotInterface::Buffer(read) => {
+                    if slot.stage == Stage::Vertex
+                        && layouts.is_some_and(|layouts| layouts.contains_key(&index))
+                    {
+                        continue;
+                    }
+                    if let Some(bytes) = table.bytes.get(&index) {
+                        pass.inline_bytes(index, bytes);
+                        continue;
+                    }
+                    let Some((buffer, offset)) = table.buffers.get(&index) else {
+                        continue;
+                    };
+                    let (from, len) = match (read.window, slot.stage, vertices) {
+                        (Window::Bounded { start, len }, ..) => (start, len),
+                        (Window::Whole, Stage::Vertex, Some((first, end))) => (
+                            first.saturating_mul(ASSUMED_STRIDE) as i64,
+                            end.saturating_sub(first).saturating_mul(ASSUMED_STRIDE),
+                        ),
+                        _ => (0, WHOLE_BYTES),
+                    };
+                    pass.buffer_range(index, buffer, *offset, from, len);
+                }
+                SlotInterface::Texture(_) => {
+                    let hasher = &mut pass.fields[TEXTURE];
+                    hasher.write_u32(index);
+                    if let Some(texture) = table.textures.get(&index) {
+                        texture.use_key().hash(hasher);
+                    }
+                }
+                SlotInterface::Sampler(_) => {
+                    let hasher = &mut pass.fields[STATE];
+                    hasher.write_u32(index);
+                    if let Some((sampler, clamps)) = table.samplers.get(&index) {
+                        hasher.write_usize(sampler.address());
+                        for clamp in clamps.iter().flatten() {
+                            hasher.write_u32(clamp.to_bits());
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+        pass.nanos += began.elapsed().as_nanos() as u64;
+    }
+}
+
+/// Hash an indexed draw's index buffer and indices. The elements (first, past the last) they
+/// fetch, the primitive-restart index aside, unless the buffer has no contents.
+fn hash_indices(
+    pass: &mut PassHash,
+    buffers: &DrawBuffers<'_>,
+    index_type: vk::IndexType,
+    count: u32,
+    base_vertex: i32,
+) -> Option<(u64, u64)> {
+    let source = buffers.index.as_ref()?;
+    let size: u64 = if index_type == vk::IndexType::UINT16 { 2 } else { 4 };
+    let len = u64::from(count) * size;
+    pass.buffer_range(u32::MAX, source.buffer, source.offset, 0, len);
+    let contents = source.buffer.contents()?;
+    let held = source.buffer.length().saturating_sub(source.offset);
+    let at = contents.as_ptr().wrapping_add(source.offset as usize) as *const u8;
+    let (mut lowest, mut highest) = (u64::MAX, 0);
+    for index in 0..len.min(held).min(RANGE_BYTES) / size {
+        // SAFETY: inside the buffer's length. As `PassHash::contents`, a word at a time.
+        let value = unsafe {
+            let at = at.add((index * size) as usize);
+            match size {
+                2 => u64::from(at.cast::<u16>().read_unaligned()),
+                _ => u64::from(at.cast::<u32>().read_unaligned()),
+            }
+        };
+        if value != (1 << (size * 8)) - 1 {
+            lowest = lowest.min(value);
+            highest = highest.max(value);
+        }
+    }
+    (lowest != u64::MAX).then(|| {
+        let base = i64::from(base_vertex);
+        let at = |value: u64| (value as i64).saturating_add(base).max(0) as u64;
+        (at(lowest), at(highest) + 1)
+    })
+}
