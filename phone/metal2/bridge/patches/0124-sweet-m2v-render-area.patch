+/// 0124: whether a pass's render area shrinks to its draws' bounds (env `SWEET_M2V_RENDER_AREA`,
+/// off unless set and not `0`; `sweet_render_area`).
+fn sweet_render_area_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var("SWEET_M2V_RENDER_AREA")
+            .is_ok_and(|v| !v.trim().is_empty() && v.trim() != "0")
+    })
+}
+
+/// 0124's counts of this process, from `SWEET_M2V_RENDER_AREA` on: passes seen, passes shrunk,
+/// pixels left out of their render areas; and the time of the first pass, for the rate.
+static SWEET_RENDER_AREA_COUNTS: [std::sync::atomic::AtomicU64; 3] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 3];
+static SWEET_RENDER_AREA_START: std::sync::OnceLock<std::time::Instant> =
+    std::sync::OnceLock::new();
+
+/// 0124: `layout`'s render area shrunk to the bounds of `drawn`, the pixels the pass's draws may
+/// write (each draw's Vulkan scissors, already clipped to its viewports), aligned outward to 32
+/// pixels and clamped to the extent: `None` to keep the whole area. Vulkan keeps every texel
+/// outside the render area, loads and stores only inside it (Turnip: its GMEM load and store
+/// blits are scissored to the area, `tu6_emit_blit_scissor`), and the draws' coordinates stay
+/// the framebuffer's, so the pass writes what it wrote. Kept whole where anything but the draws
+/// may write past them: a pass not `simple` (an execution of render commands, a pending
+/// pipeline, a tile dispatch, an imageblock, any resolve), several samples or sample planes, a
+/// `Clear` load of an attachment that is not memoryless (after the `DontCare` loads became
+/// clears), or draws whose pixels are not bounded (a rate map, an execution) or absent. Logs its
+/// counts at the first pass and rarely after.
+fn sweet_render_area(
+    layout: &PassLayout,
+    drawn: &clear_reach::DrawnArea,
+    simple: bool,
+) -> Option<vk::Rect2D> {
+    use std::sync::atomic::Ordering::Relaxed;
+    let counts = &SWEET_RENDER_AREA_COUNTS;
+    let start = *SWEET_RENDER_AREA_START.get_or_init(std::time::Instant::now);
+    let [width, height] = layout.extent;
+    let cleared = layout
+        .colors
+        .iter()
+        .flatten()
+        .any(|c| !c.memoryless && (c.load == LoadAction::Clear || c.planes.is_some()))
+        || layout.depth_stencil.as_ref().is_some_and(|ds| {
+            [ds.depth, ds.stencil]
+                .iter()
+                .flatten()
+                .any(|a| !a.memoryless && a.load == LoadAction::Clear)
+        });
+    let area = (simple && !cleared && layout.samples == 1 && width > 0 && height > 0)
+        .then(|| drawn.bounds())
+        .flatten()
+        .map(|[x0, y0, x1, y1]| {
+            const ALIGN: u32 = 32;
+            let (x0, y0) = ((x0 / ALIGN * ALIGN).min(width), (y0 / ALIGN * ALIGN).min(height));
+            let x1 = x1.div_ceil(ALIGN).saturating_mul(ALIGN).min(width);
+            let y1 = y1.div_ceil(ALIGN).saturating_mul(ALIGN).min(height);
+            [x0, y0, x1, y1]
+        })
+        .filter(|&[x0, y0, x1, y1]| {
+            x1 > x0 && y1 > y0 && (x1 - x0, y1 - y0) != (width, height)
+        })
+        .map(|[x0, y0, x1, y1]| vk::Rect2D {
+            offset: vk::Offset2D {
+                x: x0 as i32,
+                y: y0 as i32,
+            },
+            extent: vk::Extent2D {
+                width: x1 - x0,
+                height: y1 - y0,
+            },
+        });
+    if let Some(area) = &area {
+        counts[1].fetch_add(1, Relaxed);
+        let whole = u64::from(width) * u64::from(height);
+        let kept = u64::from(area.extent.width) * u64::from(area.extent.height);
+        counts[2].fetch_add((whole - kept) * u64::from(layout.layers.max(1)), Relaxed);
+    }
+    // At the 1st pass, each power of two from the 256th to the 4096th, and every 4096th after.
+    let passes = counts[0].fetch_add(1, Relaxed) + 1;
+    if passes == 1 || (passes >= 256 && passes.is_power_of_two()) || passes % 4096 == 0 {
+        let saved = counts[2].load(Relaxed) as f64 / 1e6;
+        let secs = start.elapsed().as_secs_f64().max(1e-3);
+        crate::pipestats::line(&format!(
+            "SWEET_M2V_RENDER_AREA RA shrunk {} passes of {passes}, {saved:.1} Mpx, {:.1} Mpx/s",
+            counts[1].load(Relaxed),
+            saved / secs
+        ));
+    }
+    area
+}
