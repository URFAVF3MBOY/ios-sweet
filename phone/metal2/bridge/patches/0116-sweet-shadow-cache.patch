+/// 0116: a texture of `rows` rows of 64 bytes, 128 bytes apart.
+fn cache_layout(rows: u64) -> BufferLayout {
+    BufferLayout {
+        offset: 0,
+        row_pitch: 128,
+        slice_pitch: 128 * rows,
+        row_bytes: 64,
+        rows,
+        slices: 1,
+    }
+}
+
+#[test]
+fn cache_hash_reads_every_row_up_to_the_whole_limit() {
+    // 2048 rows of 128 bytes: 256 KB exactly.
+    let layout = cache_layout(2048);
+    let mut bytes = vec![7u8; 128 * 2048];
+    // SAFETY: the rows lie in `bytes`.
+    let (first, read) = unsafe { cache_hash(bytes.as_ptr(), &layout) };
+    assert_eq!(read, 64 * 2048);
+    bytes[128 * 1001] ^= 1;
+    // SAFETY: as above.
+    let (second, _) = unsafe { cache_hash(bytes.as_ptr(), &layout) };
+    assert_ne!(first, second);
+}
+
+#[test]
+fn cache_hash_past_the_limit_reads_the_ends_and_every_16th_row() {
+    let layout = cache_layout(2049);
+    let mut bytes = vec![7u8; 128 * 2049];
+    let hash = |bytes: &[u8]| {
+        // SAFETY: the rows lie in `bytes`.
+        unsafe { cache_hash(bytes.as_ptr(), &layout) }
+    };
+    let (first, read) = hash(&bytes);
+    // Rows 0, 16, .. 2048, the last among them.
+    assert_eq!(read, 64 * 129);
+    for (row, seen) in [(0, true), (1, false), (16, true), (2047, false), (2048, true)] {
+        let at = 128 * row;
+        bytes[at] ^= 1;
+        assert_eq!(hash(&bytes).0 != first, seen, "row {row}");
+        bytes[at] ^= 1;
+    }
+    // The bytes between rows are no texels.
+    bytes[64] ^= 1;
+    assert_eq!(hash(&bytes).0, first);
+}
