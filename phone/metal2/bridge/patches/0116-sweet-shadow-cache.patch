+/// 0116 (Home and Control Center repeat shadow fills): `M2V_SHADOW_CACHE`, read once. 0: every
+/// copy in, as ever. 1 or unset: a color texture's copy in over a buffer is skipped while a hash of
+/// its source texels, taken as the copy is planned, matches the last copy's. 2: skipped after the
+/// first copy whatever the bytes hold (a ceiling test, stale content expected). Both copy where
+/// the encoder's command writes through the texture, the texture was written through or its
+/// truth written by a command (`cache_written`), or the buffer's pages moved. The hash sees the
+/// CPU's writes up to the moment it runs: one between then and the GPU's read shows only at the
+/// next use, and in a texture over 256 KB one outside the rows hashed not until those change.
+fn cache_mode() -> u8 {
+    static MODE: OnceLock<u8> = OnceLock::new();
+    *MODE.get_or_init(|| {
+        let mode = match std::env::var("M2V_SHADOW_CACHE").as_deref() {
+            Err(_) | Ok("" | "1") => 1,
+            Ok("2") => 2,
+            _ => 0,
+        };
+        if mode != 0 {
+            cache_line(&format!("M2V_SHADOW_CACHE={mode}"));
+        }
+        mode
+    })
+}
+
+/// 0116: one line into /dev/console and /var/local/mtl2.log, as 0108's.
+fn cache_line(text: &str) {
+    use std::io::Write;
+    let line = format!(
+        "MTL2[{} {}]: {text}\n",
+        std::process::id(),
+        std::env::args().next().unwrap_or_default()
+    );
+    for path in ["/dev/console", "/var/local/mtl2.log"] {
+        if let Ok(mut file) = std::fs::OpenOptions::new().append(true).open(path) {
+            let _ = file.write_all(line.as_bytes());
+        }
+    }
+}
+
+/// 0116: bytes from which a texture's texels are sampled: at most this much is hashed whole.
+const CACHE_WHOLE_BYTES: u64 = 256 * 1024;
+/// 0116: writes by commands, per slot a key hashes to. A shared slot costs a needless copy only.
+static CACHE_WRITES: [AtomicU64; 4096] = [const { AtomicU64::new(0) }; 4096];
+/// 0116: work recorded apart from the encoders' commands (`ShadowSync::leave`), which may write
+/// anything.
+static CACHE_LEFT: AtomicU64 = AtomicU64::new(0);
+static CACHE_COPIES: AtomicU64 = AtomicU64::new(0);
+static CACHE_SKIPPED: AtomicU64 = AtomicU64::new(0);
+static CACHE_HASHED: AtomicU64 = AtomicU64::new(0);
+static CACHE_HASH_US: AtomicU64 = AtomicU64::new(0);
+
+fn cache_slot(key: ResourceKey) -> &'static AtomicU64 {
+    let mut hasher = KeyHasher::default();
+    key.hash(&mut hasher);
+    &CACHE_WRITES[hasher.finish() as usize % CACHE_WRITES.len()]
+}
+
+/// 0116: a command wrote `key`, perhaps not yet run: what a hash of its bytes says no longer counts.
+fn cache_written(key: ResourceKey) {
+    cache_slot(key).fetch_add(1, Ordering::Relaxed);
+}
+
+/// 0116: changes whenever a command wrote the truth or the shadow of `copies`.
+fn cache_stamp(copies: &ShadowCopies) -> u64 {
+    let read = |key: ResourceKey| cache_slot(key).load(Ordering::Relaxed);
+    let alias = copies.alias().map_or(0, read);
+    CACHE_LEFT
+        .load(Ordering::Relaxed)
+        .wrapping_add(read(copies.truth().0))
+        .wrapping_add(alias)
+        .wrapping_add(read(copies.shadow_key))
+}
+
+/// 0116: the `SHADOW:` line, at most once per 5 s, with what the counters gathered since the last.
+fn cache_log() {
+    static START: OnceLock<Instant> = OnceLock::new();
+    static LAST: AtomicU64 = AtomicU64::new(0);
+    let now = START.get_or_init(Instant::now).elapsed().as_secs();
+    let last = LAST.load(Ordering::Relaxed);
+    if now < last + 5
+        || LAST
+            .compare_exchange(last, now, Ordering::Relaxed, Ordering::Relaxed)
+            .is_err()
+    {
+        return;
+    }
+    cache_line(&format!(
+        "SHADOW: 5s copies {} skipped {} hashed {} KB, hash {} us",
+        CACHE_COPIES.swap(0, Ordering::Relaxed),
+        CACHE_SKIPPED.swap(0, Ordering::Relaxed),
+        CACHE_HASHED.swap(0, Ordering::Relaxed) / 1024,
+        CACHE_HASH_US.swap(0, Ordering::Relaxed),
+    ));
+}
+
+/// 0116: a hash of the texels from `base`, laid out as `layout` from its first byte, and the bytes
+/// it read: only rows, never the bytes between them, as a copy moves. Each slice's every row at up
+/// to [`CACHE_WHOLE_BYTES`] of source, else its first and last rows and every 16th.
+///
+/// # Safety
+///
+/// Every row of `layout` from `base` lies in mapped memory. A client may be writing it: a torn
+/// read gives a hash that differs, or one that matches what the row holds next.
+pub(super) unsafe fn cache_hash(base: *const u8, layout: &BufferLayout) -> (u64, u64) {
+    let whole = layout.row_pitch * layout.rows * layout.slices <= CACHE_WHOLE_BYTES;
+    let mut hasher = KeyHasher::default();
+    let mut bytes = 0;
+    for slice in 0..layout.slices {
+        for row in 0..layout.rows {
+            if !whole && row != 0 && row != layout.rows - 1 && !row.is_multiple_of(16) {
+                continue;
+            }
+            let at = slice * layout.slice_pitch + row * layout.row_pitch;
+            // SAFETY: the caller's contract.
+            let texels = unsafe {
+                std::slice::from_raw_parts(base.add(at as usize), layout.row_bytes as usize)
+            };
+            hasher.write(texels);
+            bytes += layout.row_bytes;
+        }
+    }
+    (hasher.finish(), bytes)
+}
