+/// Sunfish 0131: the fast form holds only 8-bit 4:2:0 codes read converted or through the sRGB
+/// curve, over both planes.
+#[test]
+fn the_fast_form_holds_the_video_layouts_alone() {
+    let conversion = CONVERSIONS[0];
+    for pf in HELD
+        .into_iter()
+        .chain(HELD_SUBSAMPLED.into_iter().flatten())
+        .chain(HELD_PACKED)
+    {
+        let codes = codes_of(pf);
+        let planes = YCbCrPlanes::new([4, 4], [0, 16], [64, 16], conversion, codes);
+        let held = matches!(pf, PixelFormat::YCBCR84202P | PixelFormat::YCBCR84202PSRGB);
+        assert_eq!(super::YCbCrFast::of(&planes, 0).is_some(), held, "{pf:?}");
+        // Over plane 1 (chroma codes 0, rows 0 apart): never.
+        let planes = YCbCrPlanes::new([4, 4], [0, 16], [64, 0], conversion, codes);
+        assert!(
+            super::YCbCrFast::of(&planes, 0).is_none(),
+            "{pf:?} over plane 1"
+        );
+    }
+    // The modules of a 1080p video surface's shape (and an odd one) on every committed profile.
+    for (_, p) in committed_profiles().expect("profiles") {
+        for pf in [PixelFormat::YCBCR84202P, PixelFormat::YCBCR84202PSRGB] {
+            for (size, chroma_at) in [([1920, 1080], 1920 * 1088), ([33, 17], 48 * 17)] {
+                let planes =
+                    YCbCrPlanes::new(size, [0, 1920], [chroma_at, 1920], conversion, codes_of(pf));
+                let fast = super::YCbCrFast::of(&planes, 0).expect("fast");
+                assert_valid(super::fast::typed_module(&fast).expect("module"), &p);
+            }
+        }
+    }
+}
