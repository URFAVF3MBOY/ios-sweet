+/// Sunfish 0131: the fast module's texels of `surface` over a texel buffer starting `base` bytes
+/// before its bytes, each channel's `v` of `v / 2048` or of `v / 8192`, both invocation orders
+/// alike; alpha checked to be 1.
+fn fast_texels(surface: &Surface, base: u32) -> Vec<[u16; 3]> {
+    let fast = super::YCbCrFast::of(&surface.planes, base).expect("a fast shape");
+    let m = super::fast::typed_module(&fast).expect("fast module");
+    let mut bytes = vec![0x5A; base as usize];
+    bytes.extend_from_slice(&surface.bytes);
+    let view = fast.view_bytes() as usize;
+    assert!(
+        view <= bytes.len() && view % 2 == 0,
+        "the view lies in the bytes"
+    );
+    let [w, h] = surface.planes.size;
+    let grid = match surface.planes.codes.output {
+        YCbCrOutput::Srgb => 8192.0,
+        _ => 2048.0,
+    };
+    let groups = fast.groups();
+    let mut runs = Vec::new();
+    for order in [Order::Forward, Order::Reverse] {
+        let mut texels = Image::new(super::fast::TEXELS, [view as u32 / 2, 1, 1], 1, 1, 1);
+        for (e, t) in texels.texels.iter_mut().enumerate() {
+            *t = [u32::from(bytes[2 * e]), u32::from(bytes[2 * e + 1]), 0, 1];
+        }
+        let image = Image::new(super::fast::IMAGE, [w, h, 1], 1, 1, 1);
+        let cfg = Config {
+            order,
+            workgroups: [groups[0], groups[1], 1],
+            ..Config::default()
+        };
+        let res = Resources {
+            buffers: Vec::new(),
+            push: Vec::new(),
+            spec: Default::default(),
+        };
+        let (_, images) = run_with_images(&m, &cfg, res, vec![image, texels]).expect("run");
+        let out: Vec<[u16; 3]> = images[0]
+            .texels
+            .iter()
+            .map(|t| {
+                assert_eq!(f32::from_bits(t[3]), 1.0, "alpha 1 (every texel written)");
+                std::array::from_fn(|c| {
+                    let v = f32::from_bits(t[c]) * grid;
+                    assert!(
+                        v == v.round() && (0.0..=grid).contains(&v),
+                        "{v} off the grid"
+                    );
+                    v as u16
+                })
+            })
+            .collect();
+        runs.push(out);
+    }
+    assert_eq!(runs[0], runs[1], "order independent");
+    runs.swap_remove(0)
+}
+
+/// Sunfish 0131: the fast module writes the module's texels, every one, of random surfaces and of
+/// a test pattern (bars of luma, a chroma ramp), even and odd sizes, under every range and matrix,
+/// read converted and through the sRGB curve, its texel buffer at several places before the planes.
+#[test]
+fn the_fast_kernel_writes_the_kernels_texels() {
+    let shapes: [([u32; 2], u32, [u32; 2]); 6] = [
+        ([1, 1], 0, [16, 16]),
+        ([2, 2], 0, [16, 16]),
+        ([33, 17], 48, [48, 48]),
+        ([2, 3], 16, [16, 16]),
+        ([17, 9], 512, [32, 32]),
+        ([40, 24], 0, [48, 48]),
+    ];
+    let mut random = Random::ycf3(131);
+    for pf in [PixelFormat::YCBCR84202P, PixelFormat::YCBCR84202PSRGB] {
+        let codes = codes_of(pf);
+        for conversion in CONVERSIONS {
+            for (size, at, rows) in shapes {
+                let [w, h] = size;
+                let pattern = random.next() % 2 == 0;
+                let luma: Vec<u16> = (0..w * h)
+                    .map(|i| match pattern {
+                        true => [16, 235, 128, 0, 255, 81][((i % w) * 6 / w) as usize],
+                        false => u16::from(random.next()),
+                    })
+                    .collect();
+                let [cw, ch] =
+                    YCbCrPlanes::new(size, [0; 2], [0; 2], conversion, codes).chroma_size();
+                let chroma: Vec<u16> = (0..2 * cw * ch)
+                    .map(|i| match pattern {
+                        true => ((i * 37) % 256) as u16,
+                        false => u16::from(random.next()),
+                    })
+                    .collect();
+                let surface = Surface::new(
+                    size,
+                    at,
+                    rows,
+                    (conversion, codes),
+                    &|x, y| luma[(y * w + x) as usize],
+                    &|x, y| {
+                        let i = (2 * (y * cw + x)) as usize;
+                        [chroma[i], chroma[i + 1]]
+                    },
+                );
+                let want = surface.converted();
+                for base in [0, 2, 62] {
+                    assert_eq!(
+                        fast_texels(&surface, base),
+                        want,
+                        "{pf:?} {conversion:?} {size:?} base {base}"
+                    );
+                }
+            }
+        }
+    }
+}
