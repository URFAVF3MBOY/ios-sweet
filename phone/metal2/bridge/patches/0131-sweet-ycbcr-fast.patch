+//! Sunfish 0131 (G7): the fast YCbCr conversion. The texels of [`ycbcr_convert`](super)'s module,
+//! read from the surface's own bytes through a uniform texel buffer instead of a staging copy and
+//! storage-buffer words, for the layout a video decoder's surfaces hold (8-bit 4:2:0 codes, `420v`
+//! and `420f`), read converted or through the sRGB curve.
+//!
+//! Taken from upstream metal2vulkan cdf59197 (`bind/ycbcr_in_place.rs`, "Read a YCbCr texture's
+//! planes in place"): the binding, an `R8G8_UINT` uniform texel buffer over the planes' bytes, one
+//! element two luma codes or one chroma pair (Vulkan requires the format's
+//! `UNIFORM_TEXEL_BUFFER` on every device), with each plane's place and rows in elements. Ours: it
+//! still fills the texture's image (no lowering of the functions that sample it), each invocation
+//! writes a 2 x 2 block of texels from the 3 x 3 chroma pairs around it (9 fetches and 2 luma
+//! fetches for 4 texels, where the module above loads 18 words a texel), and the shape is baked in
+//! as constants (as 0128's bake). The arithmetic is the module's: every texel is the one it writes.
+//!
+//! **The module** (one per shape). One `GLCompute` entry `main`, local size
+//! ([`YCbCrFast::LOCAL_SIZE`], [`YCbCrFast::LOCAL_SIZE`], 1), no push constants, in set 0:
+//! [`YCbCrFast::IMAGE_BINDING`], the texture's image as the module above binds it (`Rgba16f` or
+//! `Rgba32f`); [`YCbCrFast::TEXELS_BINDING`], the texel buffer, from [`YCbCrFast::base`] bytes
+//! before the planes' first byte, [`YCbCrFast::view_bytes`] long. Invocation `(i, j)` inside the
+//! chroma plane writes the texels `(2i + dx, 2j + dy)` inside the texture. The consumer dispatches
+//! [`YCbCrFast::groups`] and orders the planes' writes before `SHADER_SAMPLED_READ` in
+//! `COMPUTE_SHADER`.
+
+use std::sync::Arc;
+
+use super::{coefficients, knots_table, scalar, Cx, YCbCrOutput, YCbCrPlanes, YCbCrRange};
+use crate::budget::{Budget, Meter};
+use crate::device::requirements::Requirements;
+use crate::device::Device;
+use crate::error::{Error, InternalError, InternalKind};
+use crate::metal::format::ChromaSubsampling;
+use crate::pipeline::sym::{ResourceKind, ResourceSlot, Stage, Symbol};
+use crate::spirv::builder::constructs::{ArmEnd, ArmFn};
+use crate::spirv::builder::{FunctionBuilder, ModuleBuilder};
+use crate::spirv::error::BResult;
+use crate::spirv::ids::Value;
+use crate::spirv::ir::{
+    BinOp, ConvOp, Dim, ExecMode, ExecModel, GlslOp, ImageOperands, ImageType, ImageUsage, IoDir,
+    MemAccess, StorageClass, TexelMemory, Type, TypedModule,
+};
+
+/// Sunfish 0131: the shape of one fast conversion (the module docs): the planes, as the module
+/// above reads them from the span's first byte, and the bytes the texel buffer starts before it.
+#[non_exhaustive]
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct YCbCrFast {
+    planes: YCbCrPlanes,
+    base: u32,
+}
+
+impl YCbCrFast {
+    /// Descriptor set of every binding.
+    pub const SET: u32 = 0;
+    /// The texture's image: a 2D storage image, written.
+    pub const IMAGE_BINDING: u32 = 0;
+    /// The planes' bytes: an `R8G8_UINT` uniform texel buffer.
+    pub const TEXELS_BINDING: u32 = 1;
+    /// Invocations of one workgroup along x, and along y: a 2 x 2 block of texels each.
+    pub const LOCAL_SIZE: u32 = 8;
+
+    /// The fast form of `planes`, its texel buffer starting `base` bytes before their span: 8-bit
+    /// 4:2:0 codes, unpacked, read converted or through the sRGB curve, over both planes (not the
+    /// row of zeros a texture over plane 1 reads), every offset and row a whole element. `None`
+    /// for every other: the module above converts it.
+    pub fn of(planes: &YCbCrPlanes, base: u32) -> Option<YCbCrFast> {
+        let codes = planes.codes;
+        let even = [
+            planes.luma[0],
+            planes.luma[1],
+            planes.chroma[0],
+            planes.chroma[1],
+            base,
+        ]
+        .iter()
+        .all(|v| v % 2 == 0);
+        let fits = codes.bits == 8
+            && codes.bytes == 1
+            && !codes.packed
+            && codes.subsampling == ChromaSubsampling::Chroma420
+            && matches!(codes.output, YCbCrOutput::Converted | YCbCrOutput::Srgb)
+            && planes.chroma[1] != 0
+            && planes.size[0] > 0
+            && planes.size[1] > 0;
+        (fits && even).then_some(YCbCrFast {
+            planes: *planes,
+            base,
+        })
+    }
+
+    /// The planes.
+    pub fn planes(&self) -> &YCbCrPlanes {
+        &self.planes
+    }
+
+    /// The bytes the texel buffer starts before the planes' span.
+    pub fn base(&self) -> u32 {
+        self.base
+    }
+
+    /// The bytes of the planes' span the fetches reach: a row's last luma element holds the code
+    /// past an odd width's last.
+    pub fn reach(&self) -> u64 {
+        let p = &self.planes;
+        let [cw, ch] = p.chroma_size().map(u64::from);
+        let end =
+            |[at, row]: [u32; 2], rows: u64| u64::from(at) + u64::from(row) * (rows - 1) + 2 * cw;
+        end(p.luma, u64::from(p.size[1])).max(end(p.chroma, ch))
+    }
+
+    /// The bytes the texel buffer views, from its first: through the reach.
+    pub fn view_bytes(&self) -> u64 {
+        u64::from(self.base) + self.reach()
+    }
+
+    /// The workgroups the consumer dispatches: one invocation per chroma pair.
+    pub fn groups(&self) -> [u32; 2] {
+        self.planes
+            .chroma_size()
+            .map(|n| n.div_ceil(Self::LOCAL_SIZE))
+    }
+}
+
+/// The crate-owned fast YCbCr conversion module of one device and shape.
+#[non_exhaustive]
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct YCbCrFastModule {
+    /// SPIR-V 1.5 words, entry point `main`, bindings numbered as [`YCbCrFast`] states.
+    pub spirv: Arc<[u32]>,
+    /// What the module needs from the device.
+    pub requirements: Requirements,
+}
+
+/// The binding symbol of the image in the typed module.
+pub(super) const IMAGE: ResourceSlot = ResourceSlot {
+    stage: Stage::Kernel,
+    kind: ResourceKind::Texture,
+    index: 0,
+};
+/// The binding symbol of the texel buffer in the typed module.
+pub(super) const TEXELS: ResourceSlot = ResourceSlot {
+    stage: Stage::Kernel,
+    kind: ResourceKind::Texture,
+    index: 1,
+};
+
+/// The module of `fast` as a typed module, before serialization.
+pub(super) fn typed_module(fast: &YCbCrFast) -> BResult<TypedModule> {
+    let p = fast.planes;
+    let output = p.codes.output;
+    let [w, h] = p.size;
+    let [cw, ch] = p.chroma_size();
+    let mut b = ModuleBuilder::new();
+    let u32_ = b.ty(Type::Int {
+        width: 32,
+        signed: false,
+    })?;
+    let f32_ = b.ty(Type::Float { width: 32 })?;
+    let uvec2 = b.ty(Type::Vector { elem: u32_, len: 2 })?;
+    let uvec3 = b.ty(Type::Vector { elem: u32_, len: 3 })?;
+    let format = match output {
+        YCbCrOutput::Srgb => crate::spv::ImageFormat::Rgba32f,
+        _ => crate::spv::ImageFormat::Rgba16f,
+    };
+    let vec4 = b.ty(Type::Vector { elem: f32_, len: 4 })?;
+    let image_ty = b.ty(Type::Image(ImageType {
+        sampled_type: f32_,
+        dim: Dim::D2,
+        depth: false,
+        arrayed: false,
+        multisampled: false,
+        usage: ImageUsage::Storage,
+        format,
+    }))?;
+    let image = b.resource(IMAGE, StorageClass::UniformConstant, image_ty)?;
+    let texels_ty = b.ty(Type::Image(ImageType {
+        sampled_type: u32_,
+        dim: Dim::Buffer,
+        depth: false,
+        arrayed: false,
+        multisampled: false,
+        usage: ImageUsage::Sampled,
+        format: crate::spv::ImageFormat::Unknown,
+    }))?;
+    let texels = b.resource(TEXELS, StorageClass::UniformConstant, texels_ty)?;
+    let knots = match output {
+        YCbCrOutput::Srgb => Some(knots_table(&mut b, u32_)?),
+        _ => None,
+    };
+    let invocation = b.builtin(crate::spv::BuiltIn::GlobalInvocationId, IoDir::Input, uvec3)?;
+    let void = b.ty(Type::Void)?;
+    let mut f = b.function(void)?;
+    let zero = scalar(&mut f, u32_, 0)?;
+    let one = scalar(&mut f, u32_, 1)?;
+    // `bytes` is the module above's words binding, which nothing here reads.
+    let cx = Cx {
+        u32_,
+        zero,
+        one,
+        bytes: zero,
+    };
+    let invocation = f.module().global_value(invocation)?;
+    let invocation = f.load(invocation, MemAccess::default())?;
+    let i = f.composite_extract(invocation, &[0])?;
+    let j = f.composite_extract(invocation, &[1])?;
+    let cw_ = cx.uint(&mut f, cw)?;
+    let ch_ = cx.uint(&mut f, ch)?;
+    let in_x = f.binary(BinOp::ULessThan, i, cw_)?;
+    let in_y = f.binary(BinOp::ULessThan, j, ch_)?;
+    let inside = f.binary(BinOp::LogicalAnd, in_x, in_y)?;
+    let texels = f.module().global_value(texels)?;
+    let image = f.module().global_value(image)?;
+    let element = |at: u32| (fast.base + at) / 2;
+    let k = coefficients(p.range, p.matrix);
+    let block: ArmFn<'_, ()> = Box::new(move |f, _| {
+        let texels = f.load(texels, MemAccess::default())?;
+        let image = f.load(image, MemAccess::default())?;
+        // The pair (or luma codes) at element `e`: its first and second codes.
+        let fetch = |f: &mut FunctionBuilder<'_>, e: Value| -> BResult<[Value; 2]> {
+            let v = f.fetch(texels, e, &ImageOperands::default())?;
+            Ok([f.composite_extract(v, &[0])?, f.composite_extract(v, &[1])?])
+        };
+        // The pairs' columns and rows before, at and after `(i, j)`, clamped to the plane.
+        let around = |f: &mut FunctionBuilder<'_>, c: Value, n: u32| -> BResult<[Value; 3]> {
+            let at_start = f.binary(BinOp::IEqual, c, zero)?;
+            let before = f.binary(BinOp::ISub, c, one)?;
+            let before = f.select(at_start, zero, before)?;
+            let next = f.binary(BinOp::IAdd, c, one)?;
+            let last = cx.uint(f, n - 1)?;
+            let after = f.glsl(GlslOp::UMin, &[next, last])?;
+            Ok([before, c, after])
+        };
+        let cols = around(f, i, cw)?;
+        let rows = around(f, j, ch)?;
+        let three = cx.uint(f, 3)?;
+        let chroma_at = cx.uint(f, element(p.chroma[0]))?;
+        let chroma_row = cx.uint(f, p.chroma[1] / 2)?;
+        // Each row's sums across: `[dx][Cb, Cr]`, weighted 1 / 3 for an even column and 3 / 1
+        // for an odd one.
+        let mut across = Vec::with_capacity(3);
+        for r in rows {
+            let start = f.binary(BinOp::IMul, r, chroma_row)?;
+            let start = f.binary(BinOp::IAdd, chroma_at, start)?;
+            let mut pairs = Vec::with_capacity(3);
+            for c in cols {
+                let e = f.binary(BinOp::IAdd, start, c)?;
+                pairs.push(fetch(f, e)?);
+            }
+            let mut sums = [[zero; 2]; 2];
+            for component in 0..2 {
+                let mid = f.binary(BinOp::IMul, pairs[1][component], three)?;
+                sums[0][component] = f.binary(BinOp::IAdd, pairs[0][component], mid)?;
+                sums[1][component] = f.binary(BinOp::IAdd, mid, pairs[2][component])?;
+            }
+            across.push(sums);
+        }
+        let luma_at = cx.uint(f, element(p.luma[0]))?;
+        let luma_row = cx.uint(f, p.luma[1] / 2)?;
+        let eight = cx.uint(f, 8)?;
+        let four = cx.uint(f, 4)?;
+        let two_i = f.binary(BinOp::ShiftLeftLogical, i, one)?;
+        let two_j = f.binary(BinOp::ShiftLeftLogical, j, one)?;
+        for dy in 0..2u32 {
+            let dy_ = cx.uint(f, dy)?;
+            let y = f.binary(BinOp::IAdd, two_j, dy_)?;
+            // An odd height's last row: its block's second row lies past the texture, its luma
+            // fetched from the last row and its texels not written.
+            let y_inside = (dy == 1 && h % 2 == 1)
+                .then(|| -> BResult<Value> {
+                    let h_ = cx.uint(f, h)?;
+                    f.binary(BinOp::ULessThan, y, h_)
+                })
+                .transpose()?;
+            let luma_y = match y_inside {
+                Some(_) => {
+                    let last = cx.uint(f, h - 1)?;
+                    f.glsl(GlslOp::UMin, &[y, last])?
+                }
+                None => y,
+            };
+            let start = f.binary(BinOp::IMul, luma_y, luma_row)?;
+            let start = f.binary(BinOp::IAdd, luma_at, start)?;
+            let e = f.binary(BinOp::IAdd, start, i)?;
+            let lumas = fetch(f, e)?;
+            // Down: rows before and at weighted 1 / 3 for an even row, at and after 3 / 1.
+            let (upper, lower, upper_weight, lower_weight) = match dy {
+                0 => (&across[0], &across[1], one, three),
+                _ => (&across[1], &across[2], three, one),
+            };
+            for dx in 0..2u32 {
+                let mut chroma = [zero; 2];
+                for (component, c) in chroma.iter_mut().enumerate() {
+                    let a = f.binary(BinOp::IMul, upper[dx as usize][component], upper_weight)?;
+                    let b = f.binary(BinOp::IMul, lower[dx as usize][component], lower_weight)?;
+                    let s = f.binary(BinOp::IAdd, a, b)?;
+                    // `C = (S + 8) >> 4`.
+                    let s = f.binary(BinOp::IAdd, s, eight)?;
+                    *c = f.binary(BinOp::ShiftRightLogical, s, four)?;
+                }
+                let texel = convert(
+                    f,
+                    &cx,
+                    (f32_, vec4),
+                    (p.range, k, knots),
+                    lumas[dx as usize],
+                    chroma,
+                )?;
+                let dx_ = cx.uint(f, dx)?;
+                let x = f.binary(BinOp::IAdd, two_i, dx_)?;
+                let coord = f.composite_construct(uvec2, &[x, y])?;
+                // An odd width's last column, as an odd height's last row.
+                let x_inside = (dx == 1 && w % 2 == 1)
+                    .then(|| -> BResult<Value> {
+                        let w_ = cx.uint(f, w)?;
+                        f.binary(BinOp::ULessThan, x, w_)
+                    })
+                    .transpose()?;
+                let guard = match (x_inside, y_inside) {
+                    (Some(a), Some(b)) => Some(f.binary(BinOp::LogicalAnd, a, b)?),
+                    (a, b) => a.or(b),
+                };
+                let store: ArmFn<'_, ()> = Box::new(move |f, _| {
+                    f.write(
+                        image,
+                        coord,
+                        texel,
+                        &ImageOperands::default(),
+                        TexelMemory::PRIVATE,
+                    )?;
+                    Ok(ArmEnd::FallThrough(Vec::new()))
+                });
+                match guard {
+                    Some(guard) => {
+                        f.if_(&mut (), guard, store, None)?;
+                    }
+                    None => {
+                        store(f, &mut ())?;
+                    }
+                }
+            }
+        }
+        Ok(ArmEnd::FallThrough(Vec::new()))
+    });
+    f.if_(&mut (), inside, block, None)?;
+    f.ret(None)?;
+    let id = f.finish()?;
+    b.entry(
+        ExecModel::GLCompute,
+        id,
+        vec![ExecMode::LocalSize {
+            x: YCbCrFast::LOCAL_SIZE,
+            y: YCbCrFast::LOCAL_SIZE,
+            z: 1,
+        }],
+    )?;
+    b.finalize()
+}
+
+/// The texel of 8-bit luma code `luma` and chroma codes `[cb, cr]`, by the module above's
+/// arithmetic (`ycbcr_read`): the range's luma term, the matrix's `(kb, kr)` of each channel, onto
+/// the grid of `1 / 2048`, or through the sRGB curve's `knots` onto the grid of `1 / 8192`.
+fn convert(
+    f: &mut FunctionBuilder<'_>,
+    cx: &Cx,
+    (f32_, vec4): (crate::spirv::ids::TypeId, crate::spirv::ids::TypeId),
+    (range, k, knots): (
+        YCbCrRange,
+        [(i32, i32); 3],
+        Option<crate::spirv::ids::GlobalId>,
+    ),
+    luma: Value,
+    [cb, cr]: [Value; 2],
+) -> BResult<Value> {
+    // Counted as 10-bit codes (`<< 2`), less 512.
+    let two = cx.uint(f, 2)?;
+    let offset = cx.uint(f, 512)?;
+    let mut chroma = [cb, cr];
+    for c in chroma.iter_mut() {
+        let ten = f.binary(BinOp::ShiftLeftLogical, *c, two)?;
+        *c = f.binary(BinOp::ISub, ten, offset)?;
+    }
+    let l = match range {
+        // `9576 ((Y << 2) - 64)`.
+        YCbCrRange::Video => {
+            let y10 = f.binary(BinOp::ShiftLeftLogical, luma, two)?;
+            let sixty_four = cx.uint(f, 64)?;
+            let video = f.binary(BinOp::ISub, y10, sixty_four)?;
+            let scale = cx.uint(f, 9576)?;
+            f.binary(BinOp::IMul, video, scale)?
+        }
+        // `256 ⌊(32768 Y + 127) / 255⌋`.
+        YCbCrRange::Full => {
+            let fifteen = cx.uint(f, 15)?;
+            let wide = f.binary(BinOp::ShiftLeftLogical, luma, fifteen)?;
+            let half = cx.uint(f, 127)?;
+            let wide = f.binary(BinOp::IAdd, wide, half)?;
+            let max = cx.uint(f, 255)?;
+            let quotient = f.binary(BinOp::UDiv, wide, max)?;
+            let eight = cx.uint(f, 8)?;
+            f.binary(BinOp::ShiftLeftLogical, quotient, eight)?
+        }
+    };
+    let (bias, dropped, grid) = match knots {
+        Some(_) => (512, 10, 8192),
+        None => (2048, 12, 2048),
+    };
+    let round = cx.uint(f, bias)?;
+    let shift = cx.uint(f, dropped)?;
+    let top = cx.uint(f, grid)?;
+    let step = 1.0f32 / grid as f32;
+    let step = scalar(f, f32_, u64::from(step.to_bits()))?;
+    let mut channels = Vec::with_capacity(4);
+    for (kb, kr) in k {
+        let kb = cx.uint(f, kb as u32)?;
+        let kr = cx.uint(f, kr as u32)?;
+        let b_term = f.binary(BinOp::IMul, kb, chroma[0])?;
+        let r_term = f.binary(BinOp::IMul, kr, chroma[1])?;
+        let t = f.binary(BinOp::IAdd, l, b_term)?;
+        let t = f.binary(BinOp::IAdd, t, r_term)?;
+        let t = f.binary(BinOp::IAdd, t, round)?;
+        let v = f.binary(BinOp::ShiftRightArithmetic, t, shift)?;
+        let below = f.binary(BinOp::SLessThan, v, cx.zero)?;
+        let v = f.select(below, cx.zero, v)?;
+        let above = f.binary(BinOp::SGreaterThan, v, top)?;
+        let v = f.select(above, top, v)?;
+        let v = match knots {
+            Some(table) => cx.srgb_step(f, table, v)?,
+            None => v,
+        };
+        let v = f.convert(ConvOp::ConvertUToF, v, f32_)?;
+        channels.push(f.binary(BinOp::FMul, v, step)?);
+    }
+    channels.push(scalar(f, f32_, u64::from(1.0f32.to_bits()))?);
+    f.composite_construct(vec4, &channels)
+}
+
+/// The fixed binding numbers of the module's symbols.
+fn binding_of(sym: &Symbol) -> Option<u32> {
+    match sym {
+        Symbol::DescriptorSet(_) => Some(YCbCrFast::SET),
+        Symbol::Binding(s) if *s == IMAGE => Some(YCbCrFast::IMAGE_BINDING),
+        Symbol::Binding(s) if *s == TEXELS => Some(YCbCrFast::TEXELS_BINDING),
+        _ => None,
+    }
+}
+
+/// Sunfish 0131: the fast YCbCr conversion module of `device` for `fast`: built with the typed
+/// builder, checked by the owned verifier against the device's profile, serialized, and numbered
+/// with the fixed bindings of [`YCbCrFast`].
+pub fn ycbcr_fast_module(device: &Device, fast: &YCbCrFast) -> Result<YCbCrFastModule, Error> {
+    let profile = device.profile();
+    let m = typed_module(fast)?;
+    let mut meter = Meter::new(&Budget::default());
+    crate::spirv::verify::verify(&m, profile, &mut meter)?;
+    let r = crate::spirv::serialize::serialize(m)?;
+    profile.check(&r.requirements).map_err(|c| {
+        Error::Internal(InternalError::new(
+            InternalKind::RequirementsExceedProfile,
+            format!("the fast YCbCr conversion module needs {c:?}"),
+        ))
+    })?;
+    let words = crate::spirv::serialize::relocate(&r, &binding_of)?;
+    Ok(YCbCrFastModule {
+        spirv: words.into(),
+        requirements: r.requirements,
+    })
+}
