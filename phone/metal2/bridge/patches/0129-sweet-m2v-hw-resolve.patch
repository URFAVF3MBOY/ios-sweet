+/// 0129: whether a color attachment of `format` resolves by the device's own `AVERAGE` in its
+/// pass instead of the exact resolve after it (env `SWEET_M2V_HW_RESOLVE`): `0` never (the exact
+/// resolve, as before), `1` (the default) `RGBA8Unorm` and `BGRA8Unorm`, `2` their sRGB formats
+/// too. Turnip averages an 8-bit unorm channel's codes (its GMEM blit event, or the 2D engine in
+/// sysmem), where Metal writes `(sum + n / 2) / n`: at most 1 LSB apart, at a tie. Its GMEM blit
+/// averages an sRGB channel's codes too, not their linear values (`blit_can_resolve`), up to ~60
+/// LSB from Metal's at a black-white edge, so sRGB waits for `2`.
+fn sweet_hw_resolve(format: Format) -> bool {
+    static MODE: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    let mode = *MODE.get_or_init(|| {
+        let mode = match std::env::var("SWEET_M2V_HW_RESOLVE").as_deref().map(str::trim) {
+            Ok("0") => 0,
+            Ok("2") => 2,
+            _ => 1,
+        };
+        crate::pipestats::line(&format!("SWEET_M2V_HW_RESOLVE mode {mode}"));
+        mode
+    });
+    match format {
+        Format::R8G8B8A8_UNORM | Format::B8G8R8A8_UNORM => mode >= 1,
+        Format::R8G8B8A8_SRGB | Format::B8G8R8A8_SRGB => mode >= 2,
+        _ => false,
+    }
+}
+
 /// Whether `device`'s own `AVERAGE` resolve of a color attachment of `samples` samples writes
 /// Metal's resolve, whatever its format: `DriverFact::ColorResolveAverageIsMetals`, at a count
 /// Apple's GPUs make (MoltenVK's resolve is Metal's multisample resolve store action).
