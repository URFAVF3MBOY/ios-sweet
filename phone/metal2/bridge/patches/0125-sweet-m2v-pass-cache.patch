+/// 0125: the most final passes a device keeps (`create`); past it a pass is made per instance.
+const KEPT_FINAL: usize = 256;
+
+/// 0125: what [`create_now`] makes a pass of, but its device's profile (one per device): the
+/// shape, the color, depth/stencil, resolve and depth/stencil resolve operations, `resolving`.
+type FinalKey = (
+    PassShape,
+    Vec<Ops>,
+    Option<Ops>,
+    Vec<Ops>,
+    Option<Ops>,
+    bool,
+);
+
+/// 0125: the passes a device keeps by what made them (env `SWEET_M2V_PASS_CACHE`, `create`), so
+/// an instance of a known pass makes none. A pass depends on no image: never invalidated.
+#[derive(Default)]
+pub(super) struct KeptFinal(HashMap<FinalKey, vk::RenderPass>);
+
+impl KeptFinal {
+    /// Destroy every kept pass; the device is idle, and is destroyed next.
+    pub(super) fn destroy(&self, raw: &ash::Device) {
+        for &pass in self.0.values() {
+            // SAFETY: as for `KeptCompatible::destroy`.
+            unsafe { release::object(raw, pass) };
+        }
+    }
+}
