+/// 0125: whether `create` keeps its passes (env `SWEET_M2V_PASS_CACHE`, off unless set and not
+/// `0`).
+fn sweet_pass_cache_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var("SWEET_M2V_PASS_CACHE").is_ok_and(|v| !v.trim().is_empty() && v.trim() != "0")
+    })
+}
+
+/// 0125's counts of this process: hits, misses, misses past the cap; the time of the first
+/// call, and the milliseconds after it of the last log line.
+static SWEET_PASS_CACHE_COUNTS: [std::sync::atomic::AtomicU64; 3] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 3];
+static SWEET_PASS_CACHE_START: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+static SWEET_PASS_CACHE_LOGGED: std::sync::atomic::AtomicU64 =
+    std::sync::atomic::AtomicU64::new(u64::MAX);
+
+/// 0125: count a hit (`hit`) or a miss (past the cap where `full`), and log the counts and the
+/// kept passes (`kept`) at the first call and at most every 2 s after.
+fn sweet_pass_cache_count(hit: bool, full: bool, kept: usize) {
+    use std::sync::atomic::Ordering::Relaxed;
+    let counts = &SWEET_PASS_CACHE_COUNTS;
+    let start = *SWEET_PASS_CACHE_START.get_or_init(std::time::Instant::now);
+    counts[usize::from(!hit)].fetch_add(1, Relaxed);
+    if full {
+        counts[2].fetch_add(1, Relaxed);
+    }
+    let now = start.elapsed().as_millis() as u64;
+    let last = SWEET_PASS_CACHE_LOGGED.load(Relaxed);
+    if (last == u64::MAX || now >= last.saturating_add(2000))
+        && SWEET_PASS_CACHE_LOGGED
+            .compare_exchange(last, now, Relaxed, Relaxed)
+            .is_ok()
+    {
+        crate::pipestats::line(&format!(
+            "SWEET_M2V_PASS_CACHE PC hits {} misses {} full {} kept {kept} at {:.1} s",
+            counts[0].load(Relaxed),
+            counts[1].load(Relaxed),
+            counts[2].load(Relaxed),
+            now as f64 / 1e3
+        ));
+    }
+}
