+        return make();
+    }
+    let key: FinalKey = (
+        shape.clone(),
+        colors.to_vec(),
+        depth_stencil,
+        resolves.to_vec(),
+        depth_stencil_resolve,
+        resolving,
+    );
+    let kept = &device.shared().final_passes;
+    {
+        let passes = lock(kept);
+        if let Some(&raw) = passes.0.get(&key) {
+            let size = passes.0.len();
+            drop(passes);
+            sweet_pass_cache_count(true, false, size);
+            return Ok(RenderPassObject::kept(device, raw));
+        }
+    }
+    let pass = make()?;
+    let mut passes = lock(kept);
+    // Another encoder's may have come first: this one stays its holders'.
+    let full = passes.0.len() >= KEPT_FINAL;
+    let result = if !full && !passes.0.contains_key(&key) {
+        let raw = pass.into_kept();
+        passes.0.insert(key, raw);
+        RenderPassObject::kept(device, raw)
+    } else {
+        pass
+    };
+    let size = passes.0.len();
+    drop(passes);
+    sweet_pass_cache_count(false, full, size);
+    Ok(result)
+}
