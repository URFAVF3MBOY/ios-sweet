Ported from ios-redfin (dipa-studio, MIT), phone/turnip/patches/0107-sweet-order-fetchers-only.patch, commit 82c2af3.
SWEET_TU_ORDER_FETCHERS_ONLY=1 (off by default): in a pass with rasterization-order access, only pipelines whose
fragment shader reads an input attachment keep the per-overlap flush (sysmem and GMEM). Rebased onto our series
(UniXNU Mesa patches, then 0100..0110): offsets only, comments retagged 0111.

diff --git a/src/freedreno/vulkan/tu_pipeline.cc b/src/freedreno/vulkan/tu_pipeline.cc
index 1b778a0..fbd7aec 100644
--- a/src/freedreno/vulkan/tu_pipeline.cc
+++ b/src/freedreno/vulkan/tu_pipeline.cc
@@ -3794,6 +3794,14 @@ tu6_emit_prim_mode_sysmem(struct tu_cs *cs,
       FLUSH_PER_OVERLAP_AND_OVERWRITE : NO_FLUSH;
    if (!sweet_prim_order)
       sysmem_prim_mode = NO_FLUSH;
+   /* sweet 0111 (ios-redfin 0107, 82c2af3): SWEET_TU_ORDER_FETCHERS_ONLY=1: in a pass with rasterization-order
+    * access (metal2vulkan flags every pipeline of a pass in which any draw fetches), only the pipelines whose
+    * fragment shader reads an input attachment flush per overlap; the others draw unflushed, as the blob draws
+    * everything but its advanced-blend draws. A feedback loop keeps the flush. */
+   static const unsigned sweet_fetchers_only = debug_get_num_option("SWEET_TU_ORDER_FETCHERS_ONLY", 0);
+   if (sweet_fetchers_only && fs && !fs->fs.sweet_reads_input_attachments && !feedback_loops &&
+       !fs->fs.dynamic_input_attachments_used && !TU_DEBUG(RAST_ORDER))
+      sysmem_prim_mode = NO_FLUSH;
 
    if (sysmem_prim_mode == FLUSH_PER_OVERLAP_AND_OVERWRITE)
       *sysmem_single_prim_mode = true;
@@ -4436,6 +4444,15 @@ tu_pipeline_builder_parse_rasterization_order(
     * test of what it costs; overlapping fetch draws may then read a stale pixel) */
    if (!debug_get_num_option("TU_SWEET_PRIM_ORDER", 1))
       gmem_prim_mode = NO_FLUSH;
+   /* sweet 0111: SWEET_TU_ORDER_FETCHERS_ONLY=1, as in tu6_emit_prim_mode_sysmem: only fetching fragment shaders
+    * flush per overlap in GMEM (only where the pipeline has its fragment shader) */
+   {
+      static const unsigned sweet_fetchers_only = debug_get_num_option("SWEET_TU_ORDER_FETCHERS_ONLY", 0);
+      const struct tu_shader *sweet_fs = pipeline->shaders[MESA_SHADER_FRAGMENT];
+      if (sweet_fetchers_only && sweet_fs && !sweet_fs->fs.sweet_reads_input_attachments &&
+          !sweet_fs->fs.dynamic_input_attachments_used && !TU_DEBUG(RAST_ORDER))
+         gmem_prim_mode = NO_FLUSH;
+   }
 
    struct tu_cs cs;
 
