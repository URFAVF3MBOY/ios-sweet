-      return vk_device_set_lost(&device->vk, "GPU faulted or hung");
+   /* 0112: one exchange, so two threads checking at once see a new count once. */
+   uint64_t prev = p_atomic_xchg(&device->fault_count, reply.faults);
+   if (prev == reply.faults)
+      return VK_SUCCESS;
+   uint64_t lost = reply.faults - prev;
+   /* SweetMetal2 0112: the kernel recovered the GPU (a failed recovery makes GetStatus fail, above) and forced the fences
+    * of the work in flight: that work is dropped, but memory, pipelines and the ring are as they were, so the device
+    * stays in use. More than TU_DARWIN_KEEP_DEVICE_MAX (default 3) kept checks in 60 s: a client that hangs the shared
+    * ring every frame, so lost as before. TU_DARWIN_KEEP_DEVICE=0: always lost as before. */
+   if (debug_get_bool_option("TU_DARWIN_KEEP_DEVICE", true)) {
+      int64_t max = debug_get_num_option("TU_DARWIN_KEEP_DEVICE_MAX", 3);
+      max = CLAMP(max, 0, (int64_t)ARRAY_SIZE(device->sweet_kept_ns));
+      uint64_t now = os_time_get_nano();
+      uint32_t slot = p_atomic_inc_return(&device->sweet_kept_next) - 1;
+      unsigned recent = 1; /* this check */
+      for (unsigned i = 0; i < ARRAY_SIZE(device->sweet_kept_ns); i++) {
+         uint64_t t = p_atomic_read(&device->sweet_kept_ns[i]);
+         if (t && now - t < 60000000000ull)
+            recent++;
+      }
+      p_atomic_set(&device->sweet_kept_ns[slot % ARRAY_SIZE(device->sweet_kept_ns)], now);
+      if (recent <= (unsigned)max) {
+         p_atomic_inc(&darwin_restarts);
+         char text[200];
+         int n = snprintf(text, sizeof(text), "MTL2[%d %s]: GPU restart dropped work in flight (%llu faults): "
+                          "device kept (%u in 60 s, total %u)\n", getpid(), getprogname(),
+                          (unsigned long long)lost, recent, p_atomic_read(&darwin_restarts));
+         n = CLAMP(n, 1, (int)sizeof(text) - 1);
+         mesa_logw("%.*s", n - 1, text);
+         darwin_restart_note(text, n);
+         return VK_SUCCESS;
+      }
+      return vk_device_set_lost(&device->vk, "GPU faulted or hung (%llu faults, %u kept checks in 60 s > %d)",
+                                (unsigned long long)lost, recent, (int)max);
    }
-   return VK_SUCCESS;
