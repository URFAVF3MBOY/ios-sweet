+/* SweetMetal2 0112 (UniXNU c72a8a5): status checks that found this process's work dropped by a GPU restart and kept the
+ * device (one check can cover several restarts). */
+static uint32_t darwin_restarts;
+extern "C" __attribute__((visibility("default"))) uint32_t tu_darwin_restarts(void);
+extern "C" __attribute__((visibility("default"))) uint32_t
+tu_darwin_restarts(void)
+{
+   return p_atomic_read(&darwin_restarts);
+}
+
+/* SweetMetal2 0112: one line into /dev/console (kernel live log) and /var/local/mtl2.log, like 0108's vk_sweet_lost_note. */
+static void
+darwin_restart_note(const char *text, int n)
+{
+   const char *paths[] = { "/dev/console", "/var/local/mtl2.log" };
+   for (unsigned i = 0; i < 2; i++) {
+      int fd = open(paths[i], O_WRONLY | O_APPEND | O_NOCTTY);
+      if (fd >= 0) {
+         (void)!write(fd, text, n);
+         close(fd);
+      }
+   }
+}
