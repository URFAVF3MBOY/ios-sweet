From: fish <lunarisfelix02@gmail.com>
Date: Sat, 24 Oct 2026 23:00:00 +0000
Subject: [PATCH] op7t-0129: en0: fixed IPv4 address and default route from the kernel

Wi-Fi joins (0126/0127) but configd never configures en0 (no SIOCSIFFLAGS, no
DHCP), so the phone has no address and nothing can reach it. Like sweet's ue0
(0075), the kernel now gives en0 an address itself, ~2 s after the link first
comes up: proto_plumb(PF_INET) + SIOCAIFADDR, IFF_UP|IFF_RUNNING, and a
default route through a routing-socket RTM_ADD. That is enough to reach the
phone from the home network (SSH); DNS and the rest still need configd.

Defaults for the 7T's home network: 10.0.0.237/24, router 10.0.0.1.
Boot-args: sweetip=N (last byte, 0 = no address), sweetipnet=0xAABBCC00,
sweetipgw=N (0 = no default route).

Apply after 0128.
---
diff --git a/bsd/dev/redwood_net.c b/bsd/dev/redwood_net.c
--- a/bsd/dev/redwood_net.c
+++ b/bsd/dev/redwood_net.c
@@ -32,6 +32,10 @@
 #include <sys/sockio.h>
 #include <sys/systm.h>
 #include <sys/vnode.h>
+#include <sys/kpi_socket.h>
+#include <net/kpi_protocol.h>
+#include <net/route.h>
+#include <netinet/in.h>
 
 extern void RedwoodWLANStart(const char *interface, const uint8_t *address);  /* iokit/Kernel/RedwoodWLAN.cpp */
 
@@ -349,6 +353,83 @@
 	}
 }
 
+/*
+ * 0129: a fixed IPv4 address on en0 from the kernel, the way sweet's ue0 gets 192.168.7.2 (0075):
+ * proto_plumb(PF_INET) + SIOCAIFADDR on an in-kernel socket. configd has never configured en0 here
+ * (no DHCP, 0127/0128), and this is what lets the PC reach the phone (SSH) on the home network.
+ * Boot-args: sweetip=N  the last byte (default 237; 0: none), on sweetipnet (default 0x0a000000,
+ * 10.0.0.0/24); sweetipgw=N the router's last byte (default 1) for a default route (0: none).
+ */
+static uint32_t net_ip_last = 237, net_ip_net = 0x0a000000, net_ip_gw = 1;
+static bool net_ip_done;
+
+static void
+net_sin(struct sockaddr_in *a, uint32_t host_order)
+{
+	bzero(a, sizeof(*a));
+	a->sin_len = sizeof(*a);
+	a->sin_family = AF_INET;
+	a->sin_addr.s_addr = htonl(host_order);
+}
+
+static void
+net_static_ip(void)
+{
+	socket_t so = NULL;
+	errno_t err, plumb;
+	uint32_t ip = (net_ip_net & 0xffffff00u) | (net_ip_last & 0xff);
+
+	net_ip_done = true;
+	if (net_ip_last == 0) {
+		printf("net: no fixed address (sweetip=0)\n");
+		return;
+	}
+	plumb = proto_plumb(PF_INET, net_ifp);          /* EEXIST if configd ever attached IPv4: fine */
+	err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	if (err == 0) {
+		struct ifaliasreq ifra;
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "%s%u", ifnet_name(net_ifp), ifnet_unit(net_ifp));
+		net_sin((struct sockaddr_in *)&ifra.ifra_addr, ip);
+		net_sin((struct sockaddr_in *)&ifra.ifra_mask, 0xffffff00u);
+		net_sin((struct sockaddr_in *)&ifra.ifra_broadaddr, ip | 0xff);
+		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+	}
+	ifnet_set_flags(net_ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	printf("net: en0 fixed address %u.%u.%u.%u/24 %s (plumb %d, err %d), flags %#x\n", ip >> 24, (ip >> 16) & 0xff,
+	    (ip >> 8) & 0xff, ip & 0xff, err ? "NOT set" : "set", plumb, err, (unsigned)ifnet_flags(net_ifp));
+	if (err == 0 && net_ip_gw != 0) {
+		/* the default route, as `route add default GW` does it: a routing socket message */
+		struct {
+			struct rt_msghdr hdr;
+			struct sockaddr_in dst, gw, mask;
+		} m;
+		uint32_t gw = (net_ip_net & 0xffffff00u) | (net_ip_gw & 0xff);
+		bzero(&m, sizeof(m));
+		m.hdr.rtm_msglen = sizeof(m);
+		m.hdr.rtm_version = RTM_VERSION;
+		m.hdr.rtm_type = RTM_ADD;
+		m.hdr.rtm_flags = RTF_UP | RTF_GATEWAY | RTF_STATIC;
+		m.hdr.rtm_addrs = RTA_DST | RTA_GATEWAY | RTA_NETMASK;
+		m.hdr.rtm_seq = 1;
+		net_sin(&m.dst, 0);
+		net_sin(&m.gw, gw);
+		net_sin(&m.mask, 0);
+		socket_t rs = NULL;
+		errno_t rerr = sock_socket(PF_ROUTE, SOCK_RAW, 0, NULL, NULL, &rs);
+		if (rerr == 0) {
+			struct iovec iov = { .iov_base = &m, .iov_len = sizeof(m) };
+			struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+			size_t sent = 0;
+			rerr = sock_send(rs, &msg, 0, &sent);
+			sock_close(rs);
+		}
+		printf("net: default route via %u.%u.%u.%u: %s (%d)\n", gw >> 24, (gw >> 16) & 0xff, (gw >> 8) & 0xff, gw & 0xff,
+		    rerr ? "NOT added" : "added", rerr);
+	}
+}
+
 /* The interface's own thread: for a link that wants to be asked, and for the minute's line in the log. */
 static void
 net_thread(__unused void *parameter, __unused wait_result_t result)
@@ -366,6 +447,14 @@
 			    net_count.sent, net_count.sent_bytes, net_count.received, net_count.received_bytes,
 			    net_count.dropped_out, net_count.dropped_in);
 		}
+		/* 0129: the fixed address once, ~2 s after the link first came up (keys installed by then) */
+		if (net_link_up && !net_ip_done) {
+			static unsigned ip_wait;
+			ip_wait += quiet < 100 ? 2 : 10;
+			if (ip_wait >= 2000) {
+				net_static_ip();
+			}
+		}
 		/* 0128: the preference files, ~5 s and ~60 s after the link first came up */
 		if (net_link_up && probes < 2) {
 			probe_wait += quiet < 100 ? 2 : 10;
@@ -463,4 +552,7 @@
 	net_trace = 60;                         /* 0127: on by default while DHCP is investigated; net_trace=0 off */
 	PE_parse_boot_argn("net_trace", &net_trace, sizeof(net_trace));
 	PE_parse_boot_argn("net_names", &net_names, sizeof(net_names));
+	PE_parse_boot_argn("sweetip", &net_ip_last, sizeof(net_ip_last));       /* 0129 */
+	PE_parse_boot_argn("sweetipnet", &net_ip_net, sizeof(net_ip_net));
+	PE_parse_boot_argn("sweetipgw", &net_ip_gw, sizeof(net_ip_gw));
 }
