#version 450
// vkcompute: out[i] = in[i] * 3 + i * k (k from a push constant), 64 invocations a group.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { uint src[]; };
layout(std430, binding = 1) writeonly buffer Out { uint dst[]; };
layout(push_constant) uniform Push { uint k; uint count; } pc;

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i < pc.count)
		dst[i] = src[i] * 3u + i * pc.k;
}
